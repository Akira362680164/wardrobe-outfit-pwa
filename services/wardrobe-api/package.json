{
  "name": "@wardrobe/wardrobe-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:e2e": "tsx src/server.ts",
    "prebuild": "npm --workspace @wardrobe/cloud-contracts run build",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm --workspace @wardrobe/cloud-contracts run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm --workspace @wardrobe/cloud-contracts run build",
    "test": "vitest run",
    "pretest:recommendation:persistence:postgres": "npm --workspace @wardrobe/cloud-contracts run build",
    "test:recommendation:persistence:postgres": "vitest run --config vitest.postgres.config.ts --maxWorkers=1",
    "reset:test-data": "node dist/cli/reset-test-data.js",
    "recommendation-worker": "node dist/recommendations/worker-entry.js",
    "recommendation-worker:run-once": "node dist/recommendations/worker-entry.js --run-once",
    "recommendation-readiness:1d-c": "node dist/recommendations/readiness-entry.js",
    "qweather:smoke": "tsx scripts/qweather-1d-b-smoke.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@wardrobe/cloud-contracts": "file:../../packages/cloud-contracts",
    "@wardrobe/domain-catalog": "file:../../packages/domain-catalog",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.5.0",
    "jose": "^6.2.3",
    "pg": "^8.16.3",
    "tencentcloud-sdk-nodejs": "^4.1.264",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
