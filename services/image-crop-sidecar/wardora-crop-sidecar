#!/usr/bin/env python3
"""Private single-request u2netp crop worker. Reads/writes JSON only on stdio."""
import argparse, base64, io, json, os, sys
from pathlib import Path
import numpy as np
from PIL import Image, ImageOps
from rembg import new_session
from scipy import ndimage

def main():
    parser = argparse.ArgumentParser(); parser.add_argument("--model", required=True); args = parser.parse_args()
    model = Path(args.model).resolve()
    if not model.is_file(): raise RuntimeError("model_not_found")
    os.environ["U2NET_HOME"] = str(model.parent); os.environ["MODEL_CHECKSUM_DISABLED"] = "1"
    request = json.loads(sys.stdin.read())
    raw = base64.b64decode(request["imageBase64"], validate=True)
    with Image.open(io.BytesIO(raw)) as source: image = ImageOps.exif_transpose(source).convert("RGB")
    if image.width * image.height > 40_000_000: raise RuntimeError("pixel_limit")
    session = new_session("u2netp", providers=["CPUExecutionProvider"])
    inputs = session.normalize(image, (0.485, 0.456, 0.406), (0.229, 0.224, 0.225), (320, 320))
    scores = np.squeeze(session.inner_session.run(None, inputs)[0][:, 0, :, :]).astype(np.float32)
    low, high = float(scores.min()), float(scores.max())
    if high - low < 1e-8: raise RuntimeError("empty_foreground")
    scores = (scores - low) / (high - low); binary = scores >= 0.5
    labels, count = ndimage.label(binary); areas = np.bincount(labels.ravel(), minlength=count + 1); largest = int(areas[1:].max()) if count else 0
    keep = np.zeros_like(binary, dtype=bool); minimum = max(int(binary.size * .001), int(largest * .03))
    for component in range(1, count + 1):
        if areas[component] >= minimum: keep |= labels == component
    ys, xs = np.nonzero(keep)
    if not len(xs): raise RuntimeError("empty_foreground")
    height, width = keep.shape; x1, y1, x2, y2 = int(xs.min()), int(ys.min()), int(xs.max()) + 1, int(ys.max()) + 1
    confidence = float(scores[keep].mean())
    print(json.dumps({"cropBox":{"x":x1/width,"y":y1/height,"width":(x2-x1)/width,"height":(y2-y1)/height},"confidence":confidence,"needsReview":confidence < .6,"reasonCodes":["low_confidence"] if confidence < .6 else [],"modelVersion":"u2netp-rembg-v0.0.0-sha256-309c8469"}, separators=(",",":")))

if __name__ == "__main__": main()
