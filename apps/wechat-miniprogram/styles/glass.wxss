.glass-panel { background: rgba(255, 255, 252, 0.75); -webkit-backdrop-filter: blur(60rpx) saturate(1.5); backdrop-filter: blur(60rpx) saturate(1.5); border: 1rpx solid var(--color-line); box-shadow: var(--shadow-card); }
.glass-panel-strong { background: rgba(255, 255, 252, 0.88); -webkit-backdrop-filter: blur(72rpx) saturate(1.45); backdrop-filter: blur(72rpx) saturate(1.45); border: 1rpx solid var(--color-line); box-shadow: var(--shadow-soft); }
.surface-panel { background: rgba(255, 255, 252, 0.52); -webkit-backdrop-filter: blur(60rpx) saturate(1.35) brightness(1.04); backdrop-filter: blur(60rpx) saturate(1.35) brightness(1.04); border: 1rpx solid var(--color-line); box-shadow: var(--shadow-card), inset 0 1rpx 0 rgba(255, 255, 255, 0.64), inset 0 -1rpx 0 rgba(29, 34, 40, 0.10); }
.top-glass { box-sizing: border-box; margin: 0 -32rpx 24rpx; padding: calc(env(safe-area-inset-top) + 24rpx) calc(32rpx + 220rpx) 24rpx 32rpx; background: rgba(251, 251, 248, 0.75); -webkit-backdrop-filter: blur(60rpx) saturate(1.5); backdrop-filter: blur(60rpx) saturate(1.5); }
.bottom-glass-bar { background: rgba(255, 255, 252, 0.75); -webkit-backdrop-filter: blur(60rpx) saturate(1.5); backdrop-filter: blur(60rpx) saturate(1.5); border: 1rpx solid var(--color-line); border-radius: var(--radius-sheet); box-shadow: var(--shadow-card); }
.toast-glass { background: rgba(255, 255, 252, 0.95); -webkit-backdrop-filter: blur(32rpx) saturate(1.25); backdrop-filter: blur(32rpx) saturate(1.25); border: 1rpx solid var(--color-line); box-shadow: var(--shadow-card); }
