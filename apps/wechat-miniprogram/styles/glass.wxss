.glass-panel { background: rgba(255, 255, 252, 0.75); -webkit-backdrop-filter: blur(60rpx) saturate(1.5); backdrop-filter: blur(60rpx) saturate(1.5); border: 1rpx solid var(--glass-border); box-shadow: var(--shadow-card); }
.glass-panel-strong { background: rgba(255, 255, 252, 0.88); -webkit-backdrop-filter: blur(72rpx) saturate(1.45); backdrop-filter: blur(72rpx) saturate(1.45); border: 1rpx solid rgba(29, 34, 40, 0.10); box-shadow: var(--shadow-soft); }
.surface-panel { background: rgba(255, 255, 252, 0.86); border: 1rpx solid rgba(29, 34, 40, 0.08); box-shadow: var(--shadow-card); }
