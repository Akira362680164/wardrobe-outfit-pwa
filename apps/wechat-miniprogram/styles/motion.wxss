.motion-fast { transition: all 120ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.motion-normal { transition: all 220ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.motion-panel { transition: all 320ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.pressable { transition: transform 120ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 120ms ease; }
.pressable:active { opacity: 0.86; transform: translateY(1rpx) scale(0.98); }
@keyframes ui-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes sheet-in { from { opacity: 0; transform: translateY(36rpx); } to { opacity: 1; transform: translateY(0); } }
.motion-reduced, .motion-reduced * { animation: none !important; transition: none !important; }
