.motion-fast,
.motion-normal,
.motion-panel { transition-property: opacity, transform, color, background-color, border-color, box-shadow; transition-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1); }
.motion-fast { transition-duration: 120ms; }
.motion-normal { transition-duration: 220ms; }
.motion-panel { transition-duration: 320ms; }
.pressable,
.content-fab,
.filter-chip,
.catalog-card { transition: transform 120ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.pressable:active,
.content-fab:active,
.filter-chip:active,
.catalog-card:active { transform: translateY(1rpx) scale(0.985); }
@keyframes ui-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes sheet-in { from { opacity: 0; transform: translateY(36rpx); } to { opacity: 1; transform: translateY(0); } }
.motion-reduced { animation: none !important; transition: none !important; }
@media (prefers-reduced-motion: reduce) {
  .motion-fast,
  .motion-normal,
  .motion-panel,
  .pressable,
  .content-fab,
  .filter-chip,
  .catalog-card { animation: none; transition: none; }
  .pressable:active,
  .content-fab:active,
  .filter-chip:active,
  .catalog-card:active { transform: none; }
}
