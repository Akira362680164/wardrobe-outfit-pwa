.text-title { font-size: var(--font-title); line-height: 1.15; font-weight: 700; letter-spacing: 0; }
.text-section { font-size: var(--font-section); line-height: 1.25; font-weight: 700; letter-spacing: 0; }
.text-body { font-size: var(--font-body); line-height: 1.55; font-weight: 400; letter-spacing: 0; }
.text-caption { font-size: var(--font-caption); line-height: 1.45; color: var(--color-muted); letter-spacing: 0; }
.text-label { font-size: var(--font-label); line-height: 1.2; font-weight: 600; letter-spacing: 0; }
.text-one-line { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.text-wrap-safe { min-width: 0; overflow-wrap: anywhere; word-break: break-word; }
