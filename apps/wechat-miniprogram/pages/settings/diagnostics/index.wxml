<view class="settings-page page-shell">
  <view class="page-title">诊断</view>
  <view class="page-copy">诊断入口先展示规则，正式上传等后端诊断接口接入后再启用。</view>

  <view class="info-card">
    <view wx:for="{{rows}}" wx:key="*this" class="rule-row">{{item}}</view>
  </view>

  <button class="disabled-button" bindtap="showUnavailable">上传诊断数据</button>
</view>
