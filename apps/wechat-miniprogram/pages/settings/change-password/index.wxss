.password-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx 32rpx;
  background: #fbfbf8;
  color: #1f2933;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
}

.mode-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 28rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.mode-button {
  height: 80rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.10);
  border-radius: 20rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 28rpx;
  font-weight: 700;
}

.mode-button--active {
  border-color: #2f6b4f;
  background: #2f6b4f;
  color: #ffffff;
}

.form-card {
  display: grid;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.08);
  border-radius: 32rpx;
  background: #ffffff;
}

.form-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: rgba(31, 41, 51, 0.05);
  color: #1f2933;
  font-size: 30rpx;
}

.email-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.email-copy {
  min-width: 0;
}

.field-label {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(31, 41, 51, 0.56);
}

.email-value {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 700;
}

.code-button {
  flex-shrink: 0;
  min-width: 168rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #2f6b4f;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.code-button[disabled] {
  background: rgba(47, 107, 79, 0.35);
  color: rgba(255, 255, 255, 0.8);
}

.primary-button {
  width: 100%;
  height: 92rpx;
  margin-top: 24rpx;
  border-radius: 28rpx;
  background: #2f6b4f;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}

.primary-button[disabled] {
  background: rgba(47, 107, 79, 0.42);
}

.form-error {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(180, 35, 24, 0.10);
  color: #b42318;
  font-size: 26rpx;
  line-height: 1.45;
}
