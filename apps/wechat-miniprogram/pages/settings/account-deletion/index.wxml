<view class="deletion-page">
  <view wx:if="{{errorMessage}}" class="form-error">{{errorMessage}}</view>

  <block wx:if="{{stage === 'notice'}}">
    <view class="warning-card">
      <view class="warning-mark">!</view>
      <view>
        <view class="section-title">注销后无法恢复</view>
        <view class="section-copy">注销后，你将无法再登录或找回这个账号。</view>
      </view>
    </view>
    <view class="content-card">
      <view class="section-title">以下内容将被永久删除</view>
      <view class="deletion-list">
        <view>• 衣物资料、衣物照片和衣橱位置</view>
        <view>• 收藏套装、穿搭计划和穿着记录</view>
        <view>• 种草清单、旅行计划和试穿资料</view>
        <view>• 邮箱、手机号和微信登录关系</view>
        <view>• 已上传诊断数据及其他账号关联信息</view>
      </view>
      <view class="danger-copy">所有 App 和小程序登录会话将同时失效。删除完成后无法恢复。</view>
    </view>
    <button class="danger-action" bindtap="continueFromNotice">我已了解，继续注销</button>
    <view class="secondary-action" role="button" bindtap="cancelDeletion">暂不注销</view>
  </block>

  <block wx:elif="{{stage === 'choice'}}">
    <view class="content-card">
      <view class="section-title">验证账号身份</view>
      <view class="section-copy">为防止他人误操作，请选择一种已经绑定的方式验证身份。验证信息仅用于本次注销。</view>
    </view>
    <button wx:if="{{security.wechat.bound}}" class="method-button" loading="{{loading}}" disabled="{{loading}}" bindtap="verifyWechat">
      <view class="method-title">使用微信身份验证</view>
      <view class="method-note">验证当前小程序绑定的微信身份</view>
    </button>
    <button wx:if="{{security.email.bound && security.email.verified}}" class="method-button" disabled="{{loading}}" bindtap="chooseEmail">
      <view class="method-title">使用邮箱验证码验证</view>
      <view class="method-note">{{emailMasked}}</view>
    </button>
    <button wx:if="{{security.password.set}}" class="method-button" disabled="{{loading}}" bindtap="choosePassword">
      <view class="method-title">使用当前密码验证</view>
      <view class="method-note">输入当前账号密码</view>
    </button>
    <view wx:if="{{security && !security.wechat.bound && !(security.email.bound && security.email.verified) && !security.password.set}}" class="form-error">当前账号没有可用的身份验证方式，请通过公开联系渠道处理。</view>
  </block>

  <block wx:elif="{{stage === 'email'}}">
    <view class="content-card">
      <view class="section-title">邮箱验证码</view>
      <view class="section-copy">验证码将发送至 {{emailMasked}}</view>
      <button class="code-button" disabled="{{sendingCode || countdown > 0}}" bindtap="sendEmailCode">{{sendingCode ? '发送中' : countdown > 0 ? countdown + 's 后可重发' : codeSent ? '再次发送' : '发送验证码'}}</button>
    </view>
    <input class="form-input" type="number" maxlength="6" placeholder="请输入 6 位邮箱验证码" value="{{emailCode}}" bindinput="handleEmailCode" />
    <button class="danger-action" loading="{{loading}}" disabled="{{loading || emailCode.length !== 6}}" bindtap="verifyEmail">验证并继续</button>
    <view class="secondary-action" role="button" bindtap="backToChoice">更换验证方式</view>
  </block>

  <block wx:elif="{{stage === 'password'}}">
    <view class="content-card">
      <view class="section-title">当前密码</view>
      <view class="section-copy">请输入当前账号密码验证身份。</view>
    </view>
    <input class="form-input" password type="text" placeholder="当前密码" value="{{currentPassword}}" bindinput="handlePassword" />
    <button class="danger-action" loading="{{loading}}" disabled="{{loading || currentPassword.length < 8}}" bindtap="verifyPassword">验证并继续</button>
    <view class="secondary-action" role="button" bindtap="backToChoice">更换验证方式</view>
  </block>

  <block wx:elif="{{stage === 'final'}}">
    <view class="final-icon">!</view>
    <view class="final-title">最后确认永久注销</view>
    <view class="final-copy">确认后，账号将立即停用，所有设备退出登录，账号数据和图片将被永久删除。该操作无法撤销。</view>
    <checkbox-group bindchange="handleFinalConfirm">
      <label class="confirm-row">
        <checkbox value="confirmed" checked="{{finalConfirmed}}" color="#b42318" />
        <text>我确认不再需要此账号及其中的数据</text>
      </label>
    </checkbox-group>
    <button class="danger-action" loading="{{loading}}" disabled="{{loading || !finalConfirmed}}" bindtap="confirmDeletion">永久注销账号</button>
    <view class="secondary-action" role="button" bindtap="backToChoice">取消</view>
  </block>

  <block wx:elif="{{stage === 'processing'}}">
    <view class="status-card">
      <view class="status-spinner"></view>
      <view class="final-title">正在注销账号</view>
      <view class="final-copy">账号已停止使用，正在删除账号数据和图片。请稍候。</view>
      <view wx:if="{{referenceCode}}" class="reference-code">处理编号：{{referenceCode}}</view>
    </view>
  </block>

  <block wx:elif="{{stage === 'completed'}}">
    <view class="status-card">
      <view class="success-mark"><ui-icon name="check" size="42" tone="primary" /></view>
      <view class="final-title">账号已注销</view>
      <view class="final-copy">你的账号、衣橱数据和图片已删除，所有设备均已退出登录。</view>
      <button class="primary-action" bindtap="returnToLogin">返回登录页</button>
    </view>
  </block>

  <block wx:else>
    <view class="status-card">
      <view class="final-icon">!</view>
      <view class="final-title">账号已停用</view>
      <view class="final-copy">你的账号已无法登录，关联数据正在继续删除。删除完成前不会再用于任何业务功能。</view>
      <view wx:if="{{referenceCode}}" class="reference-code">处理编号：{{referenceCode}}</view>
      <button class="primary-action" bindtap="returnToLogin">返回登录页</button>
    </view>
  </block>
</view>
