.deletion-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 56rpx);
  background: #fbfbf8;
  color: #1f2933;
}

.warning-card,
.content-card,
.status-card {
  box-sizing: border-box;
  padding: 28rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.08);
  border-radius: 32rpx;
  background: #ffffff;
}

.warning-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.warning-mark,
.final-icon,
.success-mark {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #fef3f2;
  color: #b42318;
  font-size: 42rpx;
  font-weight: 800;
}

.success-mark {
  margin: 0 auto;
  background: rgba(53, 92, 125, 0.10);
  color: #355c7d;
}

.content-card { margin-top: 24rpx; }
.section-title { font-size: 30rpx; font-weight: 800; line-height: 42rpx; }
.section-copy { margin-top: 10rpx; color: #6b7280; font-size: 26rpx; line-height: 40rpx; }
.deletion-list { display: grid; gap: 14rpx; margin-top: 22rpx; color: #6b7280; font-size: 26rpx; line-height: 40rpx; }
.danger-copy { margin-top: 24rpx; color: #b42318; font-size: 25rpx; line-height: 38rpx; }

.danger-action,
.primary-action {
  width: 100%;
  height: 92rpx;
  margin-top: 28rpx;
  border-radius: 28rpx;
  background: #b42318;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.primary-action { background: #355c7d; }
.danger-action[disabled] { background: rgba(180, 35, 24, 0.38); color: rgba(255, 255, 255, 0.84); }
.secondary-action { display: flex; min-height: 88rpx; align-items: center; justify-content: center; color: #6b7280; font-size: 26rpx; }

.method-button {
  width: 100%;
  min-height: 128rpx;
  margin-top: 20rpx;
  padding: 22rpx 28rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.08);
  border-radius: 28rpx;
  background: #ffffff;
  text-align: left;
}

.method-title { color: #1f2933; font-size: 28rpx; font-weight: 800; line-height: 40rpx; }
.method-note { margin-top: 8rpx; color: #6b7280; font-size: 23rpx; line-height: 34rpx; }
.code-button { min-width: 210rpx; height: 72rpx; margin: 22rpx 0 0; border-radius: 20rpx; background: #355c7d; color: #ffffff; font-size: 24rpx; font-weight: 700; }
.code-button[disabled] { background: rgba(53, 92, 125, 0.36); }
.form-input { box-sizing: border-box; width: 100%; height: 96rpx; margin-top: 24rpx; padding: 0 26rpx; border: 1rpx solid rgba(31, 41, 51, 0.10); border-radius: 24rpx; background: #ffffff; font-size: 30rpx; }
.form-error { margin-bottom: 20rpx; padding: 20rpx 22rpx; border-radius: 20rpx; background: #fef3f2; color: #b42318; font-size: 24rpx; line-height: 36rpx; }

.final-icon { margin: 32rpx auto 0; }
.final-title { margin-top: 24rpx; text-align: center; font-size: 36rpx; font-weight: 800; line-height: 48rpx; }
.final-copy { margin-top: 16rpx; color: #6b7280; text-align: center; font-size: 26rpx; line-height: 42rpx; }
.confirm-row { display: flex; min-height: 96rpx; align-items: center; gap: 18rpx; margin-top: 28rpx; padding: 0 22rpx; border: 1rpx solid rgba(180, 35, 24, 0.18); border-radius: 24rpx; background: #fef3f2; color: #7a271a; font-size: 25rpx; line-height: 38rpx; }
.status-card { margin-top: 25vh; text-align: center; }
.status-card .final-icon { margin-top: 0; }
.reference-code { margin-top: 18rpx; color: #9ca3af; font-size: 22rpx; }
.status-spinner { width: 64rpx; height: 64rpx; margin: 0 auto; border: 6rpx solid rgba(180, 35, 24, 0.18); border-top-color: #b42318; border-radius: 50%; animation: spin 0.9s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
