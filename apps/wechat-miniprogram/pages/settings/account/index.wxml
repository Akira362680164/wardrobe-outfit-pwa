<view class="settings-page page-shell">
  <view class="page-title">账号安全</view>
  <view class="page-copy">管理 App 与小程序共用的登录方式。</view>

  <view wx:if="{{errorMessage}}" class="account-error">{{errorMessage}}</view>

  <view class="security-card">
    <view class="card-head">
      <view class="card-title">邮箱</view>
      <view class="status-chip">{{emailStatus}}</view>
    </view>
    <view class="card-main">{{emailLine}}</view>
  </view>

  <view class="security-card">
    <view class="card-head">
      <view class="card-title">手机号</view>
      <view class="status-chip status-chip--muted">{{phoneStatus}}</view>
    </view>
    <view class="card-main">{{phoneLine}}</view>
    <view class="card-hint">手机号暂不验证，仅用于手机号+密码登录。</view>
  </view>

  <view class="security-card">
    <view class="card-head">
      <view class="card-title">微信登录</view>
    </view>
    <view class="card-main">{{wechatLine}}</view>
    <view class="card-hint">微信登录仅在小程序端使用。</view>
  </view>

  <view class="security-card" bindtap="changePassword">
    <view class="card-head">
      <view class="card-title">密码</view>
      <view class="card-action">修改密码</view>
    </view>
    <view class="card-main">{{passwordLine}}</view>
  </view>

  <view class="security-card">
    <view class="card-title">设备</view>
    <view class="card-main">{{deviceId}}</view>
  </view>

  <button wx:if="{{loggedIn}}" class="danger-button logout-button" bindtap="logout">退出登录</button>
  <button wx:else class="primary-button logout-button" bindtap="login">去登录</button>
</view>
