.settings-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
  background: #fbfbf8;
}

.page-title {
  color: #1f2933;
}

.page-copy {
  color: #6b7280;
}

.account-error {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fef3f2;
  color: #b42318;
  font-size: 24rpx;
}

.security-card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.08);
  border-radius: 32rpx;
  background: #ffffff;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title {
  color: #1f2933;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.card-main {
  margin-top: 14rpx;
  color: #1f2933;
  font-size: 28rpx;
  line-height: 40rpx;
  word-break: break-all;
}

.card-hint {
  margin-top: 10rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 34rpx;
}

.card-action-button {
  display: flex;
  width: 100% !important;
  min-width: 100%;
  max-width: 100%;
  min-height: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0 0 !important;
  padding: 0 24rpx;
  border-radius: var(--radius-control);
  box-sizing: border-box;
  color: var(--color-surface);
  background: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 700;
  line-height: 1;
}

.card-action-button::after { border: 0; }

.status-chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(47, 107, 79, 0.10);
  color: #2f6b4f;
  font-size: 22rpx;
}

.status-chip--muted {
  background: rgba(107, 114, 128, 0.10);
  color: #6b7280;
}

.logout-button {
  display: block;
  width: 100% !important;
  margin: 36rpx 0 0;
  border-radius: 28rpx;
}

.delete-account-entry {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  color: #b42318;
  font-size: 26rpx;
  line-height: 40rpx;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}
