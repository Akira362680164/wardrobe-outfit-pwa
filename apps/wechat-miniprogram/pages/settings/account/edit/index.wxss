.account-edit-page { min-height: 100vh; padding-bottom: calc(96rpx + env(safe-area-inset-bottom)); }
.form-card { margin-top: 24rpx; padding: 28rpx; border: 1rpx solid rgba(29,34,40,.1); border-radius: 28rpx; background: rgba(255,255,252,.92); }
.field-label { color: var(--color-ink); font-size: 26rpx; font-weight: 800; }.field-label--spaced { margin-top: 26rpx; }
.current-value { margin-top: 12rpx; color: var(--color-muted); font-size: 28rpx; }.helper { margin-top: 16rpx; color: var(--color-muted); font-size: 22rpx; line-height: 1.5; }
.text-input { box-sizing: border-box; width: 100%; height: 84rpx; margin-top: 14rpx; padding: 0 22rpx; border: 1rpx solid var(--color-line); border-radius: var(--radius-control); color: var(--color-ink); background: var(--color-surface); font-size: 28rpx; }
.code-row { display: grid; grid-template-columns: minmax(0,1fr) 210rpx; gap: 14rpx; align-items: end; }.code-input { min-width: 0; }.code-button { width: 210rpx; height: 84rpx; margin: 14rpx 0 0; padding: 0 12rpx; border-radius: var(--radius-control); font-size: 23rpx; white-space: nowrap; }.code-button::after { border: 0; }
.verify-switch { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx; margin-top: 18rpx; padding: 8rpx; border-radius: var(--radius-control); background: var(--color-mist); }.verify-option { min-width: 0; height: 68rpx; margin: 0; border: 0; border-radius: var(--radius-control); color: var(--color-muted); background: transparent; font-size: 22rpx; font-weight: 700; white-space: nowrap; }.verify-option::after { border: 0; }.verify-option--active { color: var(--color-surface); background: var(--color-primary); }
.form-error { margin-top: 20rpx; padding: 18rpx 20rpx; border-radius: var(--radius-control); color: var(--color-danger); background: rgba(220,38,38,.08); font-size: 24rpx; line-height: 1.5; }.submit-button { width: 100%; margin-top: 26rpx; border-radius: var(--radius-control); }
