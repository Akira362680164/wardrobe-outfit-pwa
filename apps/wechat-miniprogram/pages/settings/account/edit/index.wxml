<view class="page-shell account-edit-page">
  <sub-page-top-bar title="{{title}}" />
  <view class="page-copy">{{description}}</view>
  <view wx:if="{{errorMessage}}" class="form-error">{{errorMessage}}</view>

  <view wx:if="{{kind === 'wechat'}}" class="form-card">
    <view class="field-label">当前状态</view>
    <view class="current-value">{{security && security.wechat.bound ? '已绑定当前微信' : '未绑定微信'}}</view>
    <view class="helper">解绑或换绑都需要密码或邮箱验证码验证。</view>
    <view class="verify-switch">
      <button class="verify-option {{verifyMode === 'password' ? 'verify-option--active' : ''}}" data-mode="password" bindtap="switchVerifyMode">账户密码验证</button>
      <button class="verify-option {{verifyMode === 'email' ? 'verify-option--active' : ''}}" data-mode="email" bindtap="switchVerifyMode">邮箱验证码</button>
    </view>
    <input wx:if="{{verifyMode === 'password'}}" class="text-input" password="true" value="{{currentPassword}}" placeholder="当前账户密码" bindinput="handlePasswordInput" />
    <view wx:else class="code-row">
      <input class="text-input code-input" value="{{emailCode}}" type="number" maxlength="6" placeholder="邮箱验证码" bindinput="handleCodeInput" />
      <button class="secondary-button code-button" loading="{{sending}}" disabled="{{sending || countdown > 0}}" bindtap="sendCode">{{countdown > 0 ? countdown + 's' : codeSent ? '再次发送' : '发送验证码'}}</button>
    </view>
  </view>

  <block wx:elif="{{kind === 'email'}}">
    <view class="form-card">
      <view class="field-label">当前邮箱</view>
      <view class="current-value">{{currentValue}}</view>
      <view class="field-label field-label--spaced">新邮箱</view>
      <input class="text-input" value="{{targetValue}}" type="text" placeholder="name@example.com" bindinput="handleTargetInput" />
      <view class="code-row">
        <input class="text-input code-input" value="{{emailCode}}" type="number" maxlength="6" placeholder="新邮箱验证码" bindinput="handleCodeInput" />
        <button class="secondary-button code-button" loading="{{sending}}" disabled="{{sending || countdown > 0}}" bindtap="sendCode">{{countdown > 0 ? countdown + 's' : codeSent ? '再次发送' : '发送验证码'}}</button>
      </view>
    </view>
  </block>

  <block wx:elif="{{kind === 'phone'}}">
    <view class="form-card">
      <view class="field-label">当前手机号</view>
      <view class="current-value">{{currentValue}}</view>
      <view class="field-label field-label--spaced">新手机号</view>
      <input class="text-input" value="{{targetValue}}" type="number" placeholder="请输入手机号" bindinput="handleTargetInput" />
      <view class="verify-switch">
        <button class="verify-option {{verifyMode === 'password' ? 'verify-option--active' : ''}}" data-mode="password" bindtap="switchVerifyMode">账户密码验证</button>
        <button class="verify-option {{verifyMode === 'email' ? 'verify-option--active' : ''}}" data-mode="email" bindtap="switchVerifyMode">邮箱验证码</button>
      </view>
      <input wx:if="{{verifyMode === 'password'}}" class="text-input" password="true" value="{{currentPassword}}" placeholder="当前账户密码" bindinput="handlePasswordInput" />
      <view wx:else class="code-row">
        <input class="text-input code-input" value="{{emailCode}}" type="number" maxlength="6" placeholder="邮箱验证码" bindinput="handleCodeInput" />
        <button class="secondary-button code-button" loading="{{sending}}" disabled="{{sending || countdown > 0}}" bindtap="sendCode">{{countdown > 0 ? countdown + 's' : codeSent ? '再次发送' : '发送验证码'}}</button>
      </view>
    </view>
  </block>

  <button class="primary-button submit-button" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">{{kind === 'wechat' ? (security && security.wechat.bound ? '解绑微信' : '换绑微信') : '保存修改'}}</button>
  <ui-confirm-sheet visible="{{confirmOpen}}" title="确认微信操作" content="该操作会改变小程序登录方式，请先确认当前账号仍有其他登录方式。" confirm-text="继续" danger="{{security && security.wechat.bound}}" loading="{{saving}}" bindclose="closeConfirm" bindconfirm="confirmWechat" />
</view>
