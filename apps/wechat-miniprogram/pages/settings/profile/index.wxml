<view class="page-shell form-page">
  <sub-page-top-bar title="穿衣画像" />
  <view class="page-copy">用于推荐、买前评估和 AI 试穿姿态参考。</view
  ><view wx:if="{{loading}}" class="status-card">正在读取...</view
  ><view wx:elif="{{error}}" class="status-card"
    >{{error}}<button bindtap="load">重试</button></view
  ><block wx:else
    ><view wx:if="{{conflict}}" class="status-card"
      >其他设备已更新画像。你的字段仍保留，已刷新 revision，请检查后重试。</view
    ><view class="card"
      ><view class="label">版型倾向</view
      ><view class="chips"
        ><view
          wx:for="{{fitOptions}}"
          wx:key="0"
          data-field="fitGender"
          data-value="{{item[0]}}"
          class="chip {{fitGender===item[0]?'active':''}}"
          bindtap="choose"
          >{{item[1]}}</view
        ></view
      ><view class="label">身高 (cm)</view
      ><input
        type="number"
        value="{{heightCm}}"
        data-field="heightCm"
        bindinput="input"
      /><view class="label">体型</view
      ><view class="chips"
        ><view
          wx:for="{{bodyOptions}}"
          wx:key="0"
          data-field="bodyType"
          data-value="{{item[0]}}"
          class="chip {{bodyType===item[0]?'active':''}}"
          bindtap="choose"
          >{{item[1]}}</view
        ></view
      ><input
        wx:if="{{bodyType==='custom'}}"
        value="{{bodyTypeCustom}}"
        data-field="bodyTypeCustom"
        placeholder="自定义体型"
        bindinput="input"
      /><view class="label">肩宽</view
      ><view class="chips"
        ><view
          wx:for="{{shoulderOptions}}"
          wx:key="0"
          data-field="shoulderWidth"
          data-value="{{item[0]}}"
          class="chip {{shoulderWidth===item[0]?'active':''}}"
          bindtap="choose"
          >{{item[1]}}</view
        ></view
      ><view class="label">腿长比例</view
      ><view class="chips"
        ><view
          wx:for="{{legOptions}}"
          wx:key="0"
          data-field="legRatio"
          data-value="{{item[0]}}"
          class="chip {{legRatio===item[0]?'active':''}}"
          bindtap="choose"
          >{{item[1]}}</view
        ></view
      ><view class="label">发型 / 发色</view
      ><input
        value="{{hairDescription}}"
        data-field="hairDescription"
        bindinput="input"
      /><view class="label">肤色 / 妆容偏好</view
      ><input
        value="{{skinToneDescription}}"
        data-field="skinToneDescription"
        bindinput="input"
      /><view class="label">其他备注</view
      ><textarea
        value="{{styleNote}}"
        data-field="styleNote"
        bindinput="input"
      /></view
    ><button class="save" loading="{{saving}}" bindtap="save">
      保存
    </button></block
  ></view
>
