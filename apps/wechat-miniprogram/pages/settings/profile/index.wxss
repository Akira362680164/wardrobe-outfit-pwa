.form-page{padding:0 28rpx 120rpx}.card{margin-top:22rpx;padding:26rpx;border-radius:24rpx;background:white;box-shadow:var(--shadow-card)}.label{margin:24rpx 0 10rpx;font-size:24rpx;font-weight:800}.chips{display:flex;flex-wrap:wrap;gap:10rpx}.chip{padding:11rpx 18rpx;border-radius:999rpx;background:var(--color-mist);font-size:22rpx}.chip.active{color:white;background:var(--color-primary)}input,textarea{box-sizing:border-box;width:100%;padding:18rpx;border:1rpx solid rgba(29,34,40,.12);border-radius:16rpx;background:white}.save{margin-top:22rpx;color:white;background:var(--color-primary)}
