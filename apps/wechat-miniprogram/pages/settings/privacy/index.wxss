.settings-page { padding: 0 32rpx calc(env(safe-area-inset-bottom) + 80rpx); }

.info-card {
  margin-top: 32rpx;
  padding: 30rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: rgba(255, 255, 252, 0.78);
  box-shadow: var(--shadow-card);
}

.bullet-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
}

.bullet-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.bullet-text {
  min-width: 0;
  color: var(--color-ink);
  font-size: var(--font-body);
  line-height: 1.55;
}

.link-button {
  height: 84rpx;
  margin-top: 20rpx;
  border: 0;
  border-radius: var(--radius-control);
  background: rgba(29, 34, 40, 0.08);
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 84rpx;
}
