<view class="settings-page page-shell">
  <sub-page-top-bar title="隐私" />
  <view class="page-copy">这里先明确小程序的数据边界；正式协议页面走 WebView 入口。</view>

  <view class="info-card">
    <view wx:for="{{items}}" wx:key="*this" class="bullet-row">
      <view class="bullet-dot"></view>
      <view class="bullet-text">{{item}}</view>
    </view>
  </view>

  <button class="link-button" bindtap="openAgreement">用户服务协议</button>
  <button class="link-button" bindtap="openPrivacy">隐私政策</button>
</view>
