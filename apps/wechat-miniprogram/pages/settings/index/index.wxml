<view class="settings-page page-shell">
  <view class="page-title">我的</view>
  <view class="page-copy">账号、安全、隐私和服务状态。</view>

  <view class="settings-list">
    <view
      wx:for="{{sections}}"
      wx:key="title"
      class="settings-row"
      data-url="{{item.url}}"
      bindtap="openSection"
    >
      <view class="row-text">
        <view class="row-title">{{item.title}}</view>
        <view class="row-copy">{{item.copy}}</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
  </view>
</view>
