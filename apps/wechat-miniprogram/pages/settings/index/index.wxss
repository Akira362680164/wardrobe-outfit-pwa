.settings-page { padding: 0 32rpx calc(env(safe-area-inset-bottom) + 168rpx); }

.settings-page .page-title {
  margin-bottom: 26rpx;
}

.ai-banner {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 0;
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-secondary);
  background: rgba(185, 113, 85, 0.12);
}

.banner-mark {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-ai);
  line-height: 1;
}

.banner-copy {
  min-width: 0;
  color: var(--color-muted);
  font-size: var(--font-caption);
  line-height: 1.45;
}

.settings-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 30rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.78);
  box-shadow: var(--shadow-card);
}

.settings-row-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.settings-row-card.compact {
  padding-top: 26rpx;
  padding-bottom: 26rpx;
}

.settings-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  border-radius: var(--radius-thumb);
  color: var(--color-primary);
  background: rgba(53, 92, 125, 0.10);
  font-size: 36rpx;
  line-height: 1;
}

.settings-main {
  min-width: 0;
  flex: 1;
}

.card-title {
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 800;
  line-height: 1.3;
}

.card-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.card-foot {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: var(--font-label);
  line-height: 1.45;
}

.card-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  flex: 0 0 auto;
  max-width: 150rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-control);
  color: var(--color-primary);
  background: rgba(255, 255, 252, 0.66);
  font-size: var(--font-label);
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.muted-panel {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-control);
  color: var(--color-muted);
  background: rgba(244, 245, 243, 0.78);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.toggle-off {
  position: relative;
  width: 88rpx;
  height: 52rpx;
  flex: 0 0 88rpx;
  border-radius: 999rpx;
  background: rgba(29, 34, 40, 0.18);
}

.toggle-off::after {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-surface);
  content: "";
}

.status-line {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: var(--radius-control);
  color: var(--color-ai);
  background: rgba(185, 113, 85, 0.10);
  font-size: var(--font-label);
  font-weight: 800;
  line-height: 1;
}
