.photos-page{padding:0 28rpx 100rpx}.switch-card{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:26rpx;border-radius:24rpx;background:white;box-shadow:var(--shadow-card)}.title{font-size:28rpx;font-weight:800}.copy,.privacy{margin-top:8rpx;color:var(--color-muted);font-size:22rpx;line-height:1.6}.slots{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.slot{padding:14rpx;border-radius:22rpx;background:white;box-shadow:var(--shadow-card)}.slot image,.empty{width:100%;height:360rpx;border-radius:16rpx;background:var(--color-mist)}.empty{display:flex;align-items:center;justify-content:center;color:var(--color-muted);font-size:23rpx}.slot button{width:100%;height:66rpx;margin-top:10rpx;font-size:21rpx;line-height:66rpx}.save{margin-top:24rpx;color:white;background:var(--color-primary)}
