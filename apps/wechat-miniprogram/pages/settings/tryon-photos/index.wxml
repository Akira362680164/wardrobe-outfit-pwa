<view class="page-shell photos-page" style="padding-top: {{contentTopRpx}}rpx;"
  ><view class="page-title">AI 试穿参考照片</view
  ><view class="switch-card"
    ><view
      ><view class="title">使用参考照生成试穿图</view
      ><view class="copy"
        >仅在你主动生成 AI 试穿图时发送给 MiniMax。</view
      ></view
    ><switch checked="{{enabled}}" bindchange="toggle" /></view
  ><view wx:if="{{loading}}" class="status-card">正在读取...</view
  ><view wx:elif="{{error}}" class="status-card">{{error}}</view
  ><view wx:elif="{{enabled}}" class="slots"
    ><view class="slot"
      ><image
        wx:if="{{fullBodyPath}}"
        src="{{fullBodyPath}}"
        mode="aspectFit"
        data-src="{{fullBodyPath}}"
        bindtap="preview"
      /><view wx:else class="empty">全身照（必需）</view
      ><button data-target="fullBody" bindtap="choose">
        {{fullBodyPath?'替换 / 裁切':'上传全身照'}}</button
      ><button wx:if="{{fullBodyPath}}" data-target="fullBody" bindtap="remove">
        删除
      </button></view
    ><view class="slot"
      ><image
        wx:if="{{facePath}}"
        src="{{facePath}}"
        mode="aspectFit"
        data-src="{{facePath}}"
        bindtap="preview"
      /><view wx:else class="empty">脸部照（可选）</view
      ><button data-target="face" bindtap="choose">
        {{facePath?'替换 / 裁切':'上传脸部照'}}</button
      ><button wx:if="{{facePath}}" data-target="face" bindtap="remove">
        删除
      </button></view
    ></view
  ><view class="privacy"
    >全身照请站直、光线均匀；脸部照建议正脸自然表情。照片不会公开展示。</view
  ><button class="save" loading="{{saving}}" bindtap="save">
    完成并保存
  </button></view
>
