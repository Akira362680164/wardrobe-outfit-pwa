<view class="settings-page page-shell">
  <view class="page-title">AI Key</view>
  <view class="page-copy">小程序版本不在这里录入密钥。后续讨论后端 AI 代理后，再开放统一能力。</view>

  <view class="info-card">
    <view wx:for="{{rows}}" wx:key="label" class="field">
      <view class="field-label">{{item.label}}</view>
      <view class="field-value">{{item.value}}</view>
    </view>
  </view>

  <button class="disabled-button" disabled>暂不可配置</button>
</view>
