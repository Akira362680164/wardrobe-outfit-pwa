.settings-page { padding: 48rpx 28rpx 160rpx; }

.info-card {
  margin-top: 32rpx;
  padding: 30rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.78);
  box-shadow: var(--shadow-card);
}

.field {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.field:last-child { border-bottom: 0; }

.field-label {
  color: var(--color-muted);
  font-size: var(--font-caption);
}

.field-value {
  margin-top: 8rpx;
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1.45;
}

.disabled-button {
  height: 88rpx;
  margin-top: 28rpx;
  border: 0;
  border-radius: var(--radius-pill);
  background: rgba(29, 34, 40, 0.08);
  color: var(--color-muted);
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 88rpx;
}
