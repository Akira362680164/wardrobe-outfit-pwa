<view class="page-shell" style="padding-top: {{titleTopRpx}}rpx;">
  <view class="page-header">
    <view>
      <view class="page-title">种草</view>
      <view class="page-copy">{{summaryText}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="status-card">正在读取种草...</view>

  <view wx:elif="{{error}}" class="status-card">
    <view class="status-title">读取失败</view>
    <view class="status-copy">{{error}}</view>
    <button class="mini-button" bindtap="loadWishlist">重试</button>
  </view>

  <view wx:elif="{{items.length === 0}}" class="status-card">
    <view class="status-title">{{emptyTitle || '还没有种草'}}</view>
    <view class="status-copy">先记录名称、价格、链接和商品图；AI 评估后续再接。</view>
    <button class="mini-button" bindtap="handleEmptyAction">{{emptyAction || '新增种草'}}</button>
  </view>

  <view wx:else>
    <scroll-view class="status-chips" scroll-x enable-flex>
      <button
        wx:for="{{statusChips}}"
        wx:key="key"
        class="status-chip {{activeStatus === item.key ? 'status-chip--active' : ''}}"
        data-status="{{item.key}}"
        bindtap="setStatusFilter"
      >
        {{item.label}} {{item.count}}
      </button>
    </scroll-view>

    <view wx:if="{{filteredItems.length === 0}}" class="status-card">
      <view class="status-title">当前筛选没有种草</view>
      <view class="status-copy">切换状态，或用右下角新增一件。</view>
    </view>

    <view wx:else class="wishlist-grid">
      <catalog-card
        wx:for="{{filteredItems}}"
        wx:key="id"
        id="{{item.id}}"
        image-url="{{item.imageUrl}}"
        fallback="{{item.categoryLabel}}"
        title="{{item.name}}"
        meta="{{item.categoryLabel}} · {{item.priceText}}"
        badge="{{item.statusText}}"
        tone="shopping"
        bind:select="openDetail"
      />
    </view>
  </view>

  <button class="content-fab" aria-label="新建" bindtap="openCreateSheet">＋</button>
  <create-sheet open="{{createSheetOpen}}" active="add_wishlist_item" bind:close="closeCreateSheet" />
</view>
