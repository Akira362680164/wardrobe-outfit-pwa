.page-shell { padding: 48rpx 28rpx 160rpx; }

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.icon-action {
  width: 84rpx;
  height: 84rpx;
  border: 0;
  border-radius: var(--radius-pill);
  background: var(--color-shopping);
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.icon-action::after,
.mini-button::after { border: 0; }

.status-card,
.wishlist-card {
  box-sizing: border-box;
  border: 1rpx solid var(--color-line);
  background: rgba(255, 255, 252, 0.78);
  box-shadow: var(--shadow-card);
}

.status-card {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: var(--radius-card-inner);
  color: var(--color-muted);
  font-size: var(--font-body);
}

.status-title {
  margin-bottom: 12rpx;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 700;
}

.status-copy {
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.55;
}

.mini-button {
  box-sizing: border-box;
  width: 220rpx;
  height: 88rpx;
  margin: 28rpx 0 0;
  border: 0;
  border-radius: var(--radius-pill);
  background: var(--color-shopping);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 88rpx;
}

.wishlist-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 28rpx;
}

.wishlist-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  padding: 18rpx;
  border-radius: 32rpx;
}

.wishlist-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  background: var(--color-mist);
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  font-size: var(--font-label);
}

.wishlist-main { min-width: 0; flex: 1; }

.wishlist-name,
.wishlist-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wishlist-name {
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 700;
}

.wishlist-meta {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
}

.status-pill {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: var(--radius-pill);
  background: rgba(140, 74, 98, 0.10);
  color: var(--color-shopping);
  font-size: var(--font-label);
  font-weight: 700;
}
