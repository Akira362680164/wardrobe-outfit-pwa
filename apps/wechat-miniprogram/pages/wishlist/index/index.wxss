.page-shell { padding: 0 32rpx 176rpx; }

.page-header {
  padding-right: 180rpx;
}

.content-fab::after,
.mini-button::after { border: 0; }

.content-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 188rpx);
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  box-shadow: 0 22rpx 56rpx rgba(53, 92, 125, 0.22);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.status-card {
  box-sizing: border-box;
  border: 1rpx solid var(--color-line);
  background: rgba(255, 255, 252, 0.78);
  box-shadow: var(--shadow-card);
}

.status-card {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: var(--radius-card-inner);
  color: var(--color-muted);
  font-size: var(--font-body);
}

.status-title {
  margin-bottom: 12rpx;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 700;
}

.status-copy {
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.55;
}

.mini-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  height: 88rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-control);
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1;
}

.status-chips {
  display: flex;
  width: 100%;
  margin: 26rpx 0 24rpx;
  white-space: nowrap;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  height: 52rpx;
  margin: 0 14rpx 0 0;
  padding: 0 20rpx;
  border: 1rpx solid transparent;
  border-radius: var(--radius-control);
  background: transparent;
  color: var(--color-muted);
  font-size: var(--font-caption);
  font-weight: 700;
  line-height: 52rpx;
}

.status-chip::after { border: 0; }

.status-chip--active {
  border-color: rgba(140, 74, 98, 0.24);
  background: rgba(140, 74, 98, 0.10);
  color: var(--color-shopping);
}

.wishlist-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}
