.detail-page {
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 64rpx);
}

.status-card,
.notice-card,
.info-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.86);
  box-shadow: var(--shadow-card);
}

.status-title {
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
}

.status-copy,
.section-copy {
  margin-top: 12rpx;
  overflow-wrap: anywhere;
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.6;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 18rpx;
  margin-top: 32rpx;
}

.action-button {
  box-sizing: border-box;
  min-width: 0;
  height: 82rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: var(--font-body);
  font-weight: 800;
  line-height: 82rpx;
}

.action-button::after {
  border: 0;
}

.action-button[disabled] {
  opacity: 0.58;
}

.bought,
.edit {
  color: var(--color-surface);
  background: var(--color-primary);
}

.reject {
  border: 1rpx solid rgba(220, 38, 38, 0.35);
  color: var(--color-danger);
  background: rgba(255, 255, 252, 0.72);
}

.danger {
  color: var(--color-surface);
  background: var(--color-danger);
}

.notice-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-left: 6rpx solid var(--color-success);
  color: var(--color-ink);
  font-size: var(--font-body);
}

.check-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: var(--color-success);
  background: rgba(95, 112, 88, 0.12);
  font-weight: 800;
}

.card-title {
  margin-bottom: 22rpx;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
}

.info-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 10rpx 0;
  color: var(--color-ink);
  font-size: var(--font-body);
  line-height: 1.45;
}

.info-row > text:first-child {
  color: var(--color-muted);
}

.break-text {
  overflow-wrap: anywhere;
}

.delete-actions {
  display: grid;
  gap: 18rpx;
}

.sheet-button {
  width: 100%;
  height: 92rpx;
  margin: 0;
  border-radius: var(--radius-control);
  font-size: var(--font-body);
  font-weight: 800;
  line-height: 92rpx;
}

.sheet-button::after {
  border: 0;
}

.sheet-button--danger {
  color: var(--color-surface);
  background: var(--color-danger);
}

.sheet-button--secondary {
  color: var(--color-ink);
  background: rgba(244, 245, 243, 0.88);
}
