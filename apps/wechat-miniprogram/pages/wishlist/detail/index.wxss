.page-shell { padding: 48rpx 28rpx 160rpx; }
.status-card, .detail-card { box-sizing: border-box; margin-top: 28rpx; padding: 32rpx; border: 1rpx solid var(--color-line); border-radius: var(--radius-card-inner); background: rgba(255,255,252,0.8); box-shadow: var(--shadow-card); }
.hero-image { width: 100%; height: 520rpx; margin-bottom: 28rpx; border-radius: 32rpx; background: var(--color-mist); }
.fallback { display: flex; align-items: center; justify-content: center; color: var(--color-muted); font-size: var(--font-body); }
.status-title, .section-title { color: var(--color-ink); font-size: var(--font-section); font-weight: 700; }
.status-copy, .section-copy { margin-top: 12rpx; overflow-wrap: anywhere; color: var(--color-muted); font-size: var(--font-body); line-height: 1.55; }
.section-title { margin-top: 30rpx; }
