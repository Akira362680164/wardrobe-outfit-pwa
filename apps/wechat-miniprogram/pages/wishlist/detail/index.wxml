<view class="page-shell detail-page">
  <view wx:if="{{initialLoading}}" class="status-card">正在读取种草...</view>
  <view wx:elif="{{error && !item}}" class="status-card"><view class="status-title">读取失败</view><view class="status-copy">{{error}}</view></view>
  <item-detail-shell wx:elif="{{item}}" top-title="种草详情" title="{{item.name}}" meta="{{item.meta}}" eyebrow="{{item.statusText}}" image-url="{{item.imageUrl}}" hero-label="商品图" hero-fallback="{{item.categoryLabel}}">
    <button slot="topRight" class="more-button" bindtap="openMenu" aria-label="更多操作">•••</button>
    <view slot="afterHero"><item-media-section image-url="{{item.imageUrl}}" inspiration-images="{{item.inspirationImages}}" bind:add="addInspiration" bind:preview="previewMedia" bind:remove="removeInspiration" /></view>
    <view slot="tabs" class="detail-tabs"><view class="detail-tab {{activeTab === 'info' ? 'is-active' : ''}}" data-tab="info" bindtap="switchTab">信息</view><view class="detail-tab {{activeTab === 'pairing' ? 'is-active' : ''}}" data-tab="pairing" bindtap="switchTab">搭配</view><view class="detail-tab {{activeTab === 'record' ? 'is-active' : ''}}" data-tab="record" bindtap="switchTab">记录</view></view>
    <block wx:if="{{activeTab === 'info'}}"><view wx:if="{{item.convertedGarmentMissing}}" class="status-card converted-missing"><view class="status-title">已转换的衣橱单品已被删除</view><view class="status-copy">种草记录仍保留，但不能撤销购买；可归档或删除本记录。</view></view><view class="action-row"><button class="action-button bought" loading="{{actioning === 'purchase'}}" disabled="{{actioning || item.convertedGarmentMissing}}" bindtap="togglePurchase">{{item.status === 'purchased' ? '撤销购买' : '已买转衣橱'}}</button><button class="action-button reject" loading="{{actioning === 'reject'}}" disabled="{{actioning || item.status === 'purchased'}}" bindtap="toggleRejected">{{item.status === 'rejected' ? '恢复想买' : '不想买'}}</button></view><item-field-sections item="{{item}}" kind="wishlist" /></block>
    <view wx:elif="{{activeTab === 'pairing'}}" class="info-card empty-panel"><view class="card-title">搭配与相似内容</view><view class="section-copy">建议优先比较同分类 {{item.categoryLabel}}、相近颜色与相同风格的现有衣物，确认是否能加入至少两套已有搭配，再决定购买。</view></view>
    <view wx:else class="info-card"><view class="card-title">种草记录</view><view class="info-row"><text>当前状态</text><text>{{item.statusText}}</text></view><view wx:if="{{item.convertedGarmentId}}" class="section-copy">已转换单品：{{item.convertedGarmentId}}</view></view>
  </item-detail-shell>
  <ui-sheet open="{{menuOpen}}" title="种草操作" bind:close="closeMenu"><view class="delete-actions"><button class="sheet-button" bindtap="editItem">编辑</button><button class="sheet-button" bindtap="toggleArchived">{{item.status === 'archived' ? '恢复种草' : '归档'}}</button><button wx:if="{{item.convertedGarmentId}}" class="sheet-button" bindtap="openConvertedGarment">打开已转换单品</button><button class="sheet-button sheet-button--danger" bindtap="openDeleteSheet">删除</button></view></ui-sheet>
  <ui-sheet open="{{deleteSheetOpen}}" title="删除这件种草？" description="删除后将从服务器种草列表移除。" bind:close="closeDeleteSheet"><view class="delete-actions"><button class="sheet-button sheet-button--danger" loading="{{deleting}}" bindtap="confirmDelete">确认删除</button><button class="sheet-button sheet-button--secondary" bindtap="closeDeleteSheet">取消</button></view></ui-sheet>
</view>
