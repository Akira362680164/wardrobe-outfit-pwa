.plan-edit {
  padding-right: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 96rpx);
  padding-left: 32rpx;
}

.edit-top {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.top-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.top-back {
  margin-right: 18rpx;
  color: var(--color-ink);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
}

.top-title {
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  width: 100%;
  height: 88rpx;
  margin: 8rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 28rpx;
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: var(--font-body);
  font-weight: 800;
  line-height: 88rpx;
}

.save-button::after,
.activity-add::after {
  border: 0;
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
  padding-top: 44rpx;
}

.status-card,
.error-card {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 252, 0.72);
  color: var(--color-muted);
  font-size: var(--font-body);
}

.error-card {
  margin-top: 0;
  color: var(--color-danger);
  background: rgba(220, 38, 38, 0.08);
}

.field {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-label {
  color: rgba(29, 34, 40, 0.64);
  font-size: var(--font-body);
  font-weight: 700;
}

.field-input,
.date-picker {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 28rpx;
  background: rgba(255, 255, 252, 0.74);
  color: var(--color-ink);
  font-size: 30rpx;
  line-height: 88rpx;
}

.date-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 44rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
}

.date-to {
  color: var(--color-muted);
  font-size: var(--font-body);
  text-align: center;
}

.date-caret {
  color: var(--color-muted);
  font-size: var(--font-caption);
}

.activity-row {
  display: flex;
  gap: 16rpx;
}

.activity-input {
  min-width: 0;
  flex: 1;
}

.activity-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 28rpx;
  color: var(--color-primary);
  background: rgba(53, 92, 125, 0.10);
  font-size: var(--font-caption);
  font-weight: 800;
  line-height: 88rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(53, 92, 125, 0.16);
  border-radius: 999rpx;
  color: var(--color-primary);
  background: rgba(53, 92, 125, 0.08);
  font-size: var(--font-label);
  font-weight: 700;
}

.tone-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.tone-dot {
  width: 72rpx;
  height: 72rpx;
  border: 6rpx solid transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.tone-dot--active {
  border-color: var(--color-primary);
  box-shadow: inset 0 0 0 8rpx rgba(255, 255, 252, 0.9);
}

.tone-denim { background: #b8c8d2; }
.tone-moss { background: #c2cbc0; }
.tone-clay { background: #e2c9bd; }
.tone-amber { background: #ffd352; }
.tone-rose { background: #f78b9b; }
.tone-purple { background: #c89bed; }
.tone-slate { background: #c8d2de; }

.packing-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
