.plan-detail {
  padding-right: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx);
  padding-left: 32rpx;
}

.detail-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.top-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.top-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 12rpx;
  color: var(--color-ink);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
}

.top-title {
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-card,
.summary-card,
.daily-card,
.packing-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.78);
  box-sizing: border-box;
}

.status-card {
  color: var(--color-muted);
  font-size: var(--font-body);
  text-align: center;
}

.status-card--error {
  color: var(--color-danger);
}

.retry-button,
.primary-action,
.danger-action,
.cancel-delete,
.confirm-delete {
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  font-weight: 800;
}

.retry-button::after,
.primary-action::after,
.danger-action::after,
.cancel-delete::after,
.confirm-delete::after {
  border: 0;
}

.retry-button {
  width: 180rpx;
  height: 64rpx;
  margin: 18rpx auto 0;
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: var(--font-caption);
  line-height: 64rpx;
}

.detail-stack {
  padding-bottom: 40rpx;
}

.summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.summary-main {
  min-width: 0;
}

.summary-title {
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-date {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
}

.type-pill {
  flex-shrink: 0;
  min-width: 88rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: var(--color-ink);
  font-size: var(--font-label);
  font-weight: 800;
  text-align: center;
}

.tone-denim { background: rgba(53, 92, 125, 0.16); }
.tone-moss { background: rgba(95, 112, 88, 0.16); }
.tone-clay { background: rgba(185, 113, 85, 0.16); }
.tone-amber { background: rgba(244, 190, 66, 0.30); }
.tone-rose { background: rgba(244, 113, 130, 0.20); }
.tone-purple { background: rgba(188, 140, 236, 0.20); }
.tone-slate { background: rgba(148, 163, 184, 0.22); }

.summary-line {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
  font-size: var(--font-caption);
  line-height: 1.5;
}

.summary-label {
  flex-shrink: 0;
  width: 128rpx;
  color: rgba(29, 34, 40, 0.38);
}

.summary-value {
  min-width: 0;
  flex: 1;
  color: rgba(29, 34, 40, 0.76);
}

.action-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.primary-action,
.danger-action {
  height: 76rpx;
  font-size: var(--font-caption);
  line-height: 76rpx;
}

.primary-action {
  background: var(--color-primary);
  color: var(--color-surface);
}

.danger-action {
  border: 1rpx solid rgba(185, 74, 69, 0.20);
  background: rgba(255, 255, 252, 0.90);
  color: var(--color-danger);
}

.section-title,
.packing-title {
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 800;
}

.day-row {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 26rpx;
  background: rgba(255, 255, 252, 0.66);
}

.day-date {
  color: var(--color-ink);
  font-size: var(--font-caption);
  font-weight: 800;
}

.day-outfit {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
}

.day-cover {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: rgba(53, 92, 125, 0.08);
}

.day-cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  font-size: var(--font-caption);
  font-weight: 800;
}

.day-info {
  min-width: 0;
  flex: 1;
}

.day-title {
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--font-caption);
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-meta,
.day-empty,
.packing-copy {
  color: var(--color-muted);
  font-size: var(--font-label);
  line-height: 1.5;
}

.day-meta {
  overflow: hidden;
  margin-top: 4rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-status {
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: var(--font-label);
  font-weight: 800;
}

.day-empty {
  margin-top: 14rpx;
}

.packing-card--disabled {
  opacity: 0.72;
}

.packing-copy {
  margin-top: 8rpx;
}

.delete-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
}

.cancel-delete,
.confirm-delete {
  height: 78rpx;
  font-size: var(--font-caption);
  line-height: 78rpx;
}

.cancel-delete {
  background: rgba(29, 34, 40, 0.06);
  color: var(--color-muted);
}

.confirm-delete {
  background: var(--color-danger);
  color: var(--color-surface);
}
