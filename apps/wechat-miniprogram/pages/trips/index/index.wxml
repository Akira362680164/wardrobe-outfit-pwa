<view class="page-shell trips-page"><view class="header"><view><view class="page-title">旅行计划</view><view class="page-copy">目的地、日期和每日穿搭</view></view><button bindtap="createPlan">新建</button></view><view wx:if="{{loading}}" class="status-card">正在读取计划...</view><view wx:elif="{{error}}" class="status-card"><view>{{error}}</view><button bindtap="load">重试</button></view><view wx:elif="{{!plans.length}}" class="status-card"><view class="status-title">还没有旅行计划</view><view class="page-copy">创建计划后可按日期安排套装。</view><button bindtap="createPlan">创建旅行计划</button></view><view wx:else class="plan-list"><view wx:for="{{plans}}" wx:key="id" class="plan-card" data-id="{{item.id}}" bindtap="openPlan"><view class="plan-main"><view class="plan-title">{{item.title}}</view><view class="plan-meta">{{item.startDate}} - {{item.endDate}} · {{item.destination || '未填写目的地'}}</view><view class="plan-meta">{{item.activities.join(' / ') || '未填写活动'}}</view></view><view class="actions"><button data-id="{{item.id}}" catchtap="editPlan">编辑</button><button data-id="{{item.id}}" loading="{{deletingId===item.id}}" catchtap="deletePlan">删除</button></view></view></view><ui-confirm-sheet visible="{{deleteConfirmOpen}}" title="删除旅行计划？" content="{{deleteConfirmTitle}} 的相关日期安排将按服务端规则同步处理。" confirm-text="确认删除" danger="true" bind:close="closeDeleteConfirm" bind:confirm="confirmDeleteFromSheet" /></view>
