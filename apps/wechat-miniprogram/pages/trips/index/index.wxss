.trips-page{padding:32rpx 28rpx 90rpx}.header{display:flex;align-items:center;justify-content:space-between}.header button{margin:0;color:white;background:var(--color-primary)}.plan-list{display:grid;gap:18rpx;margin-top:24rpx}.plan-card{display:flex;gap:16rpx;padding:26rpx;border-radius:24rpx;background:white;box-shadow:var(--shadow-card)}.plan-main{min-width:0;flex:1}.plan-title{font-size:30rpx;font-weight:800}.plan-meta{margin-top:8rpx;overflow:hidden;color:var(--color-muted);font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}.actions{display:flex;flex-direction:column;gap:8rpx}.actions button{height:54rpx;margin:0;padding:0 18rpx;font-size:21rpx;line-height:54rpx}
