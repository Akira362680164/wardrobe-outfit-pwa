<view class="legal-page page-shell">
  <sub-page-top-bar title="{{title}}" />
  <view class="legal-hero glass-panel">
    <view class="legal-title">{{title}}</view>
    <view class="legal-date">更新日期：{{updatedAt}}</view>
    <view class="legal-intro text-wrap-safe">{{intro}}</view>
  </view>

  <view wx:for="{{sections}}" wx:key="title" class="legal-section surface-panel">
    <view class="legal-section-title">{{item.title}}</view>
    <view wx:for="{{item.body}}" wx:for-item="line" wx:key="*this" class="legal-line text-wrap-safe">{{line}}</view>
  </view>
</view>
