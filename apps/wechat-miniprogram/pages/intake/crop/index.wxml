<view class="crop-page">
  <view class="crop-header">
    <button class="icon-button" bindtap="cancel"><ui-icon name="chevron-left" size="42" color="#1d2228" /></button>
    <view class="page-title">裁切 / 旋转</view>
    <view class="header-spacer"></view>
  </view>
  <view class="crop-card surface-panel">
    <view class="crop-stage" id="cropStage">
      <image class="crop-image" mode="aspectFit" src="{{src}}" />
      <view class="crop-dim crop-dim--top" style="{{dimTopStyle}}"></view>
      <view class="crop-dim crop-dim--bottom" style="{{dimBottomStyle}}"></view>
      <view class="crop-dim crop-dim--left" style="{{dimLeftStyle}}"></view>
      <view class="crop-dim crop-dim--right" style="{{dimRightStyle}}"></view>
      <view class="crop-box" style="{{cropStyle}}" catchtouchstart="startCropMove" catchtouchmove="moveCropMove" catchtouchend="endCropMove">
        <view class="crop-grid crop-grid--v"></view><view class="crop-grid crop-grid--h"></view>
        <view class="crop-handle crop-handle--tl" data-handle="tl" catchtouchstart="startHandle" catchtouchmove="moveHandle" catchtouchend="endHandle"></view>
        <view class="crop-handle crop-handle--tr" data-handle="tr" catchtouchstart="startHandle" catchtouchmove="moveHandle" catchtouchend="endHandle"></view>
        <view class="crop-handle crop-handle--bl" data-handle="bl" catchtouchstart="startHandle" catchtouchmove="moveHandle" catchtouchend="endHandle"></view>
        <view class="crop-handle crop-handle--br" data-handle="br" catchtouchstart="startHandle" catchtouchmove="moveHandle" catchtouchend="endHandle"></view>
      </view>
    </view>
    <view class="ratio-switch">
      <button class="ratio-option {{ratioMode === 'free' ? 'ratio-option--active' : ''}}" data-ratio="free" bindtap="chooseRatio">自由</button>
      <button class="ratio-option {{ratioMode === '3:4' ? 'ratio-option--active' : ''}}" data-ratio="3:4" bindtap="chooseRatio">3:4</button>
    </view>
    <view class="crop-actions">
      <button bindtap="rotateLeft"><ui-icon name="rotate-left" size="30" color="#355c7d" />左转90°</button>
      <button bindtap="rotateRight"><ui-icon name="rotate-right" size="30" color="#355c7d" />右转90°</button>
      <button bindtap="resetCrop"><ui-icon name="reset" size="30" color="#355c7d" />重置</button>
    </view>
    <view class="bottom-actions">
      <button class="secondary-button" bindtap="cancel">取消</button>
      <button class="primary-button" loading="{{applying}}" disabled="{{applying}}" bindtap="applyCrop">应用</button>
    </view>
  </view>
  <canvas canvas-id="cropCanvas" class="crop-canvas"></canvas>
</view>
