<view class="page-shell intake-page">
  <view class="intake-header">
    <view class="page-title">添加单品</view>
    <view class="step-copy">步骤 2 / 2 · 确认信息</view>
    <view class="progress-track"><view class="progress-fill"></view></view>
  </view>

  <view wx:if="{{!draft}}" class="panel">
    <view class="status-title">没有待确认图片</view>
    <button class="primary-button panel-action" bindtap="goBack">返回选择</button>
  </view>

  <view wx:else>
    <view class="preview-card surface-panel">
      <view class="preview-card__top">
        <view class="section-title">确认 1 件单品</view>
        <view class="ai-badge">当前先人工确认</view>
      </view>
      <view class="preview-media">
        <image class="preview-image" mode="aspectFill" src="{{draft.imagePath}}" />
      </view>
      <view class="thumb-row">
        <image class="thumb-image thumb-active" mode="aspectFill" src="{{draft.imagePath}}" />
      </view>
    </view>

    <view class="form-card surface-panel">
      <view class="form-card__top">
        <view class="section-title">校对衣物草稿</view>
        <view class="review-badge">待确认</view>
      </view>
      <view class="form-copy">AI 识别代理未接入；请先人工确认字段后再保存。</view>

      <view class="field-label">名称</view>
      <input class="field-input" value="{{draft.name}}" placeholder="例如 白色衬衫" bindinput="updateName" />

      <view class="field-label">分类</view>
      <view class="chip-row">
        <view wx:for="{{categories}}" wx:key="value" data-value="{{item.value}}" class="chip {{draft.category === item.value ? 'chip-active' : ''}}" bindtap="chooseCategory">{{item.label}}</view>
      </view>

      <view class="field-label">颜色</view>
      <input class="field-input" value="{{draft.color}}" placeholder="例如 白色" bindinput="updateColor" />

      <view class="field-label">季节</view>
      <view class="chip-row">
        <view wx:for="{{seasons}}" wx:key="value" data-value="{{item.value}}" class="chip {{draft.season === item.value ? 'chip-active' : ''}}" bindtap="chooseSeason">{{item.label}}</view>
      </view>

      <view class="field-label">备注</view>
      <textarea class="field-textarea" value="{{draft.note}}" placeholder="可选" bindinput="updateNote" />

      <view wx:if="{{error}}" class="error-text">{{error}}</view>
    </view>

    <view class="bottom-bar bottom-glass-bar">
      <button class="secondary-button bottom-button" disabled="{{saving}}" bindtap="goBack">上一步</button>
      <button class="primary-button bottom-button" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存到衣橱</button>
    </view>
  </view>
</view>
