.page-shell { padding: 48rpx 28rpx 160rpx; }
.preview-image { width: 100%; height: 560rpx; margin-top: 28rpx; border-radius: var(--radius-card-inner); background: var(--color-mist); }
.form-card, .panel { box-sizing: border-box; margin-top: 24rpx; padding: 28rpx; border: 1rpx solid var(--color-line); border-radius: var(--radius-card-inner); background: rgba(255,255,252,0.82); box-shadow: var(--shadow-card); }
.field-label { margin: 24rpx 0 12rpx; color: var(--color-ink); font-size: var(--font-caption); font-weight: 700; }
.field-input, .field-textarea { box-sizing: border-box; width: 100%; border: 1rpx solid var(--color-line); border-radius: var(--radius-control); background: rgba(244,245,243,0.78); color: var(--color-ink); font-size: var(--font-body); }
.field-input { height: 88rpx; padding: 0 24rpx; }
.field-textarea { min-height: 132rpx; padding: 22rpx 24rpx; }
.chip-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip { padding: 14rpx 20rpx; border: 1rpx solid var(--color-line); border-radius: var(--radius-pill); color: var(--color-muted); font-size: var(--font-caption); }
.chip-active { color: #fff; background: var(--color-primary); border-color: var(--color-primary); }
.primary-action { width: 100%; height: 92rpx; margin-top: 30rpx; border: 0; border-radius: var(--radius-pill); color: #fff; background: var(--color-ink); font-size: var(--font-body); font-weight: 700; line-height: 92rpx; }
.status-title { color: var(--color-ink); font-size: var(--font-section); font-weight: 700; }
.error-text { margin-top: 22rpx; color: var(--color-danger); font-size: var(--font-caption); line-height: 1.45; }
