<view class="page-shell">
  <view class="page-title">添加衣物</view>
  <view class="page-copy">选择一张衣物图，确认字段后上传到服务器。小程序不保存本地业务缓存。</view>

  <view class="action-card">
    <button class="primary-action" loading="{{selecting}}" disabled="{{selecting}}" bindtap="chooseFromCamera">拍照添加</button>
    <button class="secondary-action" disabled="{{selecting}}" bindtap="chooseFromAlbum">从相册选择</button>
    <view wx:if="{{error}}" class="error-text">{{error}}</view>
  </view>
</view>
