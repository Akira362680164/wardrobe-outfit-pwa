<view class="page-shell intake-page">
  <view class="intake-header">
    <view class="page-title">添加单品</view>
    <view class="step-copy">步骤 1 / 2 · 选择照片，最多 10 张</view>
    <view class="progress-track"><view class="progress-fill progress-half"></view></view>
  </view>

  <view class="photo-card surface-panel">
    <view class="section-row">
      <view class="section-title">已选照片</view>
      <view class="count-pill">{{totalCount}} / {{maxCount}}</view>
    </view>
    <view wx:if="{{queue.length}}" class="queue-state-row">
      <view class="state-chip state-ready">{{readyCount}} 已准备</view>
      <view class="state-chip state-uploading">{{uploadingCount}} 上传中</view>
      <view class="state-chip state-failed">{{failedCount}} 失败</view>
    </view>
    <view wx:if="{{queue.length}}" class="queue-grid">
      <view wx:for="{{queue}}" wx:key="clientItemId" class="queue-item {{item.status === 'failed' ? 'is-failed' : ''}}">
        <image class="queue-image" mode="aspectFill" src="{{item.stablePath || item.imagePath}}" />
        <view class="queue-index">{{index + 1}}</view>
        <view class="queue-status status-{{item.status}}">
          {{item.status === 'ready' ? '已准备' : item.status === 'uploading' ? '上传中' : item.status === 'failed' ? '失败' : '待上传'}}
        </view>
        <view wx:if="{{item.error}}" class="queue-error">{{item.error}}</view>
      </view>
    </view>
    <view wx:else class="empty-preview">请拍照或从图库选择单品图片</view>
  </view>

  <view class="source-grid {{totalCount ? 'source-grid--compact' : ''}}">
    <button class="source-button" loading="{{selecting}}" disabled="{{selecting || totalCount >= maxCount}}" bindtap="chooseFromCamera">
      <view>拍照</view>
    </button>
    <button class="source-button" disabled="{{selecting || totalCount >= maxCount}}" bindtap="chooseFromAlbum">
      <view>从图库选择</view>
    </button>
  </view>

  <button wx:if="{{queue.length}}" class="clear-button" disabled="{{selecting || uploadingCount}}" bindtap="clearSelected">清空已选图片</button>

  <view class="limit-copy">
    {{totalCount ? readyCount + ' 张已准备，' + failedCount + ' 张失败；失败图片不会影响其他图片。' : '当前最多选择 10 张，图片会逐张上传为临时资产。'}}
  </view>
  <view wx:if="{{error}}" class="error-text">{{error}}</view>

  <view class="bottom-bar bottom-glass-bar">
    <button class="secondary-button bottom-button" disabled>上一步</button>
    <button class="primary-button bottom-button" disabled="{{selecting || uploadingCount || !readyCount}}" loading="{{selecting || uploadingCount}}" bindtap="goReview">下一步（AI识别）</button>
  </view>
</view>
