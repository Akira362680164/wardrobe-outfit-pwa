.intake-page { box-sizing: border-box; display: flex; height: 100vh; min-height: 0; flex-direction: column; overflow: hidden; background: var(--app-ambient); }
.intake-header { box-sizing: border-box; flex: 0 0 auto; background: rgba(251,251,248,.78); backdrop-filter: blur(30px) saturate(1.5); }
.intake-header__row { position: relative; min-height: 64rpx; }
.header-icon-button { position: absolute; top: 0; left: 20rpx; z-index: 2; box-sizing: border-box; display: flex; align-items: flex-start; justify-content: center; width: 80rpx; min-width: 0; height: 80rpx; margin: 0; padding: 0; padding-top: 10rpx; border: 0; border-radius: var(--radius-control); background: transparent; }
.header-icon-button--close { right: 0; left: auto; }
.header-icon-button::after { border: 0; }
.intake-header__copy { position: absolute; top: 0; left: 50%; width: 430rpx; max-width: calc(100% - 200rpx); min-width: 0; transform: translateX(-50%); text-align: center; }
.intake-title { overflow: hidden; color: var(--color-ink); font-size: 34rpx; font-weight: 800; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.step-copy { margin-top: 4rpx; overflow: hidden; color: var(--color-muted); font-size: 24rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.progress-track { height: 8rpx; margin: 16rpx 32rpx 14rpx; overflow: hidden; border-radius: 999rpx; background: var(--color-mist); }
.progress-fill { height: 100%; border-radius: inherit; background: var(--color-primary); }
.progress-half { width: 50%; }
.intake-main { box-sizing: border-box; display: flex; min-height: 0; flex: 1; flex-direction: column; gap: 22rpx; padding: 14rpx 32rpx 24rpx; overflow: hidden; }
.photo-card { position: relative; box-sizing: border-box; display: flex; min-height: 0; flex-direction: column; padding: 22rpx; border-radius: var(--radius-card-inner); }
.photo-card--empty { flex: 0 0 300rpx; }
.photo-card--filled { flex: 1; }
.section-row { display: flex; flex: 0 0 auto; align-items: center; justify-content: space-between; gap: 18rpx; }
.section-title { color: var(--color-ink); font-size: 30rpx; font-weight: 800; line-height: 1.25; }
.count-pill { flex: 0 0 auto; padding: 6rpx 14rpx; border-radius: 999rpx; color: var(--color-muted); background: rgba(255,255,252,.68); font-size: 22rpx; font-weight: 800; line-height: 1.25; }
.hero-area { display: flex; min-height: 0; flex: 1; align-items: center; justify-content: center; margin-top: 14rpx; }
.hero-wrap { position: relative; box-sizing: border-box; width: 480rpx; max-width: 100%; aspect-ratio: 3 / 4; overflow: hidden; border-radius: var(--radius-card-inner); background: var(--color-mist); }
.hero-image { width: 100%; height: 100%; }
.hero-progress { position: absolute; right: 16rpx; bottom: 16rpx; left: 16rpx; padding: 12rpx 16rpx; border-radius: var(--radius-control); color: var(--color-surface); background: rgba(29,34,40,.72); font-size: 22rpx; text-align: center; }
.auto-crop-progress { margin: 10rpx 0 0; color: var(--color-muted); font-size: var(--font-caption); line-height: 1.4; text-align: center; }
.empty-preview { box-sizing: border-box; display: flex; min-height: 0; flex: 1; align-items: center; justify-content: center; margin-top: 14rpx; padding: 24rpx; border: 1rpx dashed rgba(29,34,40,.18); border-radius: var(--radius-thumb); color: var(--color-muted); background: rgba(255,255,252,.58); font-size: 24rpx; line-height: 1.4; text-align: center; }
.thumb-strip { box-sizing: border-box; flex: 0 0 124rpx; width: 100%; height: 124rpx; margin-top: 10rpx; white-space: nowrap; }
.thumb-content { display: inline-flex; gap: 14rpx; min-width: 100%; padding: 6rpx 2rpx; box-sizing: border-box; }
.thumb-wrap { flex: 0 0 112rpx; width: 112rpx; }
.thumb { position: relative; box-sizing: border-box; width: 112rpx; height: 112rpx; overflow: hidden; border: 4rpx solid transparent; border-radius: var(--radius-thumb); background: var(--color-mist); }
.thumb-active { border-color: var(--color-primary); }
.thumb-failed { border-color: var(--color-danger); }
.thumb-image { width: 100%; height: 100%; }
.thumb-status { position: absolute; right: 6rpx; bottom: 6rpx; min-width: 32rpx; padding: 5rpx 8rpx; border-radius: 999rpx; color: var(--color-surface); background: rgba(29,34,40,.68); font-size: 18rpx; line-height: 1; text-align: center; }
.thumb-popover { position: absolute; z-index: 70; box-sizing: border-box; display: grid; grid-template-columns: minmax(0,1fr) 148rpx; gap: 4rpx; width: 424rpx; max-width: calc(100% - 24rpx); padding: 8rpx; border-radius: 30rpx; background: rgba(255,255,252,.96); box-shadow: 0 8rpx 16rpx rgba(29,34,40,.14); white-space: nowrap; }
.thumb-popover__action { box-sizing: border-box; display: flex; min-width: 0; height: 72rpx; align-items: center; justify-content: center; gap: 8rpx; margin: 0; padding: 0 12rpx; border: 0; border-radius: 22rpx; color: var(--color-primary); background: transparent; font-size: 24rpx; font-weight: 800; line-height: 1; white-space: nowrap; }
.thumb-popover__action::after { border: 0; }
.thumb-popover__action--danger { color: var(--color-danger); }
.thumb-popover__arrow { position: absolute; bottom: -8rpx; width: 16rpx; height: 16rpx; border-right: 1rpx solid var(--color-line); border-bottom: 1rpx solid var(--color-line); background: rgba(255,255,252,.96); transform: rotate(45deg); }
.source-grid { box-sizing: border-box; display: grid; flex: 0 0 auto; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 28rpx; width: 100%; min-width: 0; }
.source-button { box-sizing: border-box; display: flex; min-width: 0; min-height: 132rpx; align-items: center; justify-content: center; flex-direction: column; gap: 10rpx; width: 100%; margin: 0; padding: 14rpx; border: 1rpx solid var(--color-line); border-radius: var(--radius-card-inner); color: var(--color-ink); background: rgba(255,255,252,.82); font-size: 26rpx; font-weight: 800; line-height: 1.2; }
.source-button::after { border: 0; }
.source-grid--compact .source-button { min-height: 88rpx; flex-direction: row; gap: 10rpx; }
.limit-copy, .error-text { flex: 0 0 auto; color: var(--color-muted); font-size: 22rpx; line-height: 1.3; text-align: center; }
.error-text { color: var(--color-danger); }
.bottom-bar { box-sizing: border-box; display: grid; flex: 0 0 auto; grid-template-columns: minmax(0,1fr) minmax(0,1.6fr); gap: 16rpx; margin: 0 20rpx calc(env(safe-area-inset-bottom) + 18rpx); padding: 16rpx; overflow: hidden; }
.bottom-action { box-sizing: border-box; display: flex; width: 100%; min-width: 0; height: 88rpx; align-items: center; justify-content: center; margin: 0; padding: 0 12rpx; border: 0; border-radius: var(--radius-control); font-size: 28rpx; font-weight: 800; line-height: 1; text-align: center; white-space: nowrap; }
.bottom-action::after { border: 0; }
.bottom-action--secondary { color: var(--color-primary); background: rgba(53,92,125,.10); }
.bottom-action--primary { color: var(--color-surface); background: var(--color-primary); }
.bottom-action[disabled] { color: rgba(29,34,40,.28); background: rgba(255,255,252,.62); }
