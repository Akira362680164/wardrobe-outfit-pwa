.page-shell { display: flex; align-items: center; padding: 48rpx 28rpx 160rpx; }
.result-card { box-sizing: border-box; width: 100%; padding: 42rpx 32rpx; border: 1rpx solid var(--color-line); border-radius: var(--radius-card); background: rgba(255,255,252,0.84); box-shadow: var(--shadow-card); text-align: center; }
.result-mark { display: inline-flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin-bottom: 26rpx; border-radius: var(--radius-pill); color: #fff; background: var(--color-success); font-size: 54rpx; font-weight: 800; }
.primary-action, .secondary-action { box-sizing: border-box; width: 100%; height: 92rpx; border: 0; border-radius: var(--radius-pill); font-size: var(--font-body); font-weight: 700; line-height: 92rpx; }
.primary-action { margin-top: 34rpx; color: #fff; background: var(--color-ink); }
.secondary-action { margin-top: 18rpx; color: var(--color-ink); background: rgba(29,34,40,0.08); }
