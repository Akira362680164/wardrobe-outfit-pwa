.tryon-page{padding:0 28rpx 100rpx}.reference,.preview,.saved{margin-top:20rpx;padding:20rpx;border-radius:24rpx;background:white;box-shadow:var(--shadow-card)}.reference image,.empty,.preview image{width:100%;height:640rpx;border-radius:18rpx;background:var(--color-mist)}.empty{display:flex;align-items:center;justify-content:center;color:var(--color-muted)}.reference button,.preview button,.generate{width:100%;margin-top:14rpx}.section-title{margin-top:24rpx;font-size:28rpx;font-weight:800}.garments{display:flex;gap:12rpx;margin-top:14rpx}.garment{width:140rpx;padding:6rpx;border:4rpx solid transparent;border-radius:18rpx}.garment.active{border-color:var(--color-primary)}.garment image{width:128rpx;height:160rpx;border-radius:12rpx;background:var(--color-mist)}.garment text{display:block;overflow:hidden;font-size:20rpx;text-overflow:ellipsis;white-space:nowrap}.tryon-page>input{box-sizing:border-box;width:100%;height:76rpx;margin-top:20rpx;padding:0 18rpx;border:1rpx solid rgba(29,34,40,.12);border-radius:16rpx}.generate{color:white;background:var(--color-primary)}.saved-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx}.saved-grid image{width:100%;height:320rpx;border-radius:14rpx}.saved-grid button{width:100%;height:60rpx;margin:6rpx 0 0;font-size:20rpx;line-height:60rpx}
