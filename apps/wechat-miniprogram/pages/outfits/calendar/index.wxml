<view class="page-shell calendar-page" bindtouchstart="onMonthTouchStart" bindtouchend="onMonthTouchEnd">
  <sub-page-top-bar title="穿搭计划" centered-title />

  <view class="month-row">
    <view class="month-arrow" data-delta="prev" bindtap="shiftMonth"><ui-icon name="chevron-left" size="32" tone="ink" /></view>
    <view class="month-title">{{monthTitle}}</view>
    <view class="month-arrow" data-delta="next" bindtap="shiftMonth"><ui-icon name="chevron-right" size="32" tone="ink" /></view>
    <view class="month-plan-link" bindtap="openAddPlanSheet">+计划</view>
  </view>

  <view class="weekday-row">
    <view wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</view>
  </view>

  <view class="calendar-weeks">
    <block wx:for="{{calendarWeeks}}" wx:for-item="week" wx:key="key">
      <view class="calendar-week">
        <view class="calendar-week__days">
          <view
            wx:for="{{week.days}}"
            wx:for-item="day"
            wx:key="key"
            data-date="{{day.key}}"
            class="calendar-day {{day.muted ? 'calendar-day--muted' : ''}} {{day.active ? 'calendar-day--active' : ''}}"
            bindtap="selectDate"
          >
            <view class="calendar-day__num {{day.today ? 'calendar-day__num--today' : ''}}">{{day.label}}</view>
            <view wx:if="{{day.thumbnails.length}}" class="calendar-day__thumb cover-collage cover-collage--{{day.thumbnails.length >= 4 ? '4' : day.thumbnails.length}}">
              <view wx:for="{{day.thumbnails}}" wx:for-item="image" wx:key="*this" wx:if="{{index < 4}}" class="cover-collage__cell">
                <image class="cover-collage__image" mode="aspectFill" src="{{image}}" />
              </view>
            </view>
            <view wx:else class="calendar-day__plus"><ui-icon name="plus" size="22" tone="ink" /></view>
            <plan-tone-strip plans="{{day.plans}}" bind:select="openPlanDetail" />
          </view>
        </view>
      </view>

  <outfit-plan-day-card wx:if="{{week.containsSelectedDate}}"
    card="{{selectedDayCard}}"
    bind:planselect="openPlanDetail"
    bind:outfitselect="openOutfit"
    bind:action="handleDayCardAction"
    bind:backupdelete="handleBackupDelete"
  />
    </block>
  </view>

  <view wx:if="{{initialLoading}}" class="month-empty">
    <view class="month-empty__title">正在读取穿搭计划...</view>
  </view>
  <view wx:elif="{{error && !monthHasData}}" class="plan-card">
    <view class="plan-card__title">读取失败</view>
    <view class="state-copy">{{error}}</view>
    <button class="primary-button retry-button" bindtap="handleStatusAction">{{statusActionLabel || '重试'}}</button>
  </view>
  <view wx:elif="{{!monthHasData}}" class="month-empty">
    <view class="month-empty__title">这个月还没有套装计划</view>
    <view class="month-empty__copy">点击月份右侧 +计划，添加旅行、出差或单日穿搭。</view>
  </view>

  <ui-sheet open="{{addPlanSheetOpen}}" title="添加计划" show-close="{{false}}" bind:close="closeAddPlanSheet">
    <view class="sheet-options">
      <view
        wx:for="{{planOptions}}"
        wx:key="type"
        data-type="{{item.type}}"
        class="sheet-option"
        bindtap="choosePlanType"
      >
        <view class="sheet-option__title">{{item.label}}</view>
        <view class="sheet-option__copy">{{item.desc}}</view>
      </view>
    </view>
  </ui-sheet>

  <ui-sheet open="{{selectSheetOpen}}" title="{{selectionTitle}}" description="{{selectionDescription}}" bind:close="closeOutfitSelector">
    <view class="outfit-select">
      <view class="search-box">
        <view class="search-icon"><ui-icon name="search" size="32" tone="ink" /></view>
        <input class="search-input" value="{{outfitSearch}}" placeholder="搜索套装名称 / 场景" bindinput="onSearchOutfit" />
      </view>

      <view wx:if="{{filteredOutfits.length}}" class="outfit-select__list">
        <view
          wx:for="{{filteredOutfits}}"
          wx:key="id"
          data-id="{{item.id}}"
          class="outfit-option"
          bindtap="chooseOutfit"
        >
          <view wx:if="{{item.itemImages.length}}" class="outfit-option__cover cover-collage cover-collage--{{item.itemImages.length >= 4 ? '4' : item.itemImages.length}}">
            <view wx:for="{{item.itemImages}}" wx:for-item="image" wx:key="*this" wx:if="{{index < 4}}" class="cover-collage__cell">
              <image class="cover-collage__image" mode="aspectFill" src="{{image}}" />
            </view>
          </view>
          <image wx:elif="{{item.imageUrl}}" class="outfit-option__cover" mode="aspectFill" src="{{item.imageUrl}}" />
          <view wx:else class="outfit-option__cover outfit-option__cover--empty">套</view>
          <view class="outfit-option__main">
            <view class="outfit-option__name">{{item.name}}</view>
            <view class="outfit-option__meta">{{item.itemCount}}件 · {{item.sceneText}}</view>
          </view>
        </view>
      </view>

      <view wx:else class="sheet-empty">
        <view class="sheet-empty__icon"><ui-icon name="layers" size="64" tone="ink" /></view>
        <view class="sheet-empty__title">{{outfits.length ? '没有匹配的套装' : '还没有可选择的套装'}}</view>
        <view class="sheet-empty__copy">{{outfits.length ? '换个关键词试试。' : '先从套装页创建一套，再回来安排到日历。'}}</view>
      </view>
    </view>
  </ui-sheet>
</view>
