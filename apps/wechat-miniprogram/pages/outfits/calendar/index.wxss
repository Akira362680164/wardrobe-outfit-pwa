.calendar-page {
  padding-top: 0;
  padding-right: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx);
  padding-left: 32rpx;
}

.month-row {
  position: relative;
}

.month-plan-link {
  position: absolute;
  top: 0;
  left: calc(75% - 20rpx);
  display: flex;
  width: 120rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  transform: translateX(-50%);
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.month-plan-link::after {
  border: 0;
}

.retry-button::after {
  border: 0;
}

.month-row {
  display: grid;
  grid-template-columns: 80rpx 1fr 80rpx;
  align-items: center;
  margin-top: 12rpx;
}

.month-title {
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
  text-align: center;
}

.month-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  color: var(--color-ink);
  font-size: 52rpx;
  font-weight: 700;
}

.weekday-row,
.calendar-week__days {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  column-gap: 6rpx;
  margin-right: 24rpx;
  margin-left: 24rpx;
}

.weekday-row {
  margin-top: 18rpx;
}

.weekday {
  color: rgba(29, 34, 40, 0.36);
  font-size: var(--font-caption);
  text-align: center;
}

.calendar-weeks {
  margin-top: 16rpx;
}

.calendar-week { margin-top: 10rpx; }

.calendar-day {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: flex-start;
  min-width: 0;
  height: 136rpx;
  padding-right: 4rpx;
  padding-bottom: 8rpx;
  padding-left: 4rpx;
  padding-top: 8rpx;
  border: 1rpx solid transparent;
  border-radius: 28rpx;
  box-sizing: border-box;
  color: var(--color-ink);
  overflow: hidden;
}

.calendar-day--muted {
  opacity: 0.42;
}

.calendar-day--active {
  border-color: rgba(53, 92, 125, 0.28);
  background: rgba(53, 92, 125, 0.10);
}

.calendar-day__num {
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 36rpx;
}

.calendar-day__num--today {
  color: var(--color-primary);
}

.calendar-day__thumb,
.calendar-day__plus {
  width: 48rpx;
  height: 58rpx;
  margin-top: 10rpx;
  border-radius: 8rpx;
}

.calendar-day__plus {
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.38;
}

.calendar-day > plan-tone-strip {
  display: block;
  width: 64rpx;
  margin-top: 4rpx;
}

.state-title {
  color: var(--color-muted);
  font-size: var(--font-body);
}

.state-copy,
.month-empty__copy {
  margin-top: 8rpx;
  color: rgba(29, 34, 40, 0.42);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.outfit-option__cover {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 22rpx;
  background: var(--color-mist);
}

.cover-collage {
  display: grid;
  overflow: hidden;
  background: rgba(244, 245, 243, 0.78);
}

.cover-collage--1 { grid-template-columns: 1fr; }

.cover-collage--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }

.cover-collage--3 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: repeat(2, minmax(0, 1fr));
}

.cover-collage--3 .cover-collage__cell:first-child { grid-column: 1 / 3; }

.cover-collage--4 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: repeat(2, minmax(0, 1fr));
}

.cover-collage__cell {
  overflow: hidden;
  border-right: 1rpx solid rgba(255, 255, 252, 0.72);
  border-bottom: 1rpx solid rgba(255, 255, 252, 0.72);
}

.cover-collage__image {
  width: 100%;
  height: 100%;
}

.outfit-option__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(29, 34, 40, 0.32);
  font-size: var(--font-body);
  font-weight: 800;
}

.outfit-option__main {
  min-width: 0;
  flex: 1;
}

.outfit-option__name {
  min-width: 0;
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outfit-option__meta {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.month-empty {
  margin-top: 48rpx;
  text-align: center;
}

.month-empty__title {
  color: rgba(29, 34, 40, 0.42);
  font-size: var(--font-body);
}

.plan-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  color: var(--color-muted);
  background: rgba(255, 255, 252, 0.66);
  box-shadow: var(--shadow-card);
  font-size: var(--font-body);
}

.plan-card__title {
  margin-bottom: 16rpx;
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 800;
}

.retry-button {
  min-height: 72rpx;
  margin-top: 20rpx;
  font-size: var(--font-caption);
  line-height: 72rpx;
}

.sheet-options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.sheet-option {
  padding: 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 28rpx;
  background: rgba(255, 255, 252, 0.82);
}

.sheet-option__title {
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 800;
}

.sheet-option__copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
  line-height: 1.45;
}

.outfit-select {
  max-height: 70vh;
}

.search-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 44rpx;
  background: rgba(255, 255, 252, 0.78);
  box-sizing: border-box;
}

.search-icon {
  margin-right: 12rpx;
  color: rgba(29, 34, 40, 0.34);
  font-size: 34rpx;
}

.search-input {
  min-width: 0;
  flex: 1;
  height: 84rpx;
  color: var(--color-ink);
  font-size: 30rpx;
  line-height: 84rpx;
}

.outfit-select__list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  max-height: 56vh;
  overflow-y: auto;
}

.outfit-option {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 28rpx;
  background: rgba(255, 255, 252, 0.84);
}

.sheet-empty {
  padding: 80rpx 24rpx 56rpx;
  text-align: center;
}

.sheet-empty__icon {
  color: rgba(29, 34, 40, 0.20);
  font-size: 72rpx;
  line-height: 1;
}

.sheet-empty__title {
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: var(--font-body);
}

.sheet-empty__copy {
  margin-top: 8rpx;
  color: rgba(29, 34, 40, 0.42);
  font-size: var(--font-caption);
  line-height: 1.5;
}
