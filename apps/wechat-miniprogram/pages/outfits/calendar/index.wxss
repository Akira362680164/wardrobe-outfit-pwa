.page-shell {
  padding: 28rpx 32rpx 160rpx;
}

.sub-top {
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  padding-right: 160rpx;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-fab);
  background: rgba(255, 255, 252, 0.82);
  color: var(--color-ink);
  font-size: 52rpx;
  line-height: 1;
}

.back-button::after,
.state-button::after {
  border: 0;
}

.sub-title {
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
  text-align: center;
}

.month-row {
  display: grid;
  grid-template-columns: 80rpx 1fr 80rpx;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-line);
}

.month-title {
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
  text-align: center;
}

.month-arrow {
  color: var(--color-ink);
  font-size: 44rpx;
  text-align: center;
}

.weekday-row,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.weekday-row {
  margin-top: 28rpx;
}

.weekday {
  color: rgba(29, 34, 40, 0.36);
  font-size: var(--font-caption);
  text-align: center;
}

.calendar-grid {
  row-gap: 24rpx;
  margin-top: 18rpx;
}

.calendar-day {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 74rpx;
  border: 1rpx solid transparent;
  border-radius: var(--radius-control);
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 700;
}

.calendar-day--muted {
  color: rgba(29, 34, 40, 0.28);
}

.calendar-day--active {
  border-color: rgba(53, 92, 125, 0.24);
  background: rgba(53, 92, 125, 0.10);
  color: var(--color-primary);
}

.today-state {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.56);
  text-align: center;
}

.state-title {
  color: var(--color-muted);
  font-size: var(--font-body);
}

.state-copy,
.month-empty__copy {
  margin-top: 8rpx;
  color: rgba(29, 34, 40, 0.42);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.state-button {
  width: 180rpx;
  min-height: 64rpx;
  margin: 18rpx auto 0;
  padding: 0 20rpx;
  font-size: var(--font-caption);
  line-height: 64rpx;
}

.month-empty {
  margin-top: 58rpx;
  text-align: center;
}

.month-empty__title {
  color: rgba(29, 34, 40, 0.42);
  font-size: var(--font-body);
}

.plan-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  color: var(--color-muted);
  background: rgba(255, 255, 252, 0.66);
  box-shadow: var(--shadow-card);
  font-size: var(--font-body);
}

.plan-card__title {
  margin-bottom: 16rpx;
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 800;
}

.plan-row {
  padding: 18rpx 0;
  border-top: 1rpx solid var(--color-line);
}

.plan-row__name {
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-row__meta {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
}
