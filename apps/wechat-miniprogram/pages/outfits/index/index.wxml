<view class="page-shell" style="padding-top: {{titleTopRpx}}rpx;">
  <view class="outfit-hero">
    <view class="hero-copy">
      <view class="page-title">套装</view>
      <view class="page-copy">{{outfitCountLabel}}</view>
    </view>
    <view class="hero-actions">
      <view class="hero-control hero-control--calendar" role="button" bindtap="openCalendar">月历</view>
      <view class="hero-control hero-control--plan" role="button" bindtap="openAddPlanSheet">+计划</view>
    </view>
  </view>

  <view class="week-card surface-panel" bindtouchstart="onWeekTouchStart" bindtouchend="onWeekTouchEnd">
    <view class="week-card__head">
      <view class="week-card__copy">
        <view class="week-card__title">本周穿搭</view>
        <view class="week-card__range">{{weekRangeLabel}}</view>
      </view>
      <view class="week-card__arrows">
        <view class="week-arrow" data-delta="prev" bindtap="shiftWeek">‹</view>
        <view class="week-arrow" data-delta="next" bindtap="shiftWeek">›</view>
      </view>
    </view>
    <view class="week-strip">
      <view wx:for="{{weekDays}}" wx:key="key" data-date="{{item.key}}" class="week-day {{item.active ? 'week-day--active' : ''}}" bindtap="selectWeekDate">
        <view class="week-day__label">{{item.week}}</view>
        <view class="week-day__date">{{item.day}}</view>
        <view wx:if="{{item.thumbnails.length}}" class="week-day__thumb cover-collage cover-collage--{{item.thumbnails.length >= 4 ? '4' : item.thumbnails.length}}">
          <view wx:for="{{item.thumbnails}}" wx:for-item="image" wx:key="*this" wx:if="{{index < 4}}" class="cover-collage__cell">
            <image class="cover-collage__image" mode="aspectFill" src="{{image}}" />
          </view>
        </view>
        <view wx:else class="week-day__plus">＋</view>
        <view wx:if="{{item.toneClass}}" class="week-day__bar {{item.toneClass}}"></view>
      </view>
    </view>
    <view wx:if="{{selectedWeekEntry}}" class="week-plan-card">
      <view class="week-plan__head">
        <view class="week-plan__date">{{selectedDateLabel}}</view>
        <view wx:if="{{selectedWeekEntry.planId}}" class="week-plan__chip">{{selectedWeekEntry.planTitle}} · {{selectedWeekEntry.planTypeLabel}}</view>
      </view>
      <view class="week-plan__body">
        <view class="week-plan__covers">
          <view wx:if="{{selectedWeekEntry.itemImages.length}}" class="week-plan__cover cover-collage cover-collage--{{selectedWeekEntry.itemImages.length >= 4 ? '4' : selectedWeekEntry.itemImages.length}}">
            <view wx:for="{{selectedWeekEntry.itemImages}}" wx:for-item="image" wx:key="*this" wx:if="{{index < 4}}" class="cover-collage__cell">
              <image class="cover-collage__image" mode="aspectFill" src="{{image}}" />
            </view>
          </view>
          <image wx:elif="{{selectedWeekEntry.imageUrl}}" class="week-plan__cover" mode="aspectFill" src="{{selectedWeekEntry.imageUrl}}" />
          <view wx:else class="week-plan__cover week-plan__cover--empty">套</view>
        </view>
        <view class="week-plan__main">
          <view class="week-plan__name">{{selectedWeekEntry.name}}</view>
          <view class="week-plan__actions">
            <button class="worn-button {{selectedWeekEntry.statusClass}}" bindtap="markTodayWorn">{{selectedWeekEntry.statusLabel}}</button>
            <button class="backup-button" bindtap="openCalendar">添加备选穿搭</button>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="week-empty">
      <view class="week-empty__title">今天还没有安排套装</view>
      <view class="week-empty__copy">可以先把想穿的套装放进计划。</view>
      <button class="primary-button week-empty__button" bindtap="openCompose">安排套装</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="status-card">正在读取套装...</view>

  <view wx:elif="{{error}}" class="status-card">
    <view class="status-title">读取失败</view>
    <view class="status-copy">{{error}}</view>
    <button class="mini-button primary-button" bindtap="loadOutfits">重试</button>
  </view>

  <view wx:elif="{{outfits.length === 0}}" class="status-card">
    <view class="status-title">{{emptyTitle || '还没有套装'}}</view>
    <view class="status-copy">选择几件已有衣物，保存成常穿组合。</view>
    <button class="mini-button primary-button" bindtap="handleEmptyAction">{{emptyAction || '创建套装'}}</button>
  </view>

  <view wx:else class="outfit-list">
    <scroll-view class="filter-row" scroll-x enable-flex>
      <view wx:for="{{filters}}" wx:key="*this" class="filter-chip {{item === activeFilter ? 'filter-chip--active' : ''}}">{{item}}</view>
    </scroll-view>
    <view class="outfit-grid">
      <view wx:for="{{outfits}}" wx:key="id" class="outfit-card" data-id="{{item.id}}" bindtap="openDetail">
        <view class="outfit-collage">
          <view wx:if="{{item.itemImages.length}}" class="cover-collage cover-collage--{{item.itemImages.length >= 4 ? '4' : item.itemImages.length}}">
            <view wx:for="{{item.itemImages}}" wx:for-item="image" wx:key="*this" wx:if="{{index < 4}}" class="cover-collage__cell">
              <image class="cover-collage__image" mode="aspectFill" src="{{image}}" />
            </view>
          </view>
          <image wx:elif="{{item.imageUrl}}" class="collage-image" mode="aspectFill" src="{{item.imageUrl}}" />
          <view wx:else class="collage-empty">{{item.itemCount}}件</view>
        </view>
        <view class="outfit-main">
          <view class="outfit-name">{{item.name}}</view>
          <view class="outfit-meta">{{item.sceneText}} · {{item.seasonText}}</view>
          <view class="outfit-wear">暂无穿着记录</view>
        </view>
      </view>
    </view>
  </view>

  <button wx:if="{{!addPlanSheetOpen && !createSheetOpen}}" class="content-fab" aria-label="新建" bindtap="openCreateSheet">＋</button>
  <create-sheet open="{{createSheetOpen}}" active="create_outfit" bind:close="closeCreateSheet" />
  <ui-sheet open="{{addPlanSheetOpen}}" title="添加计划" show-close="{{false}}" bind:close="closeAddPlanSheet">
    <view class="sheet-options">
      <view wx:for="{{planOptions}}" wx:key="type" data-type="{{item.type}}" class="sheet-option" bindtap="choosePlanType">
        <view class="sheet-option__title">{{item.label}}</view>
        <view class="sheet-option__copy">{{item.desc}}</view>
      </view>
    </view>
  </ui-sheet>
</view>
