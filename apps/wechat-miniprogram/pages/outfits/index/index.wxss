.page-shell { padding: 0 32rpx 180rpx; }

.outfit-hero {
  position: relative;
  min-height: 184rpx;
  min-width: 0;
}

.hero-copy { min-width: 0; flex: 1; }

.hero-actions {
  position: absolute;
  right: 0;
  top: 86rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  width: 330rpx;
}

.content-fab::after,
.mini-button::after,
.hero-control::after,
.week-empty__button::after,
.worn-button::after,
.backup-button::after,
.secondary-button::after { border: 0; }

.content-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 188rpx);
  z-index: 20;
  width: 112rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-fab);
  background: var(--color-primary);
  color: var(--color-surface);
  box-shadow: 0 22rpx 56rpx rgba(53, 92, 125, 0.22);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 104rpx;
  text-align: center;
}

.status-card,
.outfit-card {
  box-sizing: border-box;
  border: 1rpx solid var(--color-line);
  background: rgba(255, 255, 252, 0.78);
  box-shadow: var(--shadow-card);
}

.status-card {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: var(--radius-card-inner);
  color: var(--color-muted);
  font-size: var(--font-body);
}

.status-title {
  margin-bottom: 12rpx;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 700;
}

.status-copy {
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.55;
}

.mini-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0;
  border: 0;
  border-radius: var(--radius-control);
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1;
}

.hero-control {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 88rpx;
  white-space: nowrap;
}

.hero-control--calendar {
  width: 148rpx;
  min-width: 148rpx;
  max-width: 148rpx;
  background: rgba(255, 255, 252, 0.92);
  color: #355C7D;
  box-shadow: 0 12rpx 28rpx rgba(29, 34, 40, 0.10);
}

.hero-control--plan {
  width: 164rpx;
  min-width: 164rpx;
  max-width: 164rpx;
  background: #355C7D;
  color: #FFFFFC;
  box-shadow: 0 18rpx 44rpx rgba(53, 92, 125, 0.22);
}

.mini-button {
  width: 320rpx;
  margin: 28rpx 0 0;
}

.week-card {
  margin-top: 26rpx;
  padding: 28rpx 24rpx 24rpx;
  border: 1rpx solid rgba(29, 34, 40, 0.06);
  border-radius: 36rpx;
  background: rgba(255, 255, 252, 0.82);
  box-shadow: 0 24rpx 60rpx rgba(29, 34, 40, 0.08);
}

.week-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
}

.week-card__copy {
  display: flex;
  align-items: baseline;
  min-width: 0;
  gap: 14rpx;
}

.week-card__title {
  flex: 0 0 auto;
  color: #1D2228;
  font-size: 30rpx;
  font-weight: 800;
}

.week-card__range {
  overflow: hidden;
  color: rgba(29, 34, 40, 0.50);
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.week-card__arrows {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 0 auto;
}

.week-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  color: #1D2228;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.week-strip {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 6rpx;
  margin-top: 20rpx;
}

.week-day {
  display: flex;
  min-width: 0;
  height: 204rpx;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 8rpx 4rpx 8rpx;
  border: 1rpx solid transparent;
  border-radius: 28rpx;
  color: var(--color-muted);
  box-sizing: border-box;
}

.week-day--active {
  border-color: rgba(53, 92, 125, 0.28);
  background: rgba(53, 92, 125, 0.10);
  color: #355C7D;
}

.week-day__label,
.week-day__plus {
  font-size: var(--font-label);
  line-height: 1.2;
}
.week-day__date {
  margin-top: 8rpx;
  color: #1D2228;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.week-day__plus {
  margin-top: 12rpx;
  color: rgba(29, 34, 40, 0.30);
}

.week-day__thumb {
  width: 48rpx;
  height: 58rpx;
  margin-top: 10rpx;
  border-radius: 8rpx;
  background: var(--color-mist);
}

.week-day > plan-tone-strip {
  display: block;
  width: 100%;
  margin-top: 12rpx;
}

.cover-collage {
  display: grid;
  overflow: hidden;
  background: rgba(244, 245, 243, 0.78);
}

.cover-collage--1 {
  grid-template-columns: 1fr;
}

.cover-collage--2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.cover-collage--3 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: repeat(2, minmax(0, 1fr));
}

.cover-collage--3 .cover-collage__cell:first-child {
  grid-column: 1 / 3;
}

.cover-collage--4 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: repeat(2, minmax(0, 1fr));
}

.cover-collage__cell {
  overflow: hidden;
  border-right: 1rpx solid rgba(255, 255, 252, 0.72);
  border-bottom: 1rpx solid rgba(255, 255, 252, 0.72);
}

.cover-collage__image {
  width: 100%;
  height: 100%;
}

.outfit-list {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
}

.filter-row {
  display: flex;
  width: calc(100vw - 64rpx);
  white-space: nowrap;
}

.outfit-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  margin-top: 20rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  margin-right: 22rpx;
  padding: 0 22rpx;
  border: 1rpx solid transparent;
  border-radius: var(--radius-control);
  color: var(--color-muted);
  font-size: var(--font-caption);
  font-weight: 700;
}

.filter-chip--active {
  border-color: rgba(53, 92, 125, 0.28);
  background: rgba(53, 92, 125, 0.10);
  color: var(--color-primary);
}

.outfit-card {
  display: block;
  min-width: 0;
  overflow: hidden;
  padding: 0;
  border-radius: var(--radius-card-inner);
}

.outfit-collage {
  height: 246rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-mist);
  background-image: linear-gradient(135deg, rgba(53, 92, 125, 0.14), rgba(255, 255, 252, 0.72));
}

.outfit-collage > .cover-collage {
  width: 100%;
  height: 100%;
}

.collage-empty {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: rgba(29, 34, 40, 0.48);
  font-size: var(--font-caption);
  font-weight: 800;
}

.collage-image {
  width: 100%;
  height: 100%;
}

.outfit-main {
  min-width: 0;
  padding: 20rpx 20rpx 22rpx;
}

.outfit-name {
  overflow: hidden;
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outfit-meta {
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outfit-wear {
  margin-top: 8rpx;
  color: rgba(29, 34, 40, 0.42);
  font-size: 22rpx;
}

.sheet-options {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.sheet-option {
  padding: 28rpx;
  border: 1rpx solid rgba(29, 34, 40, 0.10);
  border-radius: 24rpx;
  background: rgba(255, 255, 252, 0.90);
}

.sheet-option__title {
  color: #1D2228;
  font-size: 30rpx;
  font-weight: 800;
}

.sheet-option__copy {
  margin-top: 10rpx;
  color: rgba(29, 34, 40, 0.46);
  font-size: 24rpx;
  line-height: 1.45;
}

.outfit-select {
  max-height: 70vh;
}

.search-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 44rpx;
  background: rgba(255, 255, 252, 0.78);
  box-sizing: border-box;
}

.search-icon {
  margin-right: 12rpx;
  color: rgba(29, 34, 40, 0.34);
  font-size: 34rpx;
}

.search-input {
  min-width: 0;
  flex: 1;
  height: 84rpx;
  color: var(--color-ink);
  font-size: 30rpx;
  line-height: 84rpx;
}

.outfit-select__list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  max-height: 56vh;
  overflow-y: auto;
}

.outfit-option {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 28rpx;
  background: rgba(255, 255, 252, 0.84);
}

.outfit-option__cover {
  display: grid;
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: var(--color-mist);
}

.outfit-option__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(29, 34, 40, 0.32);
  font-size: var(--font-body);
  font-weight: 800;
}

.outfit-option__main {
  min-width: 0;
  flex: 1;
}

.outfit-option__name {
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outfit-option__meta {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-empty {
  padding: 40rpx 0 20rpx;
  text-align: center;
}

.sheet-empty__title {
  color: var(--color-muted);
  font-size: var(--font-body);
}

.sheet-empty__copy {
  margin-top: 8rpx;
  color: rgba(29, 34, 40, 0.42);
  font-size: var(--font-caption);
  line-height: 1.5;
}
