<view class="page-shell detail-page">
  <view wx:if="{{loading}}" class="status-card">正在读取套装...</view>
  <view wx:elif="{{error}}" class="status-card">
    <view class="status-title">读取失败</view>
    <view class="status-copy">{{error}}</view>
  </view>
  <view wx:elif="{{outfit}}">
    <detail-shell top-title="套装详情" title="{{outfit.name}}" meta="{{outfit.itemCount}}件 · {{outfit.seasonText}} · {{outfit.sceneText}}" eyebrow="暂无穿着记录" image-url="{{outfit.imageUrl}}" hero-label="主图" hero-fallback="套装示意">
      <view slot="afterHero">
        <view class="thumb-strip">
          <view wx:for="{{outfit.itemImages}}" wx:key="*this" class="thumb {{index === 0 ? 'is-active' : ''}}">
            <image class="thumb-image" mode="aspectFill" src="{{item}}" />
            <view class="thumb-label">{{index === 0 ? '主图' : '单品'}}</view>
          </view>
          <view wx:if="{{outfit.itemImages.length === 0}}" class="thumb is-active"><view class="thumb-fallback"></view><view class="thumb-label">主图</view></view>
        </view>

        <view class="action-row">
          <button class="action-button edit">编辑</button>
          <button class="action-button ai" loading="{{adviceLoading}}" disabled="{{adviceLoading}}" bindtap="generateAdvice">AI 建议</button>
          <button class="action-button danger" bindtap="openDeleteSheet">删除</button>
        </view>
      </view>

      <view class="notice-card"><view class="check-dot">✓</view><view>套装已创建</view></view>

      <view wx:if="{{adviceLoading || adviceSummary}}" class="info-card">
        <view class="card-title">AI 套装建议</view>
        <view class="section-copy">{{adviceLoading ? '正在生成建议...' : adviceSummary}}</view>
        <view wx:for="{{adviceTips}}" wx:key="*this" class="section-copy">· {{item}}</view>
      </view>

      <view class="info-card">
        <view class="card-title">套装概况</view>
        <view class="info-row"><text>单品数量</text><text>{{outfit.itemCount}} 件</text></view>
        <view class="info-row"><text>收藏状态</text><text>{{outfit.favorite ? '已收藏' : '未收藏'}}</text></view>
        <view class="info-row"><text>季节</text><text>{{outfit.seasonText}}</text></view>
        <view class="info-row"><text>适合场景</text><text>{{outfit.sceneText}}</text></view>
      </view>

      <view class="info-card">
        <view class="card-title">适穿信息</view>
        <view class="temperature-row"><text>适穿温度</text><view class="temperature-bar"><view class="temperature-band"></view></view></view>
        <view class="info-row"><text>风格标签</text><text>{{outfit.sceneText}}</text></view>
        <view class="info-row"><text>穿着次数</text><text>0 次</text></view>
      </view>

      <view class="info-card">
        <view class="card-title">备注</view>
        <view class="section-copy">{{outfit.notes}}</view>
      </view>
    </detail-shell>
  </view>

  <ui-sheet open="{{deleteSheetOpen}}" title="删除这套穿搭？" description="删除后将从服务器套装列表移除，衣橱里的单品不会被删除。" bind:close="closeDeleteSheet">
    <view class="delete-actions">
      <button class="sheet-button sheet-button--danger" loading="{{deleting}}" disabled="{{deleting}}" bindtap="confirmDelete">确认删除</button>
      <button class="sheet-button sheet-button--secondary" disabled="{{deleting}}" bindtap="closeDeleteSheet">取消</button>
    </view>
  </ui-sheet>
</view>
