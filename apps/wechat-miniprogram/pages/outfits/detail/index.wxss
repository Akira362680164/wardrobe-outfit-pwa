.detail-page {
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 64rpx);
}

.more-button {
  width: 96rpx;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: var(--color-muted);
  background: rgba(255, 255, 252, 0.78);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 88rpx;
  letter-spacing: 4rpx;
}

.more-button::after,
.hero-worn-action::after,
.advice-inline-button::after {
  border: 0;
}

.hero-worn-action {
  max-width: 300rpx;
  min-width: 220rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  color: var(--color-ink);
  background: rgba(255, 255, 252, 0.92);
  box-shadow: 0 10rpx 26rpx rgba(29, 34, 40, 0.12);
  font-size: var(--font-caption);
  font-weight: 800;
  line-height: 72rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-card,
.notice-card,
.info-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.86);
  box-shadow: var(--shadow-card);
}

.status-title {
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
}

.status-copy,
.section-copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.6;
}

.thumb-strip {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.thumb {
  position: relative;
  width: 104rpx;
  height: 112rpx;
  overflow: hidden;
  border: 1rpx dashed rgba(29, 34, 40, 0.24);
  border-radius: var(--radius-thumb);
  background: rgba(255, 255, 252, 0.6);
}

.thumb.is-active {
  border: 3rpx solid var(--color-primary);
}

.thumb-fallback {
  height: 78rpx;
  background: var(--color-mist);
}

.thumb-image {
  width: 100%;
  height: 78rpx;
}

.thumb-label {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 5rpx 0;
  color: var(--color-surface);
  background: rgba(29, 34, 40, 0.54);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.add-thumb {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plus {
  color: var(--color-muted);
  font-size: 36rpx;
  line-height: 1;
}

.thumb-label.muted {
  position: static;
  margin-top: 8rpx;
  color: var(--color-muted);
  background: transparent;
}

.notice-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-left: 6rpx solid var(--color-success);
  color: var(--color-ink);
  font-size: var(--font-body);
}

.action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 28rpx;
}

.action-button {
  box-sizing: border-box;
  height: 82rpx;
  margin: 0;
  border-radius: var(--radius-control);
  font-size: var(--font-body);
  font-weight: 800;
  line-height: 82rpx;
}

.action-button::after,
.sheet-button::after {
  border: 0;
}

.edit {
  color: var(--color-surface);
  background: var(--color-primary);
}

.favorite {
  color: var(--color-surface);
  background: var(--color-success);
}

.worn {
  color: var(--color-ink);
  background: rgba(244, 245, 243, 0.88);
}

.ai {
  color: var(--color-surface);
  background: var(--color-ai);
}

.danger {
  border: 1rpx solid rgba(220, 38, 38, 0.35);
  color: var(--color-danger);
  background: rgba(255, 255, 252, 0.72);
}

.action-button[disabled] {
  opacity: 0.58;
}

.detail-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 30rpx;
  padding: 10rpx;
  border-radius: var(--radius-card-secondary);
  background: rgba(244, 245, 243, 0.78);
}

.detail-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 78rpx;
  border-radius: var(--radius-control);
  color: var(--color-muted);
  font-size: var(--font-caption);
  font-weight: 800;
  white-space: nowrap;
}

.detail-tab.is-active {
  color: var(--color-ink);
  background: rgba(255, 255, 252, 0.92);
  box-shadow: 0 12rpx 34rpx rgba(29, 34, 40, 0.08);
}

.ai-advice-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-advice-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(53, 92, 125, 0.16);
  border-radius: var(--radius-card-inner);
  background: linear-gradient(135deg, rgba(53, 92, 125, 0.1), rgba(255, 255, 252, 0.88));
  box-shadow: var(--shadow-card);
}

.advice-inline-button {
  flex: 0 0 auto;
  height: 66rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: var(--color-primary);
  background: rgba(53, 92, 125, 0.1);
  font-size: var(--font-caption);
  font-weight: 800;
  line-height: 66rpx;
  white-space: nowrap;
}

@media (max-width: 380px) {
  .detail-tab { font-size: 22rpx; }
  .hero-worn-action { min-width: 196rpx; padding: 0 18rpx; }
}

.check-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: var(--color-success);
  background: rgba(95, 112, 88, 0.12);
  font-weight: 800;
}

.card-title {
  margin-bottom: 22rpx;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
}

.composition-panel {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.86);
  box-shadow: var(--shadow-card);
}

.composition-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.composition-header .card-title { margin-bottom: 0; }

.composition-edit-link {
  box-sizing: border-box;
  min-width: 160rpx;
  height: 76rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid rgba(53, 92, 125, 0.28);
  border-radius: var(--radius-control);
  color: var(--color-primary);
  background: var(--color-surface);
  font-size: var(--font-caption);
  font-weight: 800;
  line-height: 76rpx;
}

.composition-edit-link::after { border: 0; }

.composition-list {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.composition-item {
  display: flex;
  min-width: 0;
  padding: 14rpx;
  align-items: center;
  gap: 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-secondary);
  background: rgba(255, 255, 252, 0.72);
}

.composition-item__image,
.composition-item__fallback {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-thumb);
  background: var(--color-mist);
}

.composition-item__fallback {
  color: var(--color-muted);
  font-size: var(--font-label);
  text-align: center;
}

.composition-item__copy { min-width: 0; }
.composition-item__name { overflow: hidden; color: var(--color-ink); font-size: var(--font-body); font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.composition-item__meta { margin-top: 6rpx; color: var(--color-muted); font-size: var(--font-caption); }

.info-row,
.temperature-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 10rpx 0;
  color: var(--color-ink);
  font-size: var(--font-body);
  line-height: 1.45;
}

.info-row > text:first-child,
.temperature-row > text:first-child {
  color: var(--color-muted);
}

.temperature-bar {
  display: flex;
  align-items: center;
  min-height: 40rpx;
}

.temperature-band {
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-success) 54%, var(--color-ai) 100%);
}

.delete-actions {
  display: grid;
  gap: 18rpx;
}

.sheet-button {
  width: 100%;
  height: 92rpx;
  margin: 0;
  border-radius: var(--radius-control);
  font-size: var(--font-body);
  font-weight: 800;
  line-height: 92rpx;
}

.sheet-button--danger {
  color: var(--color-surface);
  background: var(--color-danger);
}

.sheet-button--secondary {
  color: var(--color-ink);
  background: rgba(244, 245, 243, 0.88);
}
