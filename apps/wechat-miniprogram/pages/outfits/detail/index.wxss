.page-shell { padding: 48rpx 28rpx 160rpx; }
.status-card, .detail-card { box-sizing: border-box; margin-top: 28rpx; padding: 32rpx; border: 1rpx solid var(--color-line); border-radius: var(--radius-card-inner); background: rgba(255,255,252,0.8); box-shadow: var(--shadow-card); }
.status-title, .section-title { color: var(--color-ink); font-size: var(--font-section); font-weight: 700; }
.status-copy, .section-copy { margin-top: 12rpx; color: var(--color-muted); font-size: var(--font-body); line-height: 1.55; }
.metric-row { display: flex; gap: 16rpx; margin-top: 28rpx; }
.metric { flex: 1; min-width: 0; padding: 22rpx; border-radius: 28rpx; background: rgba(29,34,40,0.05); }
.metric-value { color: var(--color-ink); font-size: 40rpx; font-weight: 800; }
.metric-label { margin-top: 8rpx; color: var(--color-muted); font-size: var(--font-caption); }
.section-title { margin-top: 30rpx; }
