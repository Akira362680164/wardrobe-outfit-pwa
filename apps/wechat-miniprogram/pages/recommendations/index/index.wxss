.recommend-page{padding:0 28rpx 100rpx}.form,.result,.summary{margin-top:20rpx;padding:24rpx;border-radius:24rpx;background:white;box-shadow:var(--shadow-card)}.form{display:grid;gap:14rpx}.form input,.picker{box-sizing:border-box;height:76rpx;padding:0 18rpx;border:1rpx solid rgba(29,34,40,.12);border-radius:16rpx}.picker{line-height:76rpx}.row{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.form button{color:white;background:var(--color-primary)}.title{font-size:30rpx;font-weight:800}.copy,.warning{margin-top:10rpx;color:var(--color-muted);font-size:23rpx;line-height:1.55}.thumbs{display:flex;gap:12rpx;margin-top:14rpx}.thumbs>view{width:128rpx}.thumbs image{width:128rpx;height:160rpx;border-radius:14rpx;background:var(--color-mist)}.thumbs text{display:block;overflow:hidden;font-size:20rpx;text-overflow:ellipsis;white-space:nowrap}.warning{color:var(--color-danger)}
