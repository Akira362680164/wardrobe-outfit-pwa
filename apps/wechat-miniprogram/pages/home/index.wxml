<view class="home-page" style="{{fontStyle}}">
  <view class="home-header">
    <view class="home-greeting">{{greeting}}</view>
    <view class="home-date">{{businessDateLabel}}</view>
  </view>

  <view wx:if="{{loading}}" class="home-skeleton" aria-label="正在读取首页">
    <view class="skeleton-line skeleton-line--wide"/><view class="skeleton-weather"/><view class="skeleton-line"/>
  </view>
  <view wx:elif="{{error}}" class="module-state module-state--error">
    <view class="module-title">首页暂时无法读取</view><view class="module-copy">{{error}}</view>
    <button class="inline-action" bindtap="retryHome">重试</button>
  </view>

  <block wx:else>
    <view class="weather-shell">
      <view class="location-entry" role="button" hover-class="pressable" bindtap="openLocationSheet" aria-label="当前地点 {{locationLabel}}，打开地点设置">
        <ui-icon name="map-pin" size="34" tone="primary" />
        <text class="location-entry__label">{{locationLabel}}</text>
        <ui-icon name="chevron-right" size="30" tone="muted" />
      </view>
      <view class="weather-grid">
        <view class="weather-card weather-card--today {{canvasStaticFallback ? 'is-static' : ''}}" role="button" data-date="today" bindtap="selectWeatherDate" aria-label="今天天气，切换到今日推荐">
          <canvas id="home-weather-canvas" class="weather-canvas-host weather-canvas {{canvasVisible ? 'is-visible' : 'is-hidden'}}" type="2d" />
          <view class="weather-copy-overlay weather-copy-overlay--today">
            <view class="weather-copy-overlay__row"><view class="weather-copy-overlay__left"><view>{{todayWeather.label}}</view><view wx:if="{{todayWeather.stale}}" class="stale-badge">较早</view></view><view class="weather-copy-overlay__right"><view class="weather-high-full">{{todayWeather.high}}</view><view class="weather-high-compact">{{todayWeather.highCompact}}</view></view></view>
            <view class="weather-copy-overlay__temperature">{{todayWeather.temperature}}</view>
            <view class="weather-copy-overlay__summary">{{todayWeather.summary}}</view>
            <view class="weather-copy-overlay__meta">{{todayWeather.meta}}</view>
          </view>
        </view>
        <button class="weather-card weather-card--tomorrow" data-date="tomorrow" bindtap="selectWeatherDate" aria-label="明天天气，切换到明日推荐">
          <view class="weather-row"><view>{{tomorrowWeather.label}}</view><view wx:if="{{tomorrowWeather.stale}}" class="stale-badge">较早天气</view></view>
          <view class="weather-temperature weather-temperature--small">{{tomorrowWeather.temperature}}</view>
          <view class="weather-summary">{{tomorrowWeather.summary}}</view>
          <view class="weather-meta">{{tomorrowWeather.meta}}</view>
        </button>
      </view>
      <view wx:if="{{weatherAttribution}}" class="weather-attribution">{{weatherAttribution}}</view>
    </view>

    <view class="section-switch" role="tablist">
      <button class="section-switch__item {{activeSection === 'recommendation' ? 'is-active' : ''}}" data-section="recommendation" bindtap="setSection" aria-selected="{{activeSection === 'recommendation'}}">推荐</button>
      <button class="section-switch__item {{activeSection === 'wardrobe' ? 'is-active' : ''}}" data-section="wardrobe" bindtap="setSection" aria-selected="{{activeSection === 'wardrobe'}}">衣橱</button>
    </view>

    <view wx:if="{{activeSection === 'recommendation'}}" class="recommendation-section">
      <view wx:if="{{plan}}" class="plan-card {{plan.risk ? 'plan-card--risk' : ''}}">
        <view class="section-heading"><view class="section-title">{{plan.title}}</view></view>
        <view class="plan-images"><view wx:for="{{plan.garments}}" wx:key="id" class="plan-image"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="image-fallback">{{item.name}}</view></view></view>
        <view wx:if="{{plan.risk}}" class="plan-risk">{{plan.risk}}</view>
        <view wx:if="{{planActionHint}}" class="action-message">{{planActionHint}}</view>
        <view class="plan-actions">
          <button wx:if="{{plan.status === 'worn'}}" disabled="{{actionBusy}}" bindtap="undoCurrentPlanWorn">撤销已穿</button>
          <block wx:else>
            <button disabled="{{actionBusy}}" bindtap="beginChangePlan">更换穿搭</button>
            <button disabled="{{actionBusy}}" bindtap="openCancelPlanSheet">取消安排</button>
            <button class="is-primary" disabled="{{actionBusy || plan.availability === 'blocked'}}" bindtap="markCurrentPlanWorn">确认今天穿了这套</button>
          </block>
        </view>
      </view>

      <view wx:if="{{!plan}}" class="recommendation-toolbar">
        <view class="recommendation-heading"><view class="section-title">{{recommendationHeading}}</view><view class="section-subtitle">{{recommendationSubtitle}}</view></view>
        <scroll-view class="date-strip" scroll-x enable-flex aria-label="选择推荐日期">
          <view class="date-strip__row">
            <button wx:for="{{dateItems}}" wx:key="date" class="date-chip {{selectedDate === item.date ? 'is-active' : ''}}" data-date="{{item.date}}" bindtap="selectDate" aria-pressed="{{selectedDate === item.date}}">
              <text class="date-chip__relative">{{item.relativeLabel}}</text><text class="date-chip__date">{{item.shortDate}}</text>
            </button>
          </view>
        </scroll-view>
      </view>
      <scroll-view wx:else class="date-strip date-strip--after-plan" scroll-x enable-flex aria-label="选择推荐日期">
        <view class="date-strip__row">
          <button wx:for="{{dateItems}}" wx:key="date" class="date-chip {{selectedDate === item.date ? 'is-active' : ''}}" data-date="{{item.date}}" bindtap="selectDate" aria-pressed="{{selectedDate === item.date}}">
            <text class="date-chip__relative">{{item.relativeLabel}}</text><text class="date-chip__date">{{item.shortDate}}</text>
          </button>
        </view>
      </scroll-view>

      <view wx:if="{{recommendationLoading}}" class="module-state"><view class="module-title">正在整理穿搭建议</view><view class="module-copy">正在结合天气、已有安排和衣橱，请稍候。</view></view>
      <view wx:elif="{{recommendationError}}" class="module-state module-state--error"><view class="module-title">推荐暂时无法读取</view><view class="module-copy">{{recommendationError}}</view><button class="inline-action" bindtap="retrySelectedDate">重试</button></view>
      <view wx:elif="{{!plan && recommendationCards.length === 0}}" class="module-state"><view class="module-title">{{wardrobeEmpty ? '衣橱还是空的' : '暂时没有合适的建议'}}</view><view class="module-copy">{{wardrobeEmpty ? '先添加上装、下装和鞋履；未设置城市也可以生成通用建议。' : '目前没有合适的可用组合，你仍可正常浏览衣橱。'}}</view><button wx:if="{{wardrobeEmpty}}" class="inline-action" bindtap="openIntake">添加衣物</button></view>

      <scroll-view wx:if="{{recommendationCards.length}}" class="recommendation-scroll" scroll-x enable-flex enhanced show-scrollbar="false">
        <view class="recommendation-row">
          <view wx:for="{{recommendationCards}}" wx:key="candidateId" class="recommendation-card {{item.blocked ? 'recommendation-card--blocked' : ''}}">
            <view class="recommendation-card__top"><text class="recommendation-objective">{{item.objective}}</text><text class="recommendation-mode">{{recommendationSourceSummary}}</text></view>
            <view class="recommendation-images"><view wx:for="{{item.garments}}" wx:for-item="garment" wx:key="id" class="recommendation-image" data-id="{{garment.id}}" bindtap="openGarment"><image wx:if="{{garment.imageUrl}}" src="{{garment.imageUrl}}" mode="aspectFill"/><view wx:else class="image-fallback">{{garment.name}}</view><text>{{garment.name}}</text></view></view>
            <view class="recommendation-title">{{item.title}}</view><view class="recommendation-reason">{{item.reason}}</view><view class="recommendation-risk">{{item.risk}}</view>
            <view class="recommendation-actions">
              <button class="recommendation-action" data-candidate="{{item.candidateId}}" disabled="{{actionBusy || item.blocked}}" bindtap="applyRecommendation">{{actionBusy ? '提交中…' : recommendationActionLabel}}</button>
              <button class="recommendation-detail-action" data-candidate="{{item.candidateId}}" disabled="{{actionBusy}}" bindtap="openRecommendationSheet" aria-label="查看推荐详情"><ui-icon name="chevron-right" size="34" tone="primary" /></button>
            </view>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{travelDates.length}}" class="travel-recommendations">
        <view class="section-heading"><view><view class="section-title">出行推荐</view><view class="section-subtitle">远期行程单列，点击后按需读取</view></view></view>
        <button wx:for="{{travelDates}}" wx:key="date" class="travel-row" data-date="{{item.date}}" bindtap="selectTravelDate"><view><view class="travel-row__title">{{item.destination}} · {{item.title}}</view><view class="travel-row__date">{{item.dateLabel}}</view></view><ui-icon name="chevron-right" size="30" tone="muted"/></button>
      </view>
    </view>

    <view wx:else class="wardrobe-section">
      <view class="section-heading"><view><view class="section-title">我的衣橱</view><view class="section-subtitle">{{garments.length}} 件衣物</view></view><button class="text-action" bindtap="openIntake">添加衣物</button></view>
      <view wx:if="{{wardrobeEmpty}}" class="module-state"><view class="module-title">衣橱还是空的</view><view class="module-copy">添加第一件衣物后，首页会使用真实图片生成建议。</view><button class="inline-action" bindtap="openIntake">添加衣物</button></view>
      <view wx:else class="home-wardrobe-grid"><catalog-card wx:for="{{garments}}" wx:key="id" item-id="{{item.id}}" image-url="{{item.imageUrl}}" fallback="{{item.categoryLabel}}" title="{{item.name}}" category-label="{{item.categoryLabel}}" colors="{{item.cardColors}}" summary="{{item.wearSummary}}" tone="primary" bind:select="openGarment" /></view>
    </view>
  </block>

  <create-sheet open="{{createSheetOpen}}" active="add_single_item" bind:close="closeCreateSheet" />

  <ui-sheet open="{{recommendationSheetOpen}}" title="{{selectedRecommendation ? selectedRecommendation.title : '穿搭详情'}}" description="确认后才会更新安排。提交期间会保留当前选择。" close-on-mask="{{!actionBusy}}" bind:close="closeRecommendationSheet">
    <view wx:if="{{selectedRecommendation}}" class="action-sheet-body action-sheet-body--recommendation">
      <view class="action-outfit-images"><view wx:for="{{selectedRecommendation.garments}}" wx:key="id" class="plan-image"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="image-fallback">{{item.name}}</view></view></view>
      <view class="action-field"><view class="action-label">替换哪一件</view><picker disabled="{{actionBusy}}" range="{{replacementSourceLabels}}" value="{{replacementSourceIndex}}" bindchange="selectReplacementSource"><view class="action-picker"><text>{{replacementSourceLabels[replacementSourceIndex]}}</text><ui-icon name="chevron-down" size="28" tone="muted" /></view></picker></view>
      <view class="action-field"><view class="action-label">换成</view><picker disabled="{{actionBusy}}" range="{{replacementChoices}}" range-key="label" value="{{replacementChoiceIndex}}" bindchange="selectReplacementChoice"><view class="action-picker"><text>{{replacementChoices[replacementChoiceIndex].label}}</text><ui-icon name="chevron-down" size="28" tone="muted" /></view></picker></view>
      <view wx:if="{{actionMessage}}" class="action-message">{{actionMessage}}</view>
      <button class="sheet-primary-action" loading="{{actionBusy}}" disabled="{{actionBusy || selectedRecommendation.blocked}}" bindtap="applySelectedRecommendation">{{selectedDate === today ? '设为今日穿搭' : selectedDate === tomorrow ? '设为明日穿搭' : '安排到所选日期'}}</button>
      <view class="sheet-secondary-actions"><button disabled="{{actionBusy}}" bindtap="rejectSelectedRecommendation">不喜欢</button><button disabled="{{actionBusy}}" bindtap="saveSelectedOutfit">保存为套装</button></view>
    </view>
  </ui-sheet>

  <ui-sheet open="{{postAcceptSheetOpen}}" title="已安排" description="这次安排已经确认。你也可以把它保存到套装，方便以后直接使用。" close-on-mask="{{!actionBusy}}" bind:close="closePostAcceptSheet">
    <view class="action-sheet-body action-sheet-body--postaccept"><view wx:if="{{actionMessage}}" class="action-message">{{actionMessage}}</view><button class="sheet-primary-action" loading="{{actionBusy}}" disabled="{{actionBusy}}" bindtap="saveSelectedOutfit">保存为套装</button><button class="sheet-quiet-action" disabled="{{actionBusy}}" bindtap="closePostAcceptSheet">仅本次使用</button></view>
  </ui-sheet>

  <ui-sheet open="{{cancelSheetOpen}}" title="取消安排" description="可以只取消，也可以恢复一套备选穿搭。确认后才会更新。" close-on-mask="{{!actionBusy}}" bind:close="closeCancelPlanSheet">
    <view class="action-sheet-body action-sheet-body--cancel">
      <button class="backup-choice {{cancelBackupId === '' ? 'is-selected' : ''}}" data-id="" bindtap="chooseCancelBackup">只取消当前安排</button>
      <button wx:for="{{planBackups}}" wx:key="id" class="backup-choice {{cancelBackupId === item.id ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="chooseCancelBackup">恢复备选：{{item.garments[0].name}}</button>
      <view wx:if="{{actionMessage}}" class="action-message">{{actionMessage}}</view>
      <button class="sheet-primary-action" loading="{{actionBusy}}" disabled="{{actionBusy}}" bindtap="cancelCurrentPlan">确认取消</button>
    </view>
  </ui-sheet>

  <ui-sheet open="{{locationSheetOpen}}" title="地点与天气" description="仅在你主动选择后获取一次粗略位置，用来解析城市；坐标仅用于本次解析，不会保存。" close-on-mask="{{!locationBusy}}" bind:close="closeLocationSheet">
    <view class="location-sheet-body">
      <button class="current-location-action" loading="{{locationBusy}}" disabled="{{locationBusy}}" bindtap="useCurrentLocation"><ui-icon name="map-pin" size="34" tone="surface"/><text>使用当前位置</text></button>
      <view class="privacy-note">首页不会自动弹出位置权限。拒绝或永久拒绝后，手工城市搜索始终可用，也不阻塞无城市推荐。</view>
      <button wx:if="{{locationNeedsSettings}}" class="settings-action" bindtap="openLocationSettings">前往微信设置</button>
      <view class="city-search"><input value="{{cityQuery}}" placeholder="至少输入 2 个字搜索城市" bindinput="inputCityQuery" confirm-type="search" bindconfirm="searchCity"/><button loading="{{citySearching}}" disabled="{{citySearching}}" bindtap="searchCity">搜索</button></view>
      <view wx:if="{{locationMessage}}" class="location-message">{{locationMessage}}</view>
      <view class="city-candidates"><view wx:for="{{cityCandidates}}" wx:key="locationId" class="city-candidate"><view class="city-candidate__name">{{item.displayName}}</view><view class="city-candidate__actions"><button data-id="{{item.locationId}}" data-kind="temporary" disabled="{{locationBusy}}" bindtap="chooseCity">临时至明日</button><button class="is-primary" data-id="{{item.locationId}}" data-kind="home" disabled="{{locationBusy}}" bindtap="chooseCity">设为常驻</button></view></view></view>
      <button wx:if="{{locationSnapshot && locationSnapshot.override && locationSnapshot.override.override}}" class="clear-temporary" disabled="{{locationBusy}}" bindtap="clearTemporary">恢复常驻城市</button>
    </view>
  </ui-sheet>
</view>
