.page-shell { padding: 48rpx 28rpx 160rpx; }

.hero { margin-bottom: 32rpx; }

.eyebrow {
  margin-bottom: 12rpx;
  color: var(--color-primary);
  font-size: var(--font-label);
  font-weight: 700;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.metric-card,
.status-card {
  box-sizing: border-box;
  border: 1rpx solid var(--color-line);
  background: rgba(255, 255, 252, 0.78);
  box-shadow: var(--shadow-card);
}

.metric-card {
  min-width: 0;
  padding: 28rpx 18rpx;
  border-radius: 32rpx;
}

.metric-value {
  overflow-wrap: anywhere;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.05;
}

.metric-label {
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
}

.status-card {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: var(--radius-card-inner);
  color: var(--color-muted);
  font-size: var(--font-body);
}

.status-title {
  margin-bottom: 12rpx;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 700;
}

.status-copy {
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.55;
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.primary-action,
.secondary-action,
.mini-button {
  box-sizing: border-box;
  min-width: 0;
  height: 88rpx;
  border: 0;
  border-radius: var(--radius-pill);
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 88rpx;
}

.primary-action {
  flex: 1;
  background: var(--color-ink);
  color: #fff;
}

.secondary-action {
  flex: 1;
  background: rgba(29, 34, 40, 0.08);
  color: var(--color-ink);
}

.mini-button {
  width: 220rpx;
  margin: 28rpx 0 0;
  background: var(--color-ink);
  color: #fff;
}
