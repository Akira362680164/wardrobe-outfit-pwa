<view class="password-page page-shell">
  <view class="password-card glass-panel">
    <view class="login-kicker">账号密码登录</view>
    <view class="login-title text-wrap-safe">使用 App 账号继续登录</view>
    <view class="login-copy text-wrap-safe">输入你在衣橱 App 使用的手机号和密码，登录后继续同步衣橱与穿搭数据。</view>

    <view class="form-area">
      <view class="field-label">手机号</view>
      <input
        class="login-input"
        value="{{phone}}"
        type="number"
        placeholder="输入 App 账号手机号"
        bindinput="handlePhoneInput"
      />
      <view class="field-label">密码</view>
      <input
        class="login-input"
        value="{{password}}"
        password
        placeholder="输入密码"
        bindinput="handlePasswordInput"
      />
      <view wx:if="{{errorMessage}}" class="login-error text-wrap-safe">{{errorMessage}}</view>
      <button class="primary-button form-button" disabled="{{submitting || !phone || !password}}" bindtap="loginByPassword">
        登录
      </button>
    </view>

    <button class="secondary-button form-button back-button" hover-class="form-button--hover" bindtap="goBack">返回微信认证登录</button>

    <view class="agreement-tip text-wrap-safe">
      登录代表您已阅读并认可
      <text class="agreement-link" bindtap="openAgreement">《用户服务协议》</text>
      和
      <text class="agreement-link" bindtap="openPrivacy">《隐私政策》</text>。
    </view>
  </view>
</view>
