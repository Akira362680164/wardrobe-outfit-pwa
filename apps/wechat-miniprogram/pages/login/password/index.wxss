.password-page {
  display: flex;
  min-height: 100vh;
  align-items: center;
  padding-bottom: calc(env(safe-area-inset-bottom) + 80rpx);
}

.password-card {
  box-sizing: border-box;
  width: 100%;
  padding: 52rpx 36rpx 38rpx;
  border-radius: var(--radius-card);
}

.login-kicker {
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 700;
  letter-spacing: 0;
}

.login-title {
  margin-top: 16rpx;
  color: var(--color-ink);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.18;
}

.login-copy {
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.6;
}

.form-area {
  width: 100%;
  margin-top: 38rpx;
}

.field-label {
  margin: 20rpx 0 10rpx;
  color: var(--color-ink);
  font-size: var(--font-caption);
  font-weight: 700;
  line-height: 1.35;
}

.login-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-control);
  background: var(--color-surface);
  color: var(--color-ink);
  font-size: var(--font-body);
}

.login-error {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-control);
  border: 1rpx solid var(--color-danger);
  color: var(--color-danger);
  font-size: var(--font-caption);
  line-height: 1.45;
}

.form-button {
  display: block;
  width: 100% !important;
  min-width: 100%;
  margin: 24rpx 0 0;
  letter-spacing: 0;
  text-align: center;
  white-space: nowrap;
}

.form-button::after {
  border: 0;
}

.form-button[disabled] {
  opacity: 0.62;
}

.back-button {
  margin: 18rpx 0 0;
  font-size: var(--font-caption);
}

.form-button--hover {
  opacity: 0.88;
}

.agreement-tip {
  margin-top: 26rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.65;
}

.agreement-link {
  color: var(--color-primary);
  font-weight: 700;
}
