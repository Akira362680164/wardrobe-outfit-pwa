.login-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 128rpx) 32rpx calc(env(safe-area-inset-bottom) + 80rpx);
  background: #fbfbf8;
}

.login-hero {
  box-sizing: border-box;
  width: 100%;
  max-width: 686rpx;
  margin: 0 auto;
}

.login-title {
  color: #1f2933;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.login-copy {
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 28rpx;
  line-height: 42rpx;
}

.login-actions {
  width: 100%;
  margin-top: 72rpx;
}

.login-action {
  display: block;
  width: 100% !important;
  min-width: 100%;
  height: 96rpx;
  margin: 0;
  border-radius: 28rpx;
  letter-spacing: 0;
  text-align: center;
  white-space: nowrap;
}

.login-action::after,
.login-tertiary::after {
  border: 0;
}

.login-action--hover {
  opacity: 0.88;
}

.login-action[disabled] {
  opacity: 0.62;
}

.login-secondary {
  margin: 24rpx 0 0;
  border: 1rpx solid rgba(31, 41, 51, 0.10);
  background: #ffffff;
  color: #1f2933;
}

.login-tertiary {
  display: block;
  width: 100% !important;
  height: 88rpx;
  margin: 24rpx 0 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #2f6b4f;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.login-error {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fef3f2;
  color: #b42318;
  font-size: 24rpx;
  line-height: 36rpx;
}

.login-tip {
  margin-top: 34rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 36rpx;
}

.agreement-tip {
  margin-top: 20rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 34rpx;
}

.agreement-link {
  color: #2f6b4f;
  font-weight: 700;
}
