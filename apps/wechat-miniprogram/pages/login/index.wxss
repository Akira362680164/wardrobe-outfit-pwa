.login-page {
  display: flex;
  min-height: 100vh;
  align-items: center;
  padding-bottom: calc(env(safe-area-inset-bottom) + 80rpx);
}

.login-hero {
  box-sizing: border-box;
  width: 100%;
  padding: 56rpx 36rpx 40rpx;
  border-radius: var(--radius-card);
}

.login-kicker {
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 700;
  letter-spacing: 0;
}

.login-title {
  margin-top: 16rpx;
  color: var(--color-ink);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.15;
}

.login-copy {
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.6;
}

.login-actions {
  width: 100%;
  margin-top: 48rpx;
}

.login-action {
  display: block;
  width: 100% !important;
  min-width: 100%;
  margin: 0;
  letter-spacing: 0;
  text-align: center;
  white-space: nowrap;
}

.login-action::after {
  border: 0;
}

.login-action--hover {
  opacity: 0.88;
}

.login-action[disabled] {
  opacity: 0.62;
}

.login-error {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-control);
  border: 1rpx solid var(--color-danger);
  color: var(--color-danger);
  font-size: var(--font-caption);
  line-height: 1.45;
}

.login-secondary {
  margin: 18rpx 0 0;
}

.agreement-tip {
  margin-top: 28rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.65;
}

.agreement-link {
  color: var(--color-primary);
  font-weight: 700;
}
