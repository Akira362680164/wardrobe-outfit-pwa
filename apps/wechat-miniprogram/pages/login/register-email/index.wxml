<view class="auth-page">
  <button class="back-button" bindtap="goBack">‹</button>
  <view class="auth-card">
    <view class="auth-title text-wrap-safe">{{ticket ? '注册新账号' : '创建 Wardora 账号'}}</view>
    <view class="auth-copy text-wrap-safe">邮箱用于登录、找回密码和账号安全验证。</view>

    <view class="field-label">邮箱</view>
    <view class="email-row">
      <input class="email-input" value="{{email}}" placeholder="输入邮箱" bindinput="handleEmailInput" />
      <button class="send-code-button" disabled="{{sending || countdown > 0}}" bindtap="sendCode">
        {{countdown > 0 ? countdown + 's' : (codeSent ? '再次发送' : '发送验证码')}}
      </button>
    </view>

    <block wx:if="{{codeSent}}">
      <view class="field-label code-label">邮箱验证码</view>
      <input class="auth-input" value="{{emailCode}}" type="number" maxlength="6" placeholder="输入 6 位验证码" bindinput="handleCodeInput" />
    </block>

    <view class="field-label">密码</view>
    <input class="auth-input" value="{{password}}" password placeholder="至少 8 位" bindinput="handlePasswordInput" />

    <view class="field-label">确认密码</view>
    <input class="auth-input" value="{{confirmPassword}}" password placeholder="再次输入密码" bindinput="handleConfirmInput" />

    <view class="field-label">手机号（选填）</view>
    <input class="auth-input" value="{{phone}}" type="number" placeholder="仅作为手机号+密码登录名" bindinput="handlePhoneInput" />
    <view class="phone-hint">手机号暂不验证，仅作为手机号+密码登录名使用。</view>

    <view wx:if="{{errorMessage}}" class="auth-error text-wrap-safe">{{errorMessage}}</view>

    <button class="primary-button submit-button" disabled="{{submitting || !email || !password || !confirmPassword}}" bindtap="submit">注册并登录</button>
  </view>
</view>
