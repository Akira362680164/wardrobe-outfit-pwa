.auth-page {
  box-sizing: border-box;
  display: flex;
  position: relative;
  flex-direction: column;
  justify-content: center;
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 64rpx) 32rpx calc(env(safe-area-inset-bottom) + 64rpx);
  background: #fbfbf8;
}

.back-button {
  display: grid;
  place-items: center;
  position: absolute;
  top: calc(env(safe-area-inset-top) + 16rpx);
  left: 32rpx;
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 36rpx;
  background: #ffffff;
  color: #1f2933;
  font-size: 48rpx;
  line-height: 1;
}

.back-button::after,
.send-code-button::after,
.submit-button::after {
  border: 0;
}

.auth-card {
  width: 100%;
  max-width: 686rpx;
  margin: 0 auto;
}

.auth-title {
  color: #1f2933;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.auth-copy {
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 40rpx;
}

.field-label {
  margin: 28rpx 0 12rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.code-label {
  margin-top: 20rpx;
}

.email-row {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 100%;
  height: 88rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.10);
  border-radius: 24rpx;
  background: #f7f7f3;
}

.email-input {
  box-sizing: border-box;
  min-width: 0;
  flex: 1;
  height: 86rpx;
  padding: 0 16rpx 0 28rpx;
  color: #1f2933;
  font-size: 28rpx;
}

.send-code-button {
  min-width: 168rpx;
  height: 68rpx;
  margin: 0 10rpx 0 0;
  padding: 0 20rpx;
  border-radius: 20rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
  white-space: nowrap;
}

.send-code-button[disabled] {
  background: #e5e7eb;
  color: #6b7280;
}

.send-code-button--consent-pending {
  background: #d1d5db;
  color: #6b7280;
}

.auth-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.10);
  border-radius: 24rpx;
  background: #f7f7f3;
  color: #1f2933;
  font-size: 28rpx;
}

.phone-hint {
  margin-top: 10rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 34rpx;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
  margin-top: 26rpx;
}

.agreement-checkbox-group {
  flex: 0 0 auto;
}

.agreement-checkbox-hit {
  display: flex;
  min-width: 56rpx;
  min-height: 56rpx;
  align-items: flex-start;
  justify-content: flex-start;
}
.agreement-checkbox-hit checkbox { transform: scale(.72); transform-origin: top left; }

.agreement-tip {
  min-width: 0;
  padding-top: 4rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 34rpx;
}

.agreement-link {
  color: var(--color-primary);
  font-weight: 700;
}

.auth-error {
  margin-top: 24rpx;
  padding: 20rpx;
  border: 0;
  border-radius: 20rpx;
  background: #fef3f2;
  color: #b42318;
  font-size: 24rpx;
  line-height: 36rpx;
}

.submit-button {
  display: block;
  width: 100% !important;
  height: 96rpx;
  margin: 48rpx 0 0;
  border-radius: 28rpx;
  background: var(--color-primary);
  color: #ffffff;
}

.submit-button[disabled] {
  background: #e5e7eb;
  color: #6b7280;
}

.submit-button--consent-pending {
  background: #d1d5db;
  color: #6b7280;
}
