.connect-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 8rpx) 32rpx calc(env(safe-area-inset-bottom) + 64rpx);
  background: #fbfbf8;
}

.back-button {
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 36rpx;
  background: #ffffff;
  color: #1f2933;
  font-size: 48rpx;
  line-height: 72rpx;
}

.back-button::after {
  border: 0;
}

.connect-content {
  width: 100%;
  max-width: 686rpx;
  margin: 48rpx auto 0;
}

.connect-title {
  color: #1f2933;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.connect-copy {
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 28rpx;
  line-height: 42rpx;
}

.choice-card {
  box-sizing: border-box;
  display: grid;
  gap: 24rpx;
  min-height: 168rpx;
  margin-top: 32rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.08);
  border-radius: 32rpx;
  background: #ffffff;
}

.choice-title {
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.choice-copy {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 36rpx;
}

.choice-action {
  color: #2f6b4f;
  font-size: 26rpx;
  font-weight: 700;
}
