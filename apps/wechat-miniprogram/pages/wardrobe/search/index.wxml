<view class="page-shell search-page"><view class="search-bar"><input value="{{query}}" placeholder="搜索名称、分类、颜色、风格" confirm-type="search" bindinput="updateQuery" /></view><view wx:if="{{history.length && !query}}" class="history"><view class="section-head"><text>最近搜索</text><text bindtap="clearHistory">清空</text></view><view class="chip-row"><view wx:for="{{history}}" wx:key="*this" data-value="{{item}}" bindtap="useHistory" class="chip">{{item}}</view></view></view><scroll-view scroll-x class="filters"><view class="chip-row"><view data-field="scope" data-value="all" bindtap="chooseFilter" class="chip {{scope === 'all' ? 'active' : ''}}">全部位置</view><view wx:for="{{locations}}" wx:key="id" data-field="scope" data-value="{{item.id}}" bindtap="chooseFilter" class="chip {{scope === item.id ? 'active' : ''}}">{{item.name}}</view></view><view class="chip-row"><view data-field="category" data-value="all" bindtap="chooseFilter" class="chip {{category === 'all' ? 'active' : ''}}">全部分类</view><view wx:for="{{categories}}" wx:key="value" data-field="category" data-value="{{item.value}}" bindtap="chooseFilter" class="chip {{category === item.value ? 'active' : ''}}">{{item.label}}</view></view></scroll-view><view wx:if="{{loading}}" class="status-card">正在搜索...</view><view wx:elif="{{error}}" class="status-card">{{error}}<button bindtap="load">重试</button></view><view wx:elif="{{!results.length}}" class="status-card">没有匹配的衣物</view><view wx:else class="grid"><catalog-card wx:for="{{results}}" wx:key="id" item-id="{{item.id}}" image-url="{{item.imageUrl}}" fallback="{{item.categoryLabel}}" title="{{item.name}}" category-label="{{item.categoryLabel}}" colors="{{item.cardColors}}" summary="{{item.wearSummary}}" bind:select="openDetail" /></view></view>
