.search-page{padding:0 28rpx 80rpx}.search-bar{display:flex;gap:12rpx;padding:12rpx 14rpx 12rpx 24rpx;border-radius:24rpx;background:white;box-shadow:var(--shadow-card)}.search-bar input{height:64rpx;flex:1}.search-bar button{height:64rpx;margin:0;padding:0 24rpx;border-radius:16rpx;color:white;background:var(--color-primary);font-size:24rpx;line-height:64rpx}.scope-copy{margin-top:14rpx;color:var(--color-muted);font-size:22rpx}.history,.filters{margin-top:22rpx}.section-head{display:flex;justify-content:space-between;color:var(--color-muted);font-size:24rpx}.chip-row{display:flex;gap:12rpx;margin-top:14rpx;white-space:nowrap}.chip{padding:12rpx 20rpx;border-radius:999rpx;background:var(--color-mist);font-size:23rpx}.chip.active{color:white;background:var(--color-primary)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;margin-top:24rpx}.status-card{margin-top:24rpx}
