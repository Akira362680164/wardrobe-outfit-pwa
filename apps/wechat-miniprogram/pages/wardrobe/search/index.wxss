.search-page{padding:32rpx 28rpx 80rpx}.search-bar{padding:18rpx 24rpx;border-radius:24rpx;background:white;box-shadow:var(--shadow-card)}.search-bar input{height:56rpx}.history,.filters{margin-top:22rpx}.section-head{display:flex;justify-content:space-between;color:var(--color-muted);font-size:24rpx}.chip-row{display:flex;gap:12rpx;margin-top:14rpx;white-space:nowrap}.chip{padding:12rpx 20rpx;border-radius:999rpx;background:var(--color-mist);font-size:23rpx}.chip.active{color:white;background:var(--color-primary)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;margin-top:24rpx}.status-card{margin-top:24rpx}
