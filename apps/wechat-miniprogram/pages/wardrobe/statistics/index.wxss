.stats-page{padding:28rpx 26rpx 80rpx}.month-copy{color:var(--color-muted);font-size:23rpx}.card{margin-top:20rpx;padding:26rpx;border-radius:24rpx;background:white;box-shadow:var(--shadow-card)}.title{font-size:30rpx;font-weight:800}.overview{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:18rpx}.metric{display:flex;min-width:0;flex-direction:column;padding:18rpx 12rpx;border:1rpx solid rgba(29,34,40,.08);border-radius:16rpx}.metric text:first-child{font-size:40rpx;font-weight:900}.metric text:nth-child(2){margin-top:6rpx;font-size:20rpx}.metric text:last-child{color:var(--color-muted);font-size:18rpx}
