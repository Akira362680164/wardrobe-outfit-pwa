.stats-page{padding:32rpx 28rpx 80rpx}.overview{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx}.metric,.card{padding:26rpx;border-radius:24rpx;background:white;box-shadow:var(--shadow-card)}.metric{display:flex;flex-direction:column;gap:8rpx}.metric text:first-child,.rate{color:var(--color-primary);font-size:52rpx;font-weight:900}.metric text:last-child,.copy{color:var(--color-muted);font-size:24rpx}.card{margin-top:20rpx}.title{font-size:30rpx;font-weight:800}.category{margin-top:18rpx}.category>view:first-child{display:flex;justify-content:space-between;font-size:24rpx}.bar{height:12rpx;margin-top:8rpx;border-radius:999rpx;background:var(--color-mist)}.bar view{height:100%;border-radius:inherit;background:var(--color-primary)}
