<view class="page-shell stats-page"><view wx:if="{{loading}}" class="status-card">正在统计...</view><view wx:elif="{{error}}" class="status-card"><view>读取失败：{{error}}</view><button bindtap="load">重试</button></view><block wx:else><view class="overview"><view class="metric"><text>{{total}}</text><text>全部单品</text></view><view class="metric"><text>{{active}}</text><text>当前可穿</text></view><view class="metric"><text>{{recent}}</text><text>近 30 天更新</text></view><view class="metric"><text>{{idle}}</text><text>闲置单品</text></view></view><view class="card"><view class="title">购买使用率</view><view class="rate">{{usageRate}}%</view><view class="copy">已记录购买日期 {{purchased}} 件，其中 {{usedPurchased}} 件有穿着记录</view></view><view class="card"><view class="title">分类分布</view><view wx:if="{{!categories.length}}" class="copy">暂无衣物数据</view><view wx:for="{{categories}}" wx:key="label" class="category"><view><text>{{item.label}}</text><text>{{item.count}} 件</text></view><view class="bar"><view style="width:{{item.percent}}%"></view></view></view></view></block></view>
