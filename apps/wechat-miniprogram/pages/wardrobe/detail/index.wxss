.detail-page {
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 64rpx);
}

.thumb-strip {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.thumb {
  position: relative;
  width: 104rpx;
  height: 112rpx;
  overflow: hidden;
  border: 1rpx dashed rgba(29, 34, 40, 0.24);
  border-radius: var(--radius-thumb);
  background: rgba(255, 255, 252, 0.6);
}

.thumb.is-active {
  border: 3rpx solid var(--color-primary);
}

.thumb-fallback {
  height: 78rpx;
  background: var(--color-mist);
}

.thumb-image {
  width: 100%;
  height: 78rpx;
}

.thumb-label {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 5rpx 0;
  color: var(--color-surface);
  background: rgba(29, 34, 40, 0.54);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.add-thumb {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plus {
  color: var(--color-muted);
  font-size: 36rpx;
  line-height: 1;
}

.thumb-label.muted {
  position: static;
  margin-top: 8rpx;
  color: var(--color-muted);
  background: transparent;
}

.notice-card,
.info-card,
.status-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.86);
  box-shadow: var(--shadow-card);
}

.status-title {
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
}

.status-copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.6;
}

.action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 28rpx;
}

.action-button {
  box-sizing: border-box;
  height: 82rpx;
  margin: 0;
  border-radius: var(--radius-control);
  font-size: var(--font-body);
  font-weight: 800;
  line-height: 82rpx;
}

.action-button::after,
.sheet-button::after {
  border: 0;
}

.edit {
  color: var(--color-surface);
  background: var(--color-primary);
}

.ai {
  color: var(--color-surface);
  background: var(--color-ai);
}

.danger {
  border: 1rpx solid rgba(220, 38, 38, 0.35);
  color: var(--color-danger);
  background: rgba(255, 255, 252, 0.72);
}

.detail-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 30rpx;
  padding: 10rpx;
  border-radius: var(--radius-card-secondary);
  background: rgba(244, 245, 243, 0.78);
}
.ai-advice-card { box-sizing: border-box; margin-top: 28rpx; padding: 28rpx; border: 1rpx solid rgba(53,92,125,.16); border-radius: var(--radius-card-inner); background: linear-gradient(135deg, rgba(53,92,125,.10), rgba(255,255,252,.88)); box-shadow: var(--shadow-card); }.ai-advice-card__head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }.ai-advice-card__source { color:var(--color-primary); font-size:20rpx; font-weight:700; }.advice-button--secondary { color:var(--color-primary); background:rgba(53,92,125,.10); }

.detail-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 78rpx;
  min-height: var(--hit-target-min);
  border-radius: var(--radius-control);
  color: var(--color-muted);
  font-size: var(--font-body);
  font-weight: 800;
}

.detail-tab.is-active {
  color: var(--color-ink);
  background: rgba(255, 255, 252, 0.9);
  box-shadow: 0 12rpx 34rpx rgba(29, 34, 40, 0.08);
}

.notice-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-left: 6rpx solid var(--color-success);
  color: var(--color-ink);
  font-size: var(--font-body);
}

.check-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: var(--color-success);
  background: rgba(95, 112, 88, 0.12);
  font-weight: 800;
}

.card-title {
  margin-bottom: 22rpx;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
}

.info-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 10rpx 0;
  color: var(--color-ink);
  font-size: var(--font-body);
  line-height: 1.45;
}

.info-row > text:first-child {
  color: var(--color-muted);
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-self: start;
  gap: 10rpx;
  max-width: 100%;
  padding: 8rpx 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
  background: rgba(255, 255, 252, 0.72);
}

.chip-list,
.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  min-width: 0;
}

.dot {
  width: 24rpx;
  height: 24rpx;
  flex: 0 0 24rpx;
  border-radius: 50%;
}

.mini-tag {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-control);
  color: var(--color-primary);
  background: rgba(53, 92, 125, 0.08);
  font-size: var(--font-caption);
  font-weight: 700;
}

.empty-panel {
  min-height: 220rpx;
}

.dot-white {
  box-sizing: border-box;
  border: 1rpx solid rgba(29, 34, 40, 0.22);
  background: var(--color-surface);
}

.dot-black {
  background: var(--color-ink);
}

.section-copy {
  color: var(--color-ink);
  font-size: var(--font-body);
  line-height: 1.65;
}

.delete-actions {
  display: grid;
  gap: 18rpx;
}

.sheet-button {
  width: 100%;
  height: 92rpx;
  margin: 0;
  border-radius: var(--radius-control);
  font-size: var(--font-body);
  font-weight: 800;
  line-height: 92rpx;
}

.sheet-button--danger {
  color: var(--color-surface);
  background: var(--color-danger);
}

.sheet-button--secondary {
  color: var(--color-ink);
  background: rgba(244, 245, 243, 0.88);
}
.more-button { width: 96rpx; height: 96rpx; margin: 0; padding: 0; border-radius: var(--radius-control); color: var(--color-ink); background: rgba(255,255,252,.72); font-size: 28rpx; line-height: 88rpx; letter-spacing: 2rpx; }
.more-button::after { border: 0; }
.advice-button { width: 100%; margin-top: 18rpx; color: var(--color-primary); background: rgba(53,92,125,.10); font-weight: 800; }
.advice-button::after { border: 0; }
.wear-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  min-width: 196rpx;
  height: 88rpx;
  min-height: var(--hit-target-min);
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: var(--radius-control);
  background: rgba(255, 255, 252, 0.82);
  color: var(--color-ink);
  font-size: var(--font-caption);
  font-weight: 800;
  line-height: 1;
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
}
.wear-button.is-worn { color: var(--color-success); }
.wear-button::after { border: 0; }
