<view class="page-shell detail-page">
  <view wx:if="{{loading}}" class="status-card">正在读取单品...</view>
  <view wx:elif="{{error}}" class="status-card"><view class="status-title">读取失败</view><view class="status-copy">{{error}}</view></view>
  <item-detail-shell wx:elif="{{item}}" top-title="单品详情" title="{{item.name}}" meta="{{item.meta}}" eyebrow="{{item.wearSummary}}" image-url="{{item.imageUrl}}" hero-label="主图" hero-fallback="{{item.categoryLabel}}">
    <button slot="topRight" class="more-button" bindtap="openMenu" aria-label="更多操作">•••</button>
    <view slot="afterHero"><item-media-section image-url="{{item.imageUrl}}" inspiration-images="{{item.inspirationImages}}" bind:add="addInspiration" bind:preview="previewMedia" bind:remove="removeInspiration" /></view>
    <view slot="tabs" class="detail-tabs"><view class="detail-tab {{activeTab === 'info' ? 'is-active' : ''}}" data-tab="info" bindtap="switchTab">信息</view><view class="detail-tab {{activeTab === 'inspiration' ? 'is-active' : ''}}" data-tab="inspiration" bindtap="switchTab">灵感</view><view class="detail-tab {{activeTab === 'pairing' ? 'is-active' : ''}}" data-tab="pairing" bindtap="switchTab">搭配</view></view>
    <block wx:if="{{activeTab === 'info'}}"><view class="ai-advice-card"><view class="ai-advice-card__head"><view class="card-title">AI 单品建议</view><view wx:if="{{adviceSource}}" class="ai-advice-card__source">{{adviceSource}}</view></view><view class="section-copy">{{adviceLoading ? '正在生成建议...' : adviceSummary || '还没有针对这件单品的建议'}}</view><view wx:for="{{adviceTips}}" wx:key="*this" class="section-copy">· {{item}}</view><button wx:if="{{!adviceSummary && !adviceLoading}}" class="advice-button" bindtap="generateAdvice">生成 AI 建议</button><button wx:elif="{{adviceSummary && !adviceLoading}}" class="advice-button advice-button--secondary" bindtap="generateAdvice">更新 AI 建议</button></view><item-field-sections item="{{item}}" kind="garment" /></block>
    <block wx:elif="{{activeTab === 'inspiration'}}"><item-media-section image-url="" inspiration-images="{{item.inspirationImages}}" bind:add="addInspiration" bind:preview="previewMedia" bind:remove="removeInspiration" /></block>
    <view wx:else class="info-card empty-panel"><view class="card-title">搭配</view><view class="section-copy">暂无关联套装。可在套装页选择这件衣物创建搭配。</view></view>
  </item-detail-shell>
  <ui-sheet open="{{menuOpen}}" title="单品操作" bind:close="closeMenu"><view class="delete-actions"><button class="sheet-button" bindtap="editItem">编辑</button><button class="sheet-button" bindtap="moveItem">移动衣橱</button><button class="sheet-button sheet-button--danger" bindtap="openDeleteSheet">删除</button></view></ui-sheet>
  <ui-sheet open="{{deleteSheetOpen}}" title="删除这件衣物？" description="删除后将从服务器衣橱移除，相关引用同步更新。" bind:close="closeDeleteSheet"><view class="delete-actions"><button class="sheet-button sheet-button--danger" loading="{{deleting}}" bindtap="confirmDelete">确认删除</button><button class="sheet-button sheet-button--secondary" bindtap="closeDeleteSheet">取消</button></view></ui-sheet>
</view>
