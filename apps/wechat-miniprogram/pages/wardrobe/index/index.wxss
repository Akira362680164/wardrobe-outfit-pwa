.page-shell {
  padding: calc(env(safe-area-inset-top) + 152rpx) 32rpx calc(env(safe-area-inset-bottom) + 176rpx);
}

.wardrobe-top {
  display: block;
}

.filter-card,
.top-action {
  box-sizing: border-box;
  min-height: 112rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-control);
  background: rgba(255, 255, 252, 0.80);
  box-shadow: var(--shadow-card);
}

.filter-card {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 112rpx;
  padding: 0 22rpx;
}

.filter-main {
  min-width: 0;
  flex: 1;
}

.filter-title,
.filter-count {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-title {
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1.2;
}

.filter-count {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
  line-height: 1.2;
}

.top-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  color: var(--color-ink);
  font-size: var(--font-label);
  font-weight: 700;
  line-height: 1;
}

.top-action-primary {
  border-color: rgba(53, 92, 125, 0.18);
  background: var(--color-primary);
  color: var(--color-surface);
  box-shadow: 0 18rpx 44rpx rgba(53, 92, 125, 0.22);
}

.top-action::after,
.category-chip::after,
.mini-button::after { border: 0; }

.stats-line {
  margin-top: 24rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
  line-height: 1.35;
}

.wardrobe-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.category-scroll {
  width: 100%;
  margin: 22rpx 0 0;
  white-space: nowrap;
}

.category-row {
  display: flex;
  gap: 14rpx;
}

.category-chip {
  flex: 0 0 auto;
  box-sizing: border-box;
  min-height: 64rpx;
  max-width: 220rpx;
  margin: 0;
  padding: 0 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-control);
  background: rgba(255, 255, 252, 0.82);
  color: var(--color-muted);
  font-size: var(--font-caption);
  font-weight: 700;
  line-height: 62rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-chip.is-active {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-surface);
}

.status-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.78);
  box-shadow: var(--shadow-card);
  color: var(--color-muted);
  font-size: var(--font-body);
}

.status-title {
  margin-bottom: 12rpx;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 700;
}

.status-copy {
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.55;
}

.mini-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  max-width: 100%;
  height: 88rpx;
  margin: 28rpx 0 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: var(--radius-control);
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1;
}

.garment-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  margin-top: 28rpx;
}
