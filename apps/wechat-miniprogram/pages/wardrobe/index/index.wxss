.wardrobe-page {
  padding: calc(env(safe-area-inset-top) + 152rpx) 32rpx calc(env(safe-area-inset-bottom) + 176rpx);
}

.wardrobe-top {
  display: flex;
  justify-content: flex-start;
}

.filter-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  width: 304rpx;
  max-width: calc(100vw - 292rpx);
  min-height: 112rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-control);
  color: var(--color-ink);
}

.filter-main {
  min-width: 0;
  flex: 1;
}

.filter-title,
.filter-count {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-title {
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1.2;
}

.filter-count {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
  line-height: 1.2;
}

.stats-row {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 0;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

.stats-line {
  min-width: 0;
  overflow: hidden;
  color: var(--color-muted);
  font-size: var(--font-caption);
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-pill {
  position: relative;
  z-index: 72;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-sizing: border-box;
  max-width: 340rpx;
  height: 56rpx;
  min-height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: var(--radius-control);
  color: var(--color-ink);
  font-size: var(--font-label);
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.action-pill-divider {
  display: block;
  width: 1rpx;
  height: 24rpx;
  margin: 0 10rpx;
  background: var(--color-line);
}

.action-menu-backdrop {
  position: fixed;
  inset: 0;
  z-index: 69;
  background: transparent;
}

.action-menu {
  position: absolute;
  top: 68rpx;
  right: 0;
  z-index: 70;
  box-sizing: border-box;
  width: 300rpx;
  padding: 12rpx;
  border-radius: var(--radius-card-secondary);
}

.action-menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 84rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-control);
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 700;
}

.action-menu-item--ai {
  color: var(--color-ai);
}

.action-pill::after,
.category-chip::after,
.mini-button::after { border: 0; }

.category-scroll {
  width: 100%;
  margin: 22rpx 0 0;
  white-space: nowrap;
}

.category-row {
  display: flex;
  gap: 14rpx;
}

.category-chip {
  flex: 0 0 auto;
  box-sizing: border-box;
  min-height: 64rpx;
  max-width: 220rpx;
  margin: 0;
  padding: 0 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-control);
  background: rgba(255, 255, 252, 0.82);
  color: var(--color-muted);
  font-size: var(--font-caption);
  font-weight: 700;
  line-height: 62rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-chip.is-active {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-surface);
}

.status-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.78);
  box-shadow: var(--shadow-card);
  color: var(--color-muted);
  font-size: var(--font-body);
}

.status-title {
  margin-bottom: 12rpx;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 700;
}

.status-copy {
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.55;
}

.mini-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  max-width: 100%;
  height: 88rpx;
  margin: 28rpx 0 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: var(--radius-control);
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1;
}

.garment-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  margin-top: 28rpx;
}

.wardrobe-fab {
  right: 32rpx;
}
