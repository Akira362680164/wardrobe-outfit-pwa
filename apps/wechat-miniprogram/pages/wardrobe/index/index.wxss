.page-shell { padding: 48rpx 28rpx 160rpx; }

.status-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.78);
  box-shadow: var(--shadow-card);
  color: var(--color-muted);
  font-size: var(--font-body);
}

.status-title {
  margin-bottom: 12rpx;
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 700;
}

.status-copy {
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.55;
}

.mini-button {
  box-sizing: border-box;
  width: 220rpx;
  height: 88rpx;
  margin: 28rpx 0 0;
  border: 0;
  border-radius: var(--radius-pill);
  background: var(--color-ink);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 88rpx;
}

.garment-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 28rpx;
}

.garment-card {
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: 32rpx;
  background: rgba(255, 255, 252, 0.82);
  box-shadow: var(--shadow-card);
}

.garment-image,
.image-fallback {
  width: 100%;
  height: 250rpx;
}

.image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(53, 92, 125, 0.14), rgba(185, 113, 85, 0.12));
  color: var(--color-muted);
  font-size: var(--font-caption);
}

.garment-body { padding: 20rpx; }

.garment-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 700;
}

.garment-meta {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.garment-chip {
  display: inline-block;
  max-width: 100%;
  box-sizing: border-box;
  margin-top: 14rpx;
  padding: 8rpx 14rpx;
  overflow: hidden;
  border-radius: var(--radius-pill);
  background: rgba(53, 92, 125, 0.10);
  color: var(--color-primary);
  font-size: var(--font-label);
  text-overflow: ellipsis;
  white-space: nowrap;
}
