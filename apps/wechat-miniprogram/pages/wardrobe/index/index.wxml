<view class="page-shell wardrobe-page" style="{{fontStyle}}" bindtap="closeOverlays">
  <view class="wardrobe-top">
    <view class="filter-wrap" catchtap="noop">
    <view class="filter-card glass-panel" bindtap="toggleLocationMenu">
      <ui-icon name="wardrobe" size="42" tone="ink" />
      <view class="filter-main">
        <view class="filter-title">{{scopeLabel}}</view>
        <view class="filter-count">{{scopeCount}}件</view>
      </view>
      <ui-icon name="chevron-down" size="34" tone="ink" />
    </view>
    <view wx:if="{{locationMenuOpen}}" class="location-popover glass-panel-strong">
      <view wx:for="{{locationOptions}}" wx:key="id" data-id="{{item.id}}" class="location-option {{wardrobeScope === item.id ? 'is-active' : ''}}" bindtap="selectWardrobe">
        <view class="location-name">{{item.name}}</view>
        <view class="location-count">{{item.count}}件</view>
      </view>
    </view>
    </view>
  </view>

  <view class="stats-row">
    <view class="stats-line">{{statsText}}</view>
    <button class="action-pill glass-panel" aria-label="打开衣橱操作" catchtap="toggleActionMenu">
      <text>搜索</text><text class="action-pill-divider"></text><text>统计</text><text class="action-pill-divider"></text><text>AI衣橱诊断</text>
    </button>
    <view wx:if="{{actionMenuOpen}}" class="action-menu-backdrop" bindtap="closeActionMenu"></view>
    <view wx:if="{{actionMenuOpen}}" class="action-menu glass-panel-strong" catchtap="noop">
      <view class="action-menu-item" data-action="search" catchtap="handleActionMenuTap">
        <ui-icon name="search" size="40" tone="ink" />
        <text>搜索</text>
      </view>
      <view class="action-menu-item" data-action="stats" catchtap="handleActionMenuTap">
        <ui-icon name="bar-chart-3" size="40" tone="ink" />
        <text>统计</text>
      </view>
      <view class="action-menu-item action-menu-item--ai" data-action="ai" catchtap="handleActionMenuTap">
        <ui-icon name="wand-sparkles" size="40" tone="ink" />
        <text>AI衣橱诊断</text>
      </view>
    </view>
  </view>

  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view class="category-row">
      <view class="category-chip {{activeCategory === 'all' ? 'is-active' : ''}}" data-category="all" bindtap="handleCategoryTap">全部 {{totalCount}}</view>
      <view wx:for="{{categoryChips}}" wx:key="key" class="category-chip {{item.key === activeCategory ? 'is-active' : ''}}" data-category="{{item.key}}" bindtap="handleCategoryTap">{{item.label}} {{item.count}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{initialLoading}}" class="status-card">正在读取衣橱...</view>

  <view wx:if="{{diagnosisLoading || diagnosisSummary || diagnosisError}}" class="status-card">
    <view class="diagnosis-head"><view class="status-title" bindtap="toggleDiagnosis">AI 衣橱诊断 {{diagnosisExpanded ? '⌃' : '⌄'}}</view><button class="diagnosis-close" bindtap="closeDiagnosis">关闭</button></view>
    <block wx:if="{{diagnosisExpanded}}"><view class="status-copy">{{diagnosisLoading ? '正在生成诊断...' : diagnosisError || diagnosisSummary}}</view><view wx:for="{{diagnosisTips}}" wx:key="*this" class="status-copy">· {{item}}</view><button wx:if="{{diagnosisError}}" class="mini-button" bindtap="runDiagnosis">重试</button><button wx:elif="{{diagnosisSummary && !diagnosisLoading}}" class="mini-button" bindtap="runDiagnosis">重新生成</button></block>
  </view>

  <view wx:if="{{!initialLoading && error}}" class="status-card">
    <view class="status-title">读取失败</view>
    <view class="status-copy">{{error}}</view>
    <button class="mini-button" bindtap="loadGarments">重试</button>
  </view>

  <view wx:if="{{!initialLoading && !error && garments.length === 0}}" class="status-card">
    <view class="status-title">{{emptyTitle || '还没有衣物'}}</view>
    <view class="status-copy">添加第一件衣物后，这里会显示图片、名称、分类、颜色和穿着摘要。</view>
    <button class="mini-button" bindtap="handleEmptyAction">{{emptyAction || '添加衣物'}}</button>
  </view>

  <view wx:if="{{garments.length > 0}}" class="garment-grid">
    <catalog-card
      wx:for="{{visibleGarments}}"
      wx:key="id"
      item-id="{{item.id}}"
      image-url="{{item.imageUrl}}"
      fallback="{{item.categoryLabel}}"
      title="{{item.name}}"
      category-label="{{item.categoryLabel}}"
      colors="{{item.cardColors}}"
      summary="{{item.wearSummary}}"
      tone="primary"
      selected="{{selectedMap[item.id]}}"
      bind:select="openDetail"
      bind:longpress="enterSelection"
    />
  </view>

  <view wx:if="{{garments.length > 0 && visibleGarments.length === 0}}" class="status-card">
    <view class="status-title">这个分类还没有衣物</view>
    <view class="status-copy">切回全部衣橱，或添加一件当前分类的单品。</view>
    <button class="mini-button" bindtap="openIntake">添加衣物</button>
  </view>

  <button class="content-fab wardrobe-fab" aria-label="新建" catchtap="openCreateSheet">
    <ui-icon name="plus" size="48" tone="surface" />
  </button>
  <create-sheet open="{{createSheetOpen}}" active="add_single_item" bind:close="closeCreateSheet" />
  <view wx:if="{{selectionMode}}" class="selection-bar bottom-glass-bar"><button class="selection-cancel" bindtap="cancelSelection">取消</button><view class="selection-count">已选 {{selectedIds.length}} 件</view><button class="selection-delete" loading="{{deletingSelection}}" disabled="{{!selectedIds.length || deletingSelection}}" bindtap="confirmBatchDelete">删除</button></view>
  <ui-confirm-sheet visible="{{deleteConfirmOpen}}" title="删除选中的 {{selectedIds.length}} 件衣物？" content="服务器提交成功后才会从列表移除。" confirm-text="确认删除" danger="true" bind:close="closeDeleteConfirm" bind:confirm="confirmDeleteSelection" />
</view>
