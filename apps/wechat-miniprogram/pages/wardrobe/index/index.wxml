<view class="page-shell">
  <view class="wardrobe-top">
    <view class="filter-card">
      <view class="filter-main">
        <view class="filter-title">全部衣橱</view>
        <view class="filter-count">{{totalCount}}件</view>
      </view>
    </view>
  </view>

  <view class="stats-line">{{statsText}}</view>

  <view class="wardrobe-actions">
    <view class="top-action" bindtap="showSearchTip">搜索</view>
    <view class="top-action" bindtap="showStatsTip">统计</view>
    <view class="top-action top-action-primary" bindtap="openIntake">添加</view>
  </view>

  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view class="category-row">
      <button class="category-chip {{activeCategory === 'all' ? 'is-active' : ''}}" data-category="all" bindtap="handleCategoryTap">全部 {{totalCount}}</button>
      <button wx:for="{{categoryChips}}" wx:key="key" class="category-chip {{item.key === activeCategory ? 'is-active' : ''}}" data-category="{{item.key}}" bindtap="handleCategoryTap">{{item.label}} {{item.count}}</button>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="status-card">正在读取衣橱...</view>

  <view wx:elif="{{error}}" class="status-card">
    <view class="status-title">读取失败</view>
    <view class="status-copy">{{error}}</view>
    <button class="mini-button" bindtap="loadGarments">重试</button>
  </view>

  <view wx:elif="{{garments.length === 0}}" class="status-card">
    <view class="status-title">{{emptyTitle || '还没有衣物'}}</view>
    <view class="status-copy">添加第一件衣物后，这里会显示图片、名称、分类、颜色和季节。</view>
    <button class="mini-button" bindtap="handleEmptyAction">{{emptyAction || '添加衣物'}}</button>
  </view>

  <view wx:else class="garment-grid">
    <catalog-card
      wx:for="{{visibleGarments}}"
      wx:key="id"
      id="{{item.id}}"
      image-url="{{item.imageUrl}}"
      fallback="{{item.categoryLabel}}"
      title="{{item.name}}"
      meta="{{item.categoryLabel}} · {{item.colorText}}"
      submeta="{{item.seasonText}}"
      tone="primary"
      bind:select="openDetail"
    />
  </view>

  <view wx:if="{{garments.length > 0 && visibleGarments.length === 0}}" class="status-card">
    <view class="status-title">这个分类还没有衣物</view>
    <view class="status-copy">切回全部衣橱，或添加一件当前分类的单品。</view>
    <button class="mini-button" bindtap="openIntake">添加衣物</button>
  </view>
</view>
