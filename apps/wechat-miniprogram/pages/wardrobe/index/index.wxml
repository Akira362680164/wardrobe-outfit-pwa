<view class="page-shell">
  <view class="page-title">衣橱</view>
  <view class="page-copy">从服务器读取的真实单品列表。</view>

  <view wx:if="{{loading}}" class="status-card">正在读取衣橱...</view>

  <view wx:elif="{{error}}" class="status-card">
    <view class="status-title">读取失败</view>
    <view class="status-copy">{{error}}</view>
    <button class="mini-button" bindtap="loadGarments">重试</button>
  </view>

  <view wx:elif="{{garments.length === 0}}" class="status-card">
    <view class="status-title">{{emptyTitle || '还没有衣物'}}</view>
    <view class="status-copy">添加第一件衣物后，这里会显示图片、名称、分类、颜色和季节。</view>
    <button class="mini-button" bindtap="handleEmptyAction">{{emptyAction || '添加衣物'}}</button>
  </view>

  <view wx:else class="garment-grid">
    <view wx:for="{{garments}}" wx:key="id" class="garment-card">
      <image wx:if="{{item.imageUrl}}" class="garment-image" mode="aspectFill" src="{{item.imageUrl}}" />
      <view wx:else class="image-fallback">{{item.categoryLabel}}</view>
      <view class="garment-body">
        <view class="garment-name">{{item.name}}</view>
        <view class="garment-meta">{{item.categoryLabel}} · {{item.colorText}}</view>
        <view class="garment-chip">{{item.seasonText}}</view>
      </view>
    </view>
  </view>
</view>
