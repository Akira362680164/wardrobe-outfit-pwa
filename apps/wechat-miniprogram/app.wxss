@import "./styles/index.wxss";

.page-title {
  margin: 0 0 18rpx;
  font-size: var(--font-title);
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: 0;
}

.page-copy {
  margin: 0;
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.65;
}

.placeholder-card {
  box-sizing: border-box;
  margin-top: 36rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.72);
  box-shadow: var(--shadow-card);
}

.placeholder-label {
  color: var(--color-muted);
  font-size: var(--font-caption);
}
