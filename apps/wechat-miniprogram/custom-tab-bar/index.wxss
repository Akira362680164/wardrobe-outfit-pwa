@import "../styles/index.wxss";
.mini-tab-shell { position: fixed; right: 32rpx; bottom: 0; left: 32rpx; z-index: 30; padding-bottom: calc(env(safe-area-inset-bottom) + 18rpx); pointer-events: none; }
.mini-tab { --tab-radius: 52rpx; --tab-inset: 10rpx; position: relative; isolation: isolate; display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; padding: var(--tab-inset); overflow: hidden; box-sizing: border-box; pointer-events: auto; border: 0; border-radius: var(--tab-radius); background: rgba(255, 255, 252, 0.40); -webkit-backdrop-filter: blur(68rpx) saturate(1.5) brightness(1.05); backdrop-filter: blur(68rpx) saturate(1.5) brightness(1.05); box-shadow: 0 12rpx 16rpx rgba(29, 34, 40, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.64), inset 0 -1rpx 0 rgba(29, 34, 40, 0.10); }
.mini-tab::before { content: ""; position: absolute; inset: 0; z-index: 0; border-radius: inherit; background: linear-gradient(135deg, rgba(255, 255, 255, 0.46) 0%, rgba(255, 255, 255, 0.20) 26%, transparent 58%, rgba(29, 34, 40, 0.05) 100%); box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.42), inset 0 0 24rpx rgba(255, 255, 255, 0.12); pointer-events: none; }
.mini-tab__item { position: relative; z-index: 1; display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; height: 92rpx; padding: 0 4rpx; border: 0; border-radius: calc(var(--tab-radius) - var(--tab-inset)); color: rgba(29, 34, 40, 0.48); background: transparent; box-sizing: border-box; }
.mini-tab--motion-ready .mini-tab__item { transition: color 120ms ease, background-color 120ms ease, transform 120ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.mini-tab__item::after { border: 0; }
.mini-tab__item--active { color: #fffffc; background: #355c7d; }
.mini-tab__item--hover { transform: translateY(1rpx) scale(0.97); }
.mini-tab__icon-wrap { display: grid; place-items: center; width: 48rpx; height: 48rpx; }
.mini-tab__label { display: block; max-width: 100%; font-size: 20rpx; font-weight: 700; line-height: 1.1; }
.mini-tab__create { position: relative; z-index: 2; display: grid; flex: 0 0 88rpx; width: 88rpx; min-width: var(--hit-target-min); height: 88rpx; min-height: var(--hit-target-min); margin: -38rpx 8rpx 0; padding: 0; place-items: center; border: 0; border-radius: 50%; background: #355c7d; box-shadow: 0 12rpx 26rpx rgba(29,34,40,.24), inset 0 1rpx 0 rgba(255,255,255,.2); }
.mini-tab__create::after { border: 0; }.mini-tab__create--hover { transform: scale(.96); }
@media (prefers-reduced-motion: reduce) {
  .mini-tab--motion-ready .mini-tab__item { transition: none; }
  .mini-tab__item--hover { transform: none; }
  .mini-tab__create--hover { transform: none; }
}
