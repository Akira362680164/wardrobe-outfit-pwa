{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": []
  },
  "include": [
    "app.ts",
    "pages/**/*.ts",
    "services/**/*.ts",
    "stores/**/*.ts",
    "utils/**/*.ts",
    "typings/**/*.d.ts"
  ]
}
