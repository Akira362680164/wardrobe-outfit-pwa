@import "../../../styles/index.wxss";
.ui-empty { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; padding: 56rpx 32rpx; border: 1rpx dashed rgba(29, 34, 40, 0.14); border-radius: var(--radius-card); background: rgba(255, 255, 252, 0.58); box-sizing: border-box; text-align: center; }
.ui-empty__icon { display: grid; place-items: center; width: 104rpx; height: 104rpx; border-radius: var(--radius-pill); color: var(--color-primary); background: rgba(53, 92, 125, 0.10); }
.ui-empty__title { max-width: 100%; color: var(--color-ink); font-size: 32rpx; font-weight: 700; line-height: 1.3; }
.ui-empty__description { max-width: 520rpx; color: var(--color-muted); font-size: var(--font-caption); line-height: 1.45; }
.ui-empty__action { margin-top: 8rpx; }
