.confirm-sheet__backdrop { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: flex-end; justify-content: center; padding: 32rpx; box-sizing: border-box; background: rgba(29,34,40,.38); }
.confirm-sheet { width: 100%; max-width: 680rpx; padding: 34rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border: 1rpx solid rgba(29,34,40,.1); border-radius: 44rpx; background: rgba(255,255,252,.98); box-shadow: 0 -18rpx 80rpx rgba(29,34,40,.18); }
.confirm-sheet__title { color: var(--color-ink); font-size: var(--font-section); font-weight: 800; line-height: 1.3; }.confirm-sheet__content { margin-top: 14rpx; color: var(--color-muted); font-size: var(--font-caption); line-height: 1.55; }.confirm-sheet__actions { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 14rpx; margin-top: 28rpx; }.confirm-sheet__actions button { box-sizing: border-box; min-width: 0; height: 88rpx; margin: 0; border-radius: var(--radius-control); font-size: var(--font-body); font-weight: 800; white-space: nowrap; }.confirm-sheet__actions button::after { border: 0; }.confirm-sheet__cancel { color: var(--color-primary); background: rgba(53,92,125,.10); }.confirm-sheet__confirm { color: var(--color-surface); background: var(--color-primary); }.confirm-sheet__confirm--danger { background: var(--color-danger); }
