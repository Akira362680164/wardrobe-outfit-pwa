<button class="ui-icon-button ui-icon-button--{{variant}} ui-icon-button--{{size}}" disabled="{{disabled}}" hover-class="ui-icon-button--hover" aria-label="{{label}}" bindtap="onTap">
  <ui-icon name="{{icon}}" size="{{iconSize}}" tone="{{variant === 'primary' ? 'surface' : variant === 'danger' ? 'danger' : 'ink'}}" />
</button>
