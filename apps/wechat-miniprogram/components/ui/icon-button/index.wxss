@import "../../../styles/index.wxss";
.ui-icon-button { display: inline-flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; padding: 0; border: 0; border-radius: var(--radius-pill); color: var(--color-ink); background: rgba(255, 255, 252, 0.72); transition: opacity 120ms ease, transform 120ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.ui-icon-button::after { border: 0; }
.ui-icon-button--sm { width: 72rpx; height: 72rpx; }
.ui-icon-button--lg { width: 96rpx; height: 96rpx; }
.ui-icon-button--primary { color: #fff; background: var(--color-primary); }
.ui-icon-button--ghost { color: var(--color-ink); background: rgba(29, 34, 40, 0.05); }
.ui-icon-button--danger { color: var(--color-danger); background: rgba(220, 38, 38, 0.10); }
.ui-icon-button--hover { opacity: 0.86; transform: scale(0.96); }
.ui-icon-button[disabled] { color: rgba(29, 34, 40, 0.32); background: rgba(29, 34, 40, 0.08); }
