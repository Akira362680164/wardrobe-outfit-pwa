@import "../../../styles/index.wxss";
.ui-icon { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; overflow: hidden; color: currentColor; font-family: Arial, sans-serif; font-weight: 800; text-align: center; }
.ui-icon__mask { display: block; flex: 0 0 auto; background: currentColor; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: center; mask-position: center; -webkit-mask-size: contain; mask-size: contain; }
.ui-icon__glyph { display: block; width: 100%; height: 100%; color: currentColor; line-height: inherit; }
.ui-icon--spin { animation: ui-spin 900ms linear infinite; }
