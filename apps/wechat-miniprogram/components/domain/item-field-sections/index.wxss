.info-card{margin-top:20rpx;padding:26rpx;border-radius:24rpx;background:rgba(255,255,252,.82);box-shadow:var(--shadow-card)}.card-title{margin-bottom:16rpx;font-size:30rpx;font-weight:800}.info-row{display:flex;justify-content:space-between;gap:20rpx;padding:12rpx 0;color:var(--color-muted);font-size:26rpx}.info-row>text:last-child{text-align:right;color:var(--color-ink)}.chip-list,.tag-line{display:flex;flex-wrap:wrap;gap:8rpx}.chip,.mini-tag{padding:6rpx 12rpx;border-radius:999rpx;background:var(--color-mist);font-size:22rpx}.dot{display:inline-block;width:20rpx;height:20rpx;margin-right:6rpx;border:1rpx solid rgba(29,34,40,.18);border-radius:999rpx}.temperature-track{position:relative;height:12rpx;margin:8rpx 0 14rpx;border-radius:999rpx;background:linear-gradient(90deg,#7fb3d5,#8fcf9b,#f0c36a,#d9785f)}.temperature-range{position:absolute;top:-4rpx;bottom:-4rpx;border:4rpx solid var(--color-ink);border-radius:999rpx}.section-copy,.break-text{overflow-wrap:anywhere;color:var(--color-muted);font-size:25rpx;line-height:1.6}
