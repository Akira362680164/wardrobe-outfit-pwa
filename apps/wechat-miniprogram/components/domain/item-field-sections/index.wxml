<view wx:if="{{kind === 'wishlist'}}" class="info-card"><view class="card-title">购买信息</view><view class="info-row"><text class="info-label">价格</text><text class="info-value">{{item.priceText}}</text></view><view class="info-row"><text class="info-label">商品链接</text><text class="info-value break-text">{{item.productUrl || '未填写'}}</text></view></view>
<view class="info-card"><view class="card-title">基础信息</view><view class="info-row"><text class="info-label">分类</text><text class="info-value">{{item.categoryLabel}}{{item.subcategoryLabel ? ' / ' + item.subcategoryLabel : ''}}</text></view><view wx:if="{{kind === 'garment'}}" class="info-row"><text class="info-label">衣橱</text><text class="info-value">{{item.locationText}}</text></view><view class="info-row"><text class="info-label">状态</text><text class="info-value">{{item.statusText}}</text></view></view>
<view class="info-card"><view class="card-title">颜色</view><view class="info-row"><text class="info-label">颜色模式</text><text class="info-value">{{item.colorModeText}}</text></view><view class="info-row"><text class="info-label">主色</text><view class="chip-list"><view wx:for="{{item.primaryColorChips}}" wx:key="name" class="chip"><view class="dot" style="background:{{item.swatch}}"></view><text>{{item.name}}</text></view></view></view><view wx:if="{{item.colorMode === 'main_with_accent'}}" class="info-row"><text class="info-label">辅助色</text><view class="chip-list"><view wx:for="{{item.accentColorChips}}" wx:key="name" class="chip"><view class="dot" style="background:{{item.swatch}}"></view><text>{{item.name}}</text></view></view></view></view>
<view class="info-card"><view class="card-title">穿着属性</view><view class="tag-line"><text wx:for="{{item.seasonLabels}}" wx:key="*this" class="mini-tag">{{item}}</text></view><view class="tag-line"><text wx:for="{{item.styleLabels}}" wx:key="*this" class="mini-tag">{{item}}</text></view><view class="info-row"><text class="info-label">适穿温度</text><text class="info-value">{{item.temperatureText}}</text></view><view class="temperature-track"><view class="temperature-range" style="left:{{((item.temperatureRange.minC || -20) + 20) / 60 * 100}}%;right:{{100 - ((item.temperatureRange.maxC || 40) + 20) / 60 * 100}}%"></view></view><view class="info-row"><text class="info-label">正式度</text><text class="info-value">{{item.formalityText}}</text></view><view class="info-row"><text class="info-label">保暖度</text><text class="info-value">{{item.warmthText}}</text></view><view class="info-row"><text class="info-label">材质</text><text class="info-value">{{item.materialText}}</text></view><view class="info-row"><text class="info-label">版型倾向</text><text class="info-value">{{item.fitGenderText}}</text></view><view class="info-row info-row--long"><text class="info-label">版型说明</text><text class="info-value">{{item.fitNotes || '未记录'}}</text></view></view>
<view class="info-card"><view class="card-title">备注</view><view class="section-copy">{{item.notes}}</view></view>
