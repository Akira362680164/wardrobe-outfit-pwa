.media-strip{display:flex;gap:14rpx;padding:18rpx 2rpx;overflow-x:auto}.media-thumb{position:relative;flex:0 0 112rpx;width:112rpx;height:112rpx;overflow:hidden;border:2rpx solid rgba(29,34,40,.1);border-radius:18rpx;background:var(--color-mist)}.is-main{border-color:var(--color-primary)}.media-image{width:100%;height:100%}.media-label{position:absolute;right:6rpx;bottom:6rpx;left:6rpx;padding:5rpx;border-radius:10rpx;color:white;background:rgba(29,34,40,.64);font-size:19rpx;text-align:center}.media-add{display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--color-primary);border-style:dashed;background:rgba(53,92,125,.06)}.media-add .media-label{position:static;margin-top:8rpx;color:inherit;background:transparent}.media-remove{position:absolute;top:5rpx;right:5rpx;width:38rpx;height:38rpx;margin:0;padding:0;border-radius:999rpx;color:white;background:rgba(193,76,67,.9);font-size:28rpx;line-height:36rpx}.media-remove::after{border:0}
