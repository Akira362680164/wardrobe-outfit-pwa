.section{margin-top:20rpx;padding:26rpx;border-radius:24rpx;background:white;box-shadow:var(--shadow-card)}.title{font-size:30rpx;font-weight:800}.empty{padding:30rpx 0;color:var(--color-muted);font-size:24rpx;text-align:center}.row{display:flex;align-items:center;gap:18rpx;margin-top:18rpx;padding:16rpx;border:1rpx solid rgba(29,34,40,.08);border-radius:18rpx}.row image{width:84rpx;height:84rpx;border-radius:14rpx;background:var(--color-mist)}.body{min-width:0;flex:1}.body>view:first-child{display:flex;gap:8rpx}.name{min-width:0;overflow:hidden;font-size:26rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.badge{padding:4rpx 8rpx;border-radius:8rpx;color:var(--color-primary);background:rgba(53,92,125,.1);font-size:18rpx}.subtitle{margin-top:6rpx;overflow:hidden;color:var(--color-muted);font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.value{font-size:22rpx;font-weight:800}
