<view class="section"><view class="title">{{title}}</view><view wx:if="{{!rows.length}}" class="empty">{{empty}}</view><view wx:for="{{rows}}" wx:key="id" class="row"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view class="body"><view><text class="name">{{item.name}}</text><text class="badge">{{item.badge}}</text></view><view class="subtitle">{{item.subtitle}}</view></view><view class="value">{{item.value}}</view></view></view>
