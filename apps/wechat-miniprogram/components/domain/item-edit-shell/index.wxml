<view class="item-edit-shell">
  <sub-page-top-bar title="{{title}}" subtitle="{{subtitle}}" guarded-back="{{guardedBack}}" bind:back="onBack"><view slot="right"><slot name="topAction" /></view></sub-page-top-bar>

  <view class="item-edit-shell__media-card">
    <view class="item-edit-shell__media">
      <image wx:if="{{imageUrl}}" class="item-edit-shell__image" mode="aspectFit" src="{{imageUrl}}" />
      <view wx:else class="item-edit-shell__fallback">{{imageFallback}}</view>
    </view>
    <view class="item-edit-shell__media-side">
      <view class="item-edit-shell__media-title">{{imageLabel || '主图'}}</view>
      <slot name="mediaActions" />
    </view>
  </view>

  <slot />
  <slot name="bottom" />
</view>
