@import "../../../styles/index.wxss";

.item-edit-shell {
  display: block;
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 280rpx);
}

.item-edit-shell__media-card {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 250rpx minmax(0, 1fr);
  gap: 28rpx;
  align-items: center;
  padding: 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.86);
  box-shadow: var(--shadow-card);
}

.item-edit-shell__media {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 250rpx;
  height: 334rpx;
  overflow: hidden;
  border-radius: var(--radius-thumb);
  background: var(--color-mist);
}

.item-edit-shell__image {
  width: 100%;
  height: 100%;
}

.item-edit-shell__fallback {
  padding: 0 24rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
  text-align: center;
}

.item-edit-shell__media-title {
  color: var(--color-ink);
  font-size: var(--font-section);
  font-weight: 800;
}
