@import "../../../styles/index.wxss";

.catalog-card {
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.86);
  box-shadow: var(--shadow-card);
}

.catalog-card__media {
  box-sizing: border-box;
  padding: 24rpx 22rpx 0;
}

.catalog-card__media-frame {
  border-radius: var(--radius-thumb);
}

.catalog-card__image,
.catalog-card__fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-thumb);
  background: var(--color-mist);
}

.catalog-card__fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 16rpx;
  color: var(--color-muted);
  font-size: var(--font-label);
  text-align: center;
}

.catalog-card__body {
  padding: 20rpx 22rpx 22rpx;
}

.catalog-card__title,
.catalog-card__meta,
.catalog-card__submeta,
.catalog-card__badge {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-card__title {
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 700;
}

.catalog-card__meta {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
}

.catalog-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.catalog-card__submeta {
  min-width: 0;
  color: var(--color-muted);
  font-size: var(--font-label);
}

.catalog-card__badge {
  flex: 0 1 auto;
  max-width: 100%;
  padding: 8rpx 14rpx;
  border-radius: var(--radius-control);
  background: rgba(53, 92, 125, 0.10);
  color: var(--color-primary);
  font-size: var(--font-label);
  font-weight: 700;
  line-height: 1.2;
}

.catalog-card--shopping .catalog-card__badge {
  background: rgba(140, 74, 98, 0.10);
  color: var(--color-shopping);
}
