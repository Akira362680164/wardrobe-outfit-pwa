@import "../../../styles/index.wxss";

.catalog-card {
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card-inner);
  background: rgba(255, 255, 252, 0.86);
  box-shadow: var(--shadow-card);
}

.catalog-card__media {
  box-sizing: border-box;
  padding: 24rpx 22rpx 0;
}

.catalog-card__media-frame {
  border-radius: var(--radius-thumb);
}

.catalog-card__image,
.catalog-card__fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-thumb);
  background: var(--color-mist);
}

.catalog-card__fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 16rpx;
  color: var(--color-muted);
  font-size: var(--font-label);
  text-align: center;
}

.catalog-card__body {
  box-sizing: border-box;
  min-height: 142rpx;
  padding: 20rpx 22rpx 22rpx;
}

.catalog-card__title,
.catalog-card__meta,
.catalog-card__wardrobe-meta,
.catalog-card__category,
.catalog-card__color-names,
.catalog-card__summary,
.catalog-card__submeta,
.catalog-card__badge {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-card__title {
  color: var(--color-ink);
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1.28;
}

.catalog-card__meta {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
  line-height: 1.35;
}

.catalog-card__wardrobe-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
  line-height: 1.35;
}

.catalog-card__category {
  flex: 0 1 auto;
  max-width: 84rpx;
}

.catalog-card__swatch {
  box-sizing: border-box;
  width: 16rpx;
  height: 16rpx;
  flex: 0 0 16rpx;
  border-radius: 999rpx;
}

.catalog-card__swatch--border {
  border: 1rpx solid rgba(29, 34, 40, 0.22);
}

.catalog-card__color-names {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
  flex: 1 1 auto;
}

.catalog-card__color-token {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
  flex: 0 1 auto;
}

.catalog-card__color-name,
.catalog-card__more {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-card__more {
  flex: 0 0 auto;
}

.catalog-card__separator {
  flex: 0 0 auto;
  color: var(--color-muted);
}

.catalog-card__summary {
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: var(--font-label);
  line-height: 1.35;
}

.catalog-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.catalog-card__submeta {
  min-width: 0;
  color: var(--color-muted);
  font-size: var(--font-label);
}

.catalog-card__badge {
  flex: 0 1 auto;
  max-width: 100%;
  padding: 8rpx 14rpx;
  border-radius: var(--radius-control);
  background: rgba(53, 92, 125, 0.10);
  color: var(--color-primary);
  font-size: var(--font-label);
  font-weight: 700;
  line-height: 1.2;
}

.catalog-card--shopping .catalog-card__badge {
  background: rgba(140, 74, 98, 0.10);
  color: var(--color-shopping);
}
.catalog-card--selected { outline: 5rpx solid var(--color-primary); outline-offset: -5rpx; }
.catalog-card__selected { position: absolute; top: 12rpx; right: 12rpx; z-index: 4; display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;border-radius:999rpx;color:white;background:var(--color-primary);font-weight:900; }
