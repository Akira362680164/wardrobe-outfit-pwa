@import "../../../styles/index.wxss";

.outfit-plan-day-card {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  margin-top: 20rpx;
  padding: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(29, 34, 40, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 252, 0.88);
}

.day-card__head {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 10rpx;
}

.day-card__date,
.day-card__weekday {
  flex: 0 0 auto;
  color: var(--color-ink);
  white-space: nowrap;
}

.day-card__date {
  font-size: 30rpx;
  font-weight: 800;
}

.day-card__weekday {
  color: var(--color-muted);
  font-size: var(--font-caption);
}

.day-card__plans {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  gap: 8rpx;
  overflow: hidden;
}

.day-card__plan-chip {
  min-width: 0;
  max-width: 260rpx;
  overflow: hidden;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: var(--color-surface);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-card__plan-chip.tone-denim { color: #355c7d; background: rgba(53, 92, 125, 0.14); }
.day-card__plan-chip.tone-moss { color: #5f7058; background: rgba(95, 112, 88, 0.16); }
.day-card__plan-chip.tone-clay { color: #9a5e48; background: rgba(185, 113, 85, 0.16); }
.day-card__plan-chip.tone-amber { color: #8a6812; background: rgba(244, 190, 66, 0.24); }
.day-card__plan-chip.tone-rose { color: #a84e5c; background: rgba(244, 113, 130, 0.18); }
.day-card__plan-chip.tone-purple { color: #7651a1; background: rgba(188, 140, 236, 0.18); }
.day-card__plan-chip.tone-slate { color: #536277; background: rgba(148, 163, 184, 0.22); }

.day-card__primary {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 20rpx;
  margin-top: 22rpx;
}

.day-card__primary-media {
  display: block;
  width: 176rpx;
  height: 218rpx;
  flex: 0 0 176rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: var(--color-mist);
}

.day-card__cover {
  width: 100%;
  height: 100%;
}

.day-card__cover--empty,
.day-card__backup-cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(29, 34, 40, 0.32);
  font-size: var(--font-body);
  font-weight: 800;
}

.day-card__primary-main {
  min-width: 0;
  flex: 1 1 auto;
}

.day-card__primary-name,
.day-card__backup-name {
  min-width: 0;
  overflow: hidden;
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-card__primary-status {
  margin-top: 6rpx;
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 700;
}

.day-card__primary-status.is-worn { color: var(--color-success); }
.day-card__primary-status.is-changed { color: var(--color-clay); }

.day-card__primary-meta {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--color-muted);
  font-size: var(--font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-card__actions {
  display: flex;
  min-width: 0;
  gap: 8rpx;
  margin-top: 18rpx;
}

.day-card__actions--1,
.day-card__empty-actions--1 { grid-template-columns: minmax(0, 1fr); }
.day-card__actions--2,
.day-card__empty-actions--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.day-card__actions--3,
.day-card__empty-actions--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

.day-card__actions .day-card__action,
.day-card__empty-actions .day-card__action {
  flex: 1 1 0;
}

.day-card__action,
.day-card__empty-action,
.day-card__backup-delete {
  box-sizing: border-box;
  min-width: 0;
  height: 62rpx;
  margin: 0;
  padding: 0 8rpx;
  overflow: hidden;
  border: 1rpx solid rgba(29, 34, 40, 0.14);
  border-radius: 31rpx;
  color: var(--color-muted);
  background: rgba(255, 255, 252, 0.95);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 60rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-card__action::after,
.day-card__empty-action::after,
.day-card__backup-delete::after { border: 0; }

.day-card__action--primary {
  border-color: transparent;
  color: var(--color-surface);
  background: var(--color-primary);
}

.day-card__action--danger {
  border-color: rgba(185, 113, 85, 0.28);
  color: var(--color-clay);
}

.day-card__empty {
  padding: 24rpx 0 4rpx;
  text-align: center;
}

.day-card__empty--planned {
  padding-top: 14rpx;
  text-align: left;
}

.day-card__empty-meta {
  margin-bottom: 12rpx;
  overflow: hidden;
  color: rgba(29, 34, 40, 0.50);
  font-size: var(--font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-card__empty-title {
  color: var(--color-muted);
  font-size: var(--font-body);
  font-weight: 700;
}

.day-card__empty-copy {
  margin-top: 8rpx;
  color: rgba(29, 34, 40, 0.42);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.day-card__empty-action {
  border-color: transparent;
  color: var(--color-surface);
  background: var(--color-primary);
}

.day-card__empty-actions {
  display: flex;
  min-width: 0;
  gap: 16rpx;
  margin-top: 16rpx;
}

.day-card__empty:not(.day-card__empty--planned) .day-card__empty-actions {
  margin-top: 18rpx;
}

.day-card__empty:not(.day-card__empty--planned) .day-card__empty-action {
  width: 240rpx;
  flex: 0 0 240rpx;
  margin: 0 auto;
}

.day-card__empty-action.day-card__action--secondary {
  border-color: rgba(29, 34, 40, 0.14);
  color: var(--color-muted);
  background: rgba(255, 255, 252, 0.95);
}

.day-card__backups {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(29, 34, 40, 0.08);
}

.day-card__backups-title {
  margin-bottom: 10rpx;
  color: var(--color-muted);
  font-size: var(--font-caption);
  font-weight: 700;
}

.day-card__backup {
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr) 128rpx;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
  padding: 10rpx 0;
}

.day-card__backup-media,
.day-card__backup-cover {
  width: 72rpx;
  height: 72rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: var(--color-mist);
}

.day-card__backup-name {
  font-size: var(--font-caption);
}

.day-card__backup-delete {
  width: 128rpx;
  height: 54rpx;
  line-height: 52rpx;
  color: var(--color-clay);
}

.cover-collage {
  display: grid;
  overflow: hidden;
  background: rgba(244, 245, 243, 0.78);
}

.cover-collage--1 { grid-template-columns: 1fr; }
.cover-collage--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.cover-collage--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); }
.cover-collage--3 .cover-collage__cell:first-child { grid-column: 1 / 3; }
.cover-collage--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); }
.cover-collage__cell { overflow: hidden; border-right: 1rpx solid rgba(255, 255, 252, 0.72); border-bottom: 1rpx solid rgba(255, 255, 252, 0.72); }
.cover-collage__image { width: 100%; height: 100%; }

@media (max-width: 360px) {
  .outfit-plan-day-card { padding: 20rpx 18rpx; }
  .day-card__primary { gap: 14rpx; }
  .day-card__primary-media { width: 150rpx; height: 190rpx; flex-basis: 150rpx; }
  .day-card__action { padding: 0 4rpx; font-size: 19rpx; }
  .day-card__backup { grid-template-columns: 64rpx minmax(0, 1fr) 116rpx; gap: 8rpx; }
  .day-card__backup-media, .day-card__backup-cover { width: 64rpx; height: 64rpx; }
  .day-card__backup-delete { width: 116rpx; font-size: 19rpx; }
}
