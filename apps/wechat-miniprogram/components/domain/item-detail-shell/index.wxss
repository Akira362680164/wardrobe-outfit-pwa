@import "../../../styles/index.wxss";

.item-detail-shell {
  display: block;
}

.item-detail-shell__title,
.item-detail-shell__meta,
.item-detail-shell__eyebrow {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-detail-shell__top-title {
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
}

.item-detail-shell__hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 914.67rpx;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border-radius: var(--radius-card-inner);
  background: var(--color-mist);
}
.item-detail-shell__hero-action { position:absolute; right:24rpx; bottom:24rpx; z-index:3; display:flex; align-items:center; justify-content:center; }

.item-detail-shell__image {
  width: 100%;
  height: 100%;
}

.item-detail-shell__badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 1;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-control);
  color: var(--color-surface);
  background: rgba(29, 34, 40, 0.58);
  font-size: var(--font-label);
  font-weight: 700;
}

.item-detail-shell__fallback {
  color: var(--color-muted);
  font-size: var(--font-body);
}

.item-detail-shell__heading {
  margin-top: 26rpx;
}

.item-detail-shell__eyebrow {
  color: var(--color-ai);
  font-size: var(--font-caption);
  line-height: 1.4;
  white-space: nowrap;
}

.item-detail-shell__title {
  margin-top: 6rpx;
  color: var(--color-ink);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.18;
}

.item-detail-shell__meta {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.45;
}
