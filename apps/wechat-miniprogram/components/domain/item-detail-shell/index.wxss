@import "../../../styles/index.wxss";

.item-detail-shell {
  display: block;
}

.item-detail-shell__topbar {
  display: grid;
  grid-template-columns: 80rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 20rpx;
  margin: 0 -32rpx 28rpx;
  padding: calc(env(safe-area-inset-top) + 20rpx) 32rpx 20rpx;
  background: rgba(251, 251, 248, 0.75);
  -webkit-backdrop-filter: blur(60rpx) saturate(1.5);
  backdrop-filter: blur(60rpx) saturate(1.5);
}

.item-detail-shell__back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  color: var(--color-ink);
  background: rgba(255, 255, 252, 0.9);
  text-decoration: none;
}

.item-detail-shell__top-title,
.item-detail-shell__title,
.item-detail-shell__meta,
.item-detail-shell__eyebrow {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-detail-shell__top-title {
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
}

.item-detail-shell__hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border-radius: var(--radius-card-inner);
  background: var(--color-mist);
}

.item-detail-shell__image {
  width: 100%;
  height: 100%;
}

.item-detail-shell__badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 1;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-control);
  color: var(--color-surface);
  background: rgba(29, 34, 40, 0.58);
  font-size: var(--font-label);
  font-weight: 700;
}

.item-detail-shell__fallback {
  color: var(--color-muted);
  font-size: var(--font-body);
}

.item-detail-shell__heading {
  margin-top: 26rpx;
}

.item-detail-shell__eyebrow {
  color: var(--color-ai);
  font-size: var(--font-caption);
  line-height: 1.4;
  white-space: nowrap;
}

.item-detail-shell__title {
  margin-top: 6rpx;
  color: var(--color-ink);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.18;
}

.item-detail-shell__meta {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.45;
}
